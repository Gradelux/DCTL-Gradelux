// ============================================================================
//  CineCore  -  INLINE LUT PROOF OF CONCEPT
//  A modular grading and film-look engine for DaVinci Resolve
//  ---------------------------------------------------------------------------
//  Working space : DaVinci Wide Gamut / DaVinci Intermediate
//  Build stage   : PHASE 3 + LUT film look
//                  Phase 1  input safety, exposure, white balance, tint,
//                           contrast, pivot, highlight shoulder, shadow toe,
//                           shadow depth, black point, white point,
//                           saturation, output safety.
//                  Phase 2  film density, subtractive saturation, richness,
//                           color separation.
//                  Phase 3  hue density shaping, split toning, bleach bypass.
//                  Look     LUT-based film look selector with mix.
//
//  Later phases add hue densities, split toning, bleach bypass and the
//  parametric look engine. The pipeline is staged so those drop in without
//  restructuring.
//
//  ---------------------------------------------------------------------------
//  NO EXTERNAL FILES
//  ---------------------------------------------------------------------------
//  Both LUTs are embedded inline. Nothing outside this file is required, and no
//  missing or misplaced .cube can disable the grading engine.
//
//  This build carries the complete Phase 1-3 engine and every control, plus a
//  three-entry Film Look menu:
//     None               no look applied, a bit-exact pass-through
//     Reference Identity the architecture check - should look unchanged
//     Test Look          one real 33-point look, embedded verbatim
//
//  None is included because every control in CineCore is neutral at its
//  default, and Reference Identity is only NEARLY a no-op: it carries the
//  33-cubed interpolation error and clamps above diffuse white, like any LUT.
//  ---------------------------------------------------------------------------
// ============================================================================


// ============================================================================
//  SECTION 1 :: UI PARAMETERS AND LUT DECLARATIONS
//  Every control is neutral at its default: with the panel untouched this
//  DCTL returns its input unchanged, and the film look defaults to None.
// ============================================================================

// ---- Setup ----------------------------------------------------------------
DEFINE_UI_PARAMS(gInputEncoding, Input Encoding, DCTLUI_COMBO_BOX, 0, {CC_ENC_DI, CC_ENC_LIN}, {DaVinci Intermediate, DaVinci Linear})
DEFINE_UI_PARAMS(gBypass, Bypass, DCTLUI_CHECK_BOX, 0)

// ---- Primary grade --------------------------------------------------------
DEFINE_UI_PARAMS(gExposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0f, -5.0f, 5.0f, 0.01f)
DEFINE_UI_PARAMS(gTemperature, Temperature, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gTint, Tint, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gContrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0f, 0.25f, 2.5f, 0.001f)
DEFINE_UI_PARAMS(gPivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.336f, 0.15f, 0.6f, 0.001f)
DEFINE_UI_PARAMS(gSaturation, Saturation, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.001f)
DEFINE_UI_PARAMS(gBlackPoint, Black Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.05f, 0.05f, 0.0005f)
DEFINE_UI_PARAMS(gWhitePoint, White Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.15f, 0.15f, 0.0005f)

// ---- Film response --------------------------------------------------------
DEFINE_UI_PARAMS(gHighlightShoulder, Highlight Shoulder, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gHighlightRollOff, Highlight Roll Off, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gShadowToe, Shadow Toe, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gShadowDepth, Shadow Depth, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)

// ---- Film density and color -----------------------------------------------
DEFINE_UI_PARAMS(gFilmDensity, Film Density, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gDensityStrength, Density Strength, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gSubSaturation, Subtractive Saturation, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gRichness, Richness, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gColorSeparation, Color Separation, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)

// ---- Hue density ----------------------------------------------------------
//  Positive adds density to that hue family - deeper, heavier. Negative opens
//  it up. Bands overlap deliberately so hues blend rather than banding at the
//  boundaries; Red, Orange and Yellow are anchored closer together than the
//  rest because that is where discrimination matters most.
DEFINE_UI_PARAMS(gRedDensity, Red Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gOrangeDensity, Orange Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gYellowDensity, Yellow Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gGreenDensity, Green Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gCyanDensity, Cyan Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gBlueDensity, Blue Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gMagentaDensity, Magenta Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)

// ---- Split toning ---------------------------------------------------------
//  Positive moves each end in the direction its name states. Negative reverses
//  it, so highlights can be cooled and shadows warmed from the same controls.
DEFINE_UI_PARAMS(gWarmHighlights, Warm Highlights, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gCoolShadows, Cool Shadows, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gSplitBalance, Split Tone Balance, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)

// ---- Bleach bypass --------------------------------------------------------
DEFINE_UI_PARAMS(gBleachBypass, Bleach Bypass, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gBleachMix, Bleach Bypass Mix, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f, 0.001f)

// ---- Film look ------------------------------------------------------------
DEFINE_UI_PARAMS(gLook, Film Look, DCTLUI_COMBO_BOX, 0, {CC_LOOK_NONE, CC_LOOK_REFERENCE, CC_LOOK_TEST}, {None, Reference Identity, Test Look})
DEFINE_UI_PARAMS(gLookMix, Look Mix, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f, 0.001f)

//  The LUT data below is inline: this DCTL has NO external file dependency of
//  any kind and cannot be broken by a missing or misplaced .cube.
//
//  Two LUTs are embedded rather than one, deliberately. Whether MULTIPLE inline
//  LUTs can coexist in a single DCTL is the thing that decides whether all 19
//  can be embedded later, so the proof of concept has to test it.
//
//  Values are emitted verbatim from the source .cube files at 8 decimals -
//  same numbers, no resampling, no modification of the creative data.
//    Reference Identity   33^3, 35937 entries
//    Test Look (Koda)       33^3, 35937 entries
DEFINE_CUBE_LUT(CC_LUT_REFERENCE)
LUT_3D_SIZE 33
