// ============================================================================
//  CineCore
//  A modular grading and film-look engine for DaVinci Resolve
//  ---------------------------------------------------------------------------
//  Working space : DaVinci Wide Gamut / DaVinci Intermediate
//  Build stage   : PHASE 2
//                  Phase 1  input safety, exposure, white balance, tint,
//                           contrast, pivot, highlight shoulder, shadow toe,
//                           shadow depth, black point, white point,
//                           saturation, output safety.
//                  Phase 2  film density, subtractive saturation, richness,
//                           color separation.
//
//  Later phases add hue densities, split toning, bleach bypass and the
//  film-look engine. The pipeline is staged so those drop in without
//  restructuring.
//
//  PIPELINE DESIGN
//  ---------------------------------------------------------------------------
//  Scene-referred operations (exposure, white balance, tint) run in LINEAR
//  DaVinci Wide Gamut, because scaling light is only physically meaningful in
//  linear. Applying a gain to log code values bends the transfer curve instead
//  of changing exposure, and that is a large part of why naive log-domain
//  grades look brittle.
//
//  Tone shaping and all color character work runs in
//  DAVINCI INTERMEDIATE LOG, because log is close to perceptually uniform: a
//  straight slope through a pivot is exactly the classic film gamma, and the
//  shoulder and toe knees land where the eye expects them.
//
//  The transform therefore performs at most one linear <-> log round trip, and
//  skips it entirely when exposure and white balance are at their defaults, so
//  a neutral setting is an exact pass-through.
//
//  No output color-space transform is applied. Input and output are both in
//  the timeline encoding.
// ============================================================================


// ============================================================================
//  SECTION 1 :: UI PARAMETERS
//  Every control is neutral at its default: with the panel untouched this
//  DCTL returns its input unchanged.
// ============================================================================

// ---- Setup ----------------------------------------------------------------
DEFINE_UI_PARAMS(gInputEncoding, Input Encoding, DCTLUI_COMBO_BOX, 0, {CC_ENC_DI, CC_ENC_LIN}, {DaVinci Intermediate, DaVinci Linear})
DEFINE_UI_PARAMS(gBypass, Bypass, DCTLUI_CHECK_BOX, 0)

// ---- Primary grade --------------------------------------------------------
DEFINE_UI_PARAMS(gExposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0f, -5.0f, 5.0f, 0.01f)
DEFINE_UI_PARAMS(gTemperature, Temperature, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gTint, Tint, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gContrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0f, 0.25f, 2.5f, 0.001f)
DEFINE_UI_PARAMS(gPivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.336f, 0.15f, 0.6f, 0.001f)
DEFINE_UI_PARAMS(gSaturation, Saturation, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.001f)
DEFINE_UI_PARAMS(gBlackPoint, Black Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.05f, 0.05f, 0.0005f)
DEFINE_UI_PARAMS(gWhitePoint, White Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.15f, 0.15f, 0.0005f)

// ---- Film response --------------------------------------------------------
DEFINE_UI_PARAMS(gHighlightShoulder, Highlight Shoulder, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gHighlightRollOff, Highlight Roll Off, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gShadowToe, Shadow Toe, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gShadowDepth, Shadow Depth, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)

// ---- Film density and color -----------------------------------------------
DEFINE_UI_PARAMS(gFilmDensity, Film Density, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gDensityStrength, Density Strength, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gSubSaturation, Subtractive Saturation, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gRichness, Richness, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gColorSeparation, Color Separation, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)


// ============================================================================
//  SECTION 2 :: COLOR SCIENCE ASSUMPTIONS
//  ---------------------------------------------------------------------------
//  SINGLE POINT OF TRUTH. Every color-space assumption CineCore makes lives
//  in this section. Nothing outside it hard-codes a color-space number, so
//  the assumptions below can be revised without touching any algorithm.
// ============================================================================

// ---------------------------------------------------------------------------
//  2.1  DAVINCI INTERMEDIATE TRANSFER FUNCTION
// ---------------------------------------------------------------------------
//  CONFIRMED against Blackmagic Design's official DaVinci Wide Gamut /
//  DaVinci Intermediate documentation. DO NOT MODIFY THESE VALUES.
//
//  They are also self-checking: they place linear 0.18 at code
//  value 0.336043 and linear 100.0 at code value 1.0, which are the documented
//  landmarks of the encoding, and the two segments meet continuously at the
//  cut point.
//
//  Landmarks, code value <- linear:
//      0.000000 <- 0.00     black
//      0.336043 <- 0.18     mid grey
//      0.513837 <- 1.00     diffuse white
//      0.756599 <- 10.0     bright specular
//      1.000000 <- 100.0    top of the encoding
// ---------------------------------------------------------------------------
#define CC_DI_A             0.0075f
#define CC_DI_B             7.0f
#define CC_DI_C             0.07329248f
#define CC_DI_M             10.44426855f
#define CC_DI_LIN_CUT       0.00262409f
#define CC_DI_LOG_CUT       0.02740668f

#define CC_DI_MID           0.336043f   // code value of linear 0.18
#define CC_DI_WHITE         0.513837f   // code value of linear 1.00

// ---------------------------------------------------------------------------
//  2.2  LUMINANCE METHOD
//
//       ***********************************************************
//       **  THIS IS AN APPROXIMATION.                            **
//       **  These are NOT DaVinci Wide Gamut luminance           **
//       **  coefficients and must not be treated as though they  **
//       **  were a DWG specification. They are an explicitly      **
//       **  chosen stand-in, documented here, replaceable here.   **
//       ***********************************************************
// ---------------------------------------------------------------------------
//  Several operations need a scalar "how bright is this pixel" value, which
//  requires a weighting of R, G and B. The honest position on that weighting:
//
//   * Official luminance coefficients for DaVinci Wide Gamut are not present
//     in the documentation available to this project. None are asserted here.
//     No DWG-specific coefficient in this file is derived, fitted or guessed.
//
//   * CineCore instead borrows the ITU-R BT.709 luma coefficients purely as a
//     numeric weighting applied to the working RGB values. Borrowing them says
//     nothing about the working gamut and confers no Rec.709 property on it.
//
//  This is NOT a Rec.709 color transform, and no Rec.709 assumption exists
//  anywhere else in this file. No matrix is applied, no primaries are
//  converted, no gamma is imposed and no gamut is changed. The three numbers
//  are used only as weights for luminance-dependent maths, which is what
//  Resolve's own luminance mixer does by default irrespective of the working
//  space. These three defines are the ONLY place in CineCore where a
//  coefficient from another color space appears; every other stage is built
//  from the working RGB values alone.
//
//  Phase 2 deliberately added no further dependence on them: film density,
//  subtractive saturation, richness and color separation are all built from
//  channel maxima, minima and medians, and use no luminance weighting at all.
//
//  Why this weighting was chosen:
//   * All three weights are positive and sum to exactly 1. A neutral therefore
//     maps to itself exactly, and no color can carry negative luminance.
//     This matters: a wide-gamut space whose blue primary sits at a negative y
//     has a negative blue term in its true colorimetric luminance row, and any
//     luma-preserving operation built on such a row INVERTS for strongly
//     saturated blues. That is an image-quality defect, not a subtlety, and
//     avoiding it is worth more than colorimetric exactness here.
//   * It is a published standard, so the behaviour is reproducible and
//     documented rather than tuned by eye.
//
//  What it affects: nothing on neutrals, ever. It only sets how much saturated
//  color appears to darken under luma-preserving operations, and where the
//  shoulder and toe knees fall for strongly colored pixels. It is a character
//  choice, not a correctness one.
//
//  To change the weighting, edit only these three defines. An equal-weight
//  alternative (0.33333333f each) is gamut-agnostic and equally stable, at the
//  cost of a poorer perceptual match, and can be substituted directly.
// ---------------------------------------------------------------------------
#define CC_LUMA_R           0.2126f
#define CC_LUMA_G           0.7152f
#define CC_LUMA_B           0.0722f


// ============================================================================
//  SECTION 3 :: TUNING CONSTANTS
//  Behavioural constants for the algorithms below. These are look decisions,
//  not color-space facts, and are safe to taste-tune.
// ============================================================================

// --- numerical guards ---
#define CC_EPS              1.0e-6f     // denominator floor
#define CC_TINY             1.0e-9f     // absolute floor for log arguments
#define CC_SAFE_MAX         1.0e7f      // magnitude at which Inf is trapped
#define CC_EXP_LIMIT        60.0f       // exp() argument clamp; exp(60) is finite

// --- transcendental constants ---
#define CC_LOG2E            1.4426950408889634f   // 1 / ln(2)
#define CC_LN2              0.6931471805599453f   // ln(2)

// --- tone norm biasing ---
#define CC_HI_NORM_BIAS     0.75f       // highlight norm: blend luma -> max channel
#define CC_LO_NORM_BIAS     0.50f       // shadow norm:    blend luma -> min channel

// --- highlight shoulder shaping ---
#define CC_SHOULDER_KNEE_HI 0.78f       // knee at strength 0
#define CC_SHOULDER_KNEE_LO 0.42f       // knee at strength 1, just under white
#define CC_SHOULDER_RANGE_LO 0.55f      // roll off 0 : tight, fast shoulder
#define CC_SHOULDER_RANGE_HI 1.60f      // roll off 1 : long, gentle shoulder
#define CC_SHOULDER_PER_CH  0.25f       // per-channel share of the compression

// --- shadow toe shaping ---
#define CC_TOE_KNEE         0.35f       // top of the toe region, fixed
#define CC_TOE_SLOPE_MIN    0.25f       // slope at black at full strength
#define CC_TOE_PER_CH       0.25f       // per-channel share of the compression

// --- shadow depth ---
//  Bounded so the control is provably monotonic: the bump weight's steepest
//  slope is ~3.08 / pivot, so amount * 3.08 / 0.15 must stay below 1.
#define CC_DEPTH_AMOUNT     0.045f      // max log density added in the shadows

// --- white balance ---
#define CC_WB_TEMP_GAIN     0.45f       // stops of R/B split at temperature 1.0
#define CC_WB_TINT_GAIN     0.35f       // stops of G/magenta split at tint 1.0

// --- saturation ---
#define CC_SAT_PROTECT      2.2f        // chroma-dependent brake on boosts

// --- chroma weighting, shared by film density and color separation ---
//  Chroma is measured as the spread between the largest and smallest channel
//  in log, which is exactly zero for a neutral and needs no luminance
//  weighting, no square root and no arc tangent to compute.
#define CC_CHROMA_NORM      0.40f       // log spread treated as fully saturated
#define CC_CHROMA_FLOOR     0.002f      // below this a pixel is treated as neutral

// --- film density ---
#define CC_DENSITY_AMOUNT   0.055f      // max log density at full chroma, ~0.75 stop
#define CC_DENSITY_EXP_LO   3.0f        // strength 0 : only the purest colors gain
#define CC_DENSITY_EXP_HI   1.2f        // strength 1 : reaches down into mid chroma

// --- subtractive saturation ---
#define CC_SUBSAT_GAIN      0.60f       // max expansion of the channel gaps
#define CC_SUBSAT_LIMIT     0.90f       // gap ceiling the expansion approaches

// --- richness ---
#define CC_RICH_GAIN        0.35f       // max expansion about the median channel
#define CC_RICH_LO          0.12f       // bottom of the midtone window
#define CC_RICH_HI          0.70f       // top of the midtone window
#define CC_RICH_PROTECT     1.50f       // chroma brake on the expansion

// --- color separation ---
#define CC_SEP_MAX          0.60f       // max blend towards the hue contrast curve
#define CC_SEP_EXP          2.0f        // chroma selectivity of the effect

// --- output safety net ---
//  A VALIDITY net, not a range limiter. The knees sit far outside anything a
//  real image can reach: code value 1.0 is already linear 100, so a knee at
//  2.0 is astronomically beyond any legal signal, and the floor knee at -1.0
//  is far below any wide-gamut negative. Ordinary imagery, out-of-gamut
//  negatives included, passes through completely untouched; only genuinely
//  runaway arithmetic is caught and bounded smoothly.
#define CC_OUT_CEIL_KNEE    2.00f
#define CC_OUT_CEIL_RANGE   1.00f       // asymptote 3.0
#define CC_OUT_FLOOR_KNEE  -1.00f
#define CC_OUT_FLOOR_RANGE  0.50f       // asymptote -1.5


// ============================================================================
//  SECTION 4 :: MATH HELPERS
//  Every helper here is total: it returns a finite value for every input,
//  including NaN, +/-Inf and denormals, without clamping ordinary signal.
// ============================================================================

// Traps NaN and Inf. A NaN fails every ordered comparison, so it falls through
// to the final return; +/-Inf fails the range test but passes the sign test.
// This is a validity guard, not a color clamp: CC_SAFE_MAX is far outside any
// meaningful code value, so real signal, negatives included, is untouched.
__DEVICE__ float cc_safe(float x)
{
    if (x >= -CC_SAFE_MAX && x <= CC_SAFE_MAX) return x;
    if (x > 0.0f) return CC_SAFE_MAX;
    if (x < 0.0f) return -CC_SAFE_MAX;
    return 0.0f;
}

__DEVICE__ float3 cc_safe3(float3 v)
{
    return make_float3(cc_safe(v.x), cc_safe(v.y), cc_safe(v.z));
}

__DEVICE__ float cc_lerp(float a, float b, float t)
{
    return a + (b - a) * t;
}

__DEVICE__ float3 cc_lerp3(float3 a, float3 b, float t)
{
    return make_float3(cc_lerp(a.x, b.x, t), cc_lerp(a.y, b.y, t), cc_lerp(a.z, b.z, t));
}

// Division that cannot produce Inf or NaN. The denominator is pushed away from
// zero while keeping its sign, so the result stays continuous through zero.
__DEVICE__ float cc_div(float a, float b)
{
    float d = b;
    if (_fabs(b) < CC_EPS) d = (b < 0.0f) ? -CC_EPS : CC_EPS;
    return a / d;
}

// exp() with a clamped argument. exp(+/-60) is comfortably inside float range,
// so overflow to Inf is impossible.
__DEVICE__ float cc_exp(float x)
{
    return _expf(_clampf(x, -CC_EXP_LIMIT, CC_EXP_LIMIT));
}

__DEVICE__ float cc_exp2(float x)
{
    return cc_exp(x * CC_LN2);
}

// log() is undefined at and below zero, so the argument is floored first.
__DEVICE__ float cc_log(float x)
{
    return _logf(_fmaxf(x, CC_TINY));
}

__DEVICE__ float cc_log2(float x)
{
    return cc_log(x) * CC_LOG2E;
}

__DEVICE__ float cc_sqrt(float x)
{
    return _sqrtf(_fmaxf(x, 0.0f));
}

// pow() is undefined for a negative base and a fractional exponent. Every use
// in CineCore raises an already-normalized 0..1 weight to a positive exponent,
// so flooring the base at zero makes the call total: 0^e is exactly 0 for the
// positive exponents used here, and no branch is needed.
__DEVICE__ float cc_pow_pos(float base, float e)
{
    return _powf(_fmaxf(base, 0.0f), e);
}

// Median of three, branch-light. Used as the anchor for richness and to locate
// the hue position for color separation.
__DEVICE__ float cc_median3(float a, float b, float c)
{
    return _fmaxf(_fminf(a, b), _fminf(_fmaxf(a, b), c));
}

// Exponential soft clip, used for both the highlight shoulder and the shadow
// toe. Chosen over a polynomial knee or a Reinhard curve because it has three
// properties at once: slope is exactly 1 at the knee (so the curve is C1
// continuous and no seam is visible where it engages), it is monotonic
// everywhere (so tonal order is never inverted), and it is asymptotic rather
// than clamped (so values approach the limit without ever stacking on it).
// Nothing can divide by zero: range is floored.
__DEVICE__ float cc_soft_ceil(float x, float knee, float range)
{
    if (x <= knee) return x;
    float r = _fmaxf(range, CC_EPS);
    return knee + r * (1.0f - cc_exp(-(x - knee) / r));
}

// Mirror of the above, asymptotic to knee - range.
__DEVICE__ float cc_soft_floor(float x, float knee, float range)
{
    if (x >= knee) return x;
    float r = _fmaxf(range, CC_EPS);
    return knee - r * (1.0f - cc_exp(-(knee - x) / r));
}


// ============================================================================
//  SECTION 5 :: COLOR SPACE HELPERS
//  The only code that reads Section 2.
// ============================================================================

// DaVinci Intermediate, log -> linear. The log branch is only reached where
// its argument is provably positive. The linear segment carries negative code
// values through symmetrically rather than clipping them, so scene-referred
// negatives survive the round trip intact.
__DEVICE__ float cc_di_to_lin(float x)
{
    if (x <= CC_DI_LOG_CUT) return x / CC_DI_M;
    return cc_exp2(x / CC_DI_C - CC_DI_B) - CC_DI_A;
}

// DaVinci Intermediate, linear -> log. Exact analytic inverse of the above.
__DEVICE__ float cc_lin_to_di(float x)
{
    if (x <= CC_DI_LIN_CUT) return x * CC_DI_M;
    return CC_DI_C * (cc_log2(x + CC_DI_A) + CC_DI_B);
}

__DEVICE__ float3 cc_di_to_lin3(float3 v)
{
    return make_float3(cc_di_to_lin(v.x), cc_di_to_lin(v.y), cc_di_to_lin(v.z));
}

__DEVICE__ float3 cc_lin_to_di3(float3 v)
{
    return make_float3(cc_lin_to_di(v.x), cc_lin_to_di(v.y), cc_lin_to_di(v.z));
}

// Scalar brightness. See Section 2.2 for the weighting and its rationale.
__DEVICE__ float cc_luma(float3 v)
{
    return v.x * CC_LUMA_R + v.y * CC_LUMA_G + v.z * CC_LUMA_B;
}

__DEVICE__ float cc_maxc(float3 v)
{
    return _fmaxf(v.x, _fmaxf(v.y, v.z));
}

__DEVICE__ float cc_minc(float3 v)
{
    return _fminf(v.x, _fminf(v.y, v.z));
}

// Chroma measured as the log spread between the largest and smallest channel.
// Exactly zero for a neutral, always non-negative, and needs no luminance
// weighting, no square root and no arc tangent. Every Phase 2 stage keys off
// this rather than off a hue angle, which is what keeps near-neutral pixels
// stable: there is no angle to become ill-conditioned as chroma approaches 0.
__DEVICE__ float cc_chroma(float3 v)
{
    return cc_maxc(v) - cc_minc(v);
}

// Selectivity curve shared by film density and color separation. Normalized
// chroma raised to an exponent above 1, so the response is flat at zero: an
// almost-neutral pixel receives almost none of the effect, and the effect eases
// in rather than switching on. This is the mechanism that keeps skin stable
// without any hue detection: skin's log spread is roughly a quarter of a
// saturated primary's, and squaring that ratio leaves it at a few percent of
// the full effect.
__DEVICE__ float cc_chroma_weight(float chroma, float exponent)
{
    return cc_pow_pos(_saturatef(chroma / CC_CHROMA_NORM), exponent);
}

// Tone norm driving the highlight shoulder. Biasing towards the max channel
// means a saturated highlight starts to roll off when its brightest primary
// gets hot, rather than waiting for its luminance to get hot, which is what
// stops single-channel blowouts from sneaking past the shoulder.
__DEVICE__ float cc_norm_hi(float3 v)
{
    return cc_lerp(cc_luma(v), cc_maxc(v), CC_HI_NORM_BIAS);
}

// Tone norm driving the shadow toe, biased towards the min channel by half.
// A pure min-channel norm is noisy in the deep shadows; half-weighting against
// luma keeps it stable while still reacting to the darkest primary.
__DEVICE__ float cc_norm_lo(float3 v)
{
    return cc_lerp(cc_luma(v), cc_minc(v), CC_LO_NORM_BIAS);
}


// ============================================================================
//  SECTION 6 :: TONE FUNCTIONS
// ============================================================================

// --- Exposure ---------------------------------------------------------------
// PURPOSE: behave exactly like a lens stop. A pure scale in linear light
// changes brightness while leaving every ratio in the image untouched, so hue
// and saturation are mathematically unaffected. Operates in linear.
__DEVICE__ float3 cc_exposure(float3 lin, float stops)
{
    if (stops == 0.0f) return lin;
    float g = cc_exp2(stops);
    return make_float3(lin.x * g, lin.y * g, lin.z * g);
}

// --- White balance and tint -------------------------------------------------
// PURPOSE: shift the image warm/cool and green/magenta without changing how
// bright it is.
//
// APPROXIMATION: this is a channel-gain model, not a chromatic adaptation
// transform. A true CAT would convert to a cone-response space, adapt the
// white point and convert back, which needs a documented DWG matrix that this
// project does not have. The gain model is the standard, well-behaved
// approximation and is labelled as such.
//
// The gains are built as powers of two so the control is symmetric in stops:
// +t warms by exactly the amount -t cools. The gain triplet is then divided by
// its own luminance, which does two things: it guarantees a neutral keeps its
// exposure no matter how far the sliders travel, so this control cannot
// accidentally act as a brightness control; and because every gain is an
// exponential it is strictly positive, so no channel can be driven through
// zero or made to change sign.
//
//   Temperature : + warmer  (red up, blue down)
//   Tint        : + magenta, - green   (matches the Resolve / ACR convention)
__DEVICE__ float3 cc_white_balance(float3 lin, float temp, float tint)
{
    if (temp == 0.0f && tint == 0.0f) return lin;

    float t = _clampf(temp, -1.0f, 1.0f);
    float m = _clampf(tint, -1.0f, 1.0f);

    float gr = cc_exp2( CC_WB_TEMP_GAIN * t + CC_WB_TINT_GAIN * m * 0.5f);
    float gg = cc_exp2(-CC_WB_TINT_GAIN * m);
    float gb = cc_exp2(-CC_WB_TEMP_GAIN * t + CC_WB_TINT_GAIN * m * 0.5f);

    // Denominator is a positive weighted sum of positive gains, so it is
    // bounded well away from zero for every legal slider position.
    float n = gr * CC_LUMA_R + gg * CC_LUMA_G + gb * CC_LUMA_B;
    float inv = cc_div(1.0f, n);

    return make_float3(lin.x * gr * inv, lin.y * gg * inv, lin.z * gb * inv);
}

// --- Contrast about a pivot -------------------------------------------------
// PURPOSE: the primary tonal control. A straight slope through a pivot in log
// is the classic film gamma, and it is applied per channel, which is what
// makes color contrast rise together with tonal contrast the way a print
// stock behaves rather than looking flat and video-like.
//
// LIMITATION: a straight slope is unbounded, so high contrast pushes extreme
// values a long way out. That is intentional and correct here, because the
// shoulder, toe and output safety net downstream are what bound the result.
// Bounding it inside this function would double-compress the image.
__DEVICE__ float3 cc_contrast(float3 v, float contrast, float pivot)
{
    if (contrast == 1.0f) return v;
    float c = _fmaxf(contrast, 0.01f);          // slope stays positive
    float p = _clampf(pivot, 0.05f, 0.95f);
    return make_float3((v.x - p) * c + p,
                       (v.y - p) * c + p,
                       (v.z - p) * c + p);
}

// --- Highlight shoulder -----------------------------------------------------
// PURPOSE: gradually compress bright values into a soft roll-off instead of
// letting them run into a hard clip, and keep the color of a highlight
// recognisable while it happens.
//
// Strength lowers the knee, so more of the highlight range is affected.
// Roll-off lengthens the asymptotic run above the knee, so the compression
// gets gentler and reaches further. Both are clamped so the knee can never
// meet or pass the ceiling, and the whole curve is blended in by strength so
// the control has no discontinuity as it leaves zero.
__DEVICE__ float cc_shoulder_curve(float x, float strength, float rolloff)
{
    float s = _saturatef(strength);
    float r = _saturatef(rolloff);
    float knee  = cc_lerp(CC_SHOULDER_KNEE_HI, CC_SHOULDER_KNEE_LO, s);
    float range = _fmaxf((1.0f - knee) * cc_lerp(CC_SHOULDER_RANGE_LO, CC_SHOULDER_RANGE_HI, r), CC_EPS);
    return cc_lerp(x, cc_soft_ceil(x, knee, range), s);
}

// Two ways to compress a highlight exist, and each is wrong on its own:
//
//   * A uniform offset in log is an exact exposure pull on that one pixel, so
//     it preserves its chromaticity perfectly. Used alone, a compressed
//     highlight keeps full saturation and looks artificial.
//   * A per-channel compression desaturates the top end the way an emulsion
//     does as its brightest layer saturates. Used alone it shifts hue, because
//     the channels compress by different amounts.
//
// CineCore mixes them, weighted heavily towards the hue-preserving path, which
// keeps highlight color intact while retaining a little of the natural
// bleach towards white. The mix ratio is a single constant so the film-look
// engine can drive it per look in a later phase.
//
// LIMITATION: the per-channel share does introduce a small hue shift by
// construction. That is the intended film behaviour, and at 25% it stays well
// short of the hue skew a pure per-channel curve produces.
__DEVICE__ float3 cc_highlight_shoulder(float3 v, float strength, float rolloff)
{
    if (strength <= 0.0f) return v;

    float n  = cc_norm_hi(v);
    float d  = cc_shoulder_curve(n, strength, rolloff) - n;

    float3 hueSafe = make_float3(v.x + d, v.y + d, v.z + d);
    float3 perCh   = make_float3(cc_shoulder_curve(v.x, strength, rolloff),
                                 cc_shoulder_curve(v.y, strength, rolloff),
                                 cc_shoulder_curve(v.z, strength, rolloff));

    return cc_lerp3(hueSafe, perCh, CC_SHOULDER_PER_CH);
}

// --- Shadow toe -------------------------------------------------------------
// PURPOSE: let shadows gently compress and deepen the way a film toe does,
// reducing contrast as they approach black, WITHOUT crushing them and without
// lifting black off zero.
//
// METHOD: a cubic reshaping of the toe region, normalized to the knee. The
// cubic is fully determined by four conditions, which is why it was chosen
// over an exponential or a gamma:
//     f(0) = 0        black stays exactly black, no milky lift
//     f'(0) = s0      shadow slope at black, set by the strength control
//     f(1) = 1        the knee is pinned, so mids are untouched
//     f'(1) = 1       slope matches at the knee, so there is no visible seam
// Solving gives  f(t) = (s0-1)t^3 + 2(1-s0)t^2 + s0*t.
//
// A gamma cannot satisfy f'(1) = 1 without collapsing to the identity, and the
// exponential soft-clip used for the shoulder is the wrong shape here: mirrored
// downwards it compresses shadows UP towards the knee, which lifts black into a
// print-style milky toe rather than deepening it.
//
// Reducing the slope at black rather than clamping is what separates
// compression from crushing: near-black detail is squeezed together but every
// distinct input still maps to a distinct output, and f' is strictly positive
// across the whole toe region so tonal order can never invert.
//
// Below zero the cubic would turn non-monotonic, so negatives take the linear
// extension y = s0 * x instead. That is C1 continuous with the cubic at zero
// and keeps scene-referred negatives negative rather than folding them.
//
// The knee is a fixed constant with no zero crossing, so the normalisation
// divide is safe by construction.
__DEVICE__ float cc_toe_curve(float x, float strength)
{
    if (x >= CC_TOE_KNEE) return x;

    float s0 = cc_lerp(1.0f, CC_TOE_SLOPE_MIN, _saturatef(strength));
    float t  = x / CC_TOE_KNEE;

    if (t <= 0.0f) return CC_TOE_KNEE * (s0 * t);

    float f = ((s0 - 1.0f) * t + 2.0f * (1.0f - s0)) * t * t + s0 * t;
    return CC_TOE_KNEE * f;
}

__DEVICE__ float3 cc_shadow_toe(float3 v, float strength)
{
    if (strength <= 0.0f) return v;

    float n = cc_norm_lo(v);
    float d = cc_toe_curve(n, strength) - n;

    float3 hueSafe = make_float3(v.x + d, v.y + d, v.z + d);
    float3 perCh   = make_float3(cc_toe_curve(v.x, strength),
                                 cc_toe_curve(v.y, strength),
                                 cc_toe_curve(v.z, strength));

    return cc_lerp3(hueSafe, perCh, CC_TOE_PER_CH);
}

// --- Shadow depth -----------------------------------------------------------
// PURPOSE: add weight to the low end the way extra printing density sits under
// an image. Deliberately separate from the toe: the toe changes the SHAPE of
// the shadow response, this changes its LEVEL.
//
// METHOD: a smooth bump weight, w = 16 * u^2 * (1-u)^2 with u = norm / pivot,
// scaling a small negative log offset. The bump is zero AND flat at both ends,
// which gives the control two properties that matter:
//   * it reaches zero at the pivot, so mids and highlights are untouched;
//   * it reaches zero at black, so the control adds density to the shadows
//     without pushing black itself below zero. A weight that peaked at black
//     would drive legal blacks negative, which is not depth, it is clipping.
// The offset is uniform across channels, so this is an exposure pull applied
// only to the shadow region: it darkens without shifting hue.
//
// STABILITY: the bump's steepest slope is ~3.08 / pivot, so the largest slope
// this can subtract is CC_DEPTH_AMOUNT * 3.08 / 0.15 = 0.92 at the smallest
// legal pivot. That is strictly below 1, so the curve cannot fold back on
// itself and shadow ordering is preserved at every setting.
__DEVICE__ float3 cc_shadow_depth(float3 v, float depth, float pivot)
{
    if (depth <= 0.0f) return v;

    float p = _clampf(pivot, 0.15f, 0.6f);
    float u = _saturatef(cc_div(cc_norm_lo(v), p));
    float b = u * (1.0f - u);
    float w = 16.0f * b * b;

    float o = -_saturatef(depth) * CC_DEPTH_AMOUNT * w;

    return make_float3(v.x + o, v.y + o, v.z + o);
}

// --- Black point and white point --------------------------------------------
// PURPOSE: set where the image sits between black and white, independently.
//
// Two affine moves in log with constant, non-zero denominators, so neither can
// divide by zero for any slider position:
//   black point : maps code value 0 to bp, with diffuse white pinned
//   white point : maps diffuse white to white + wp, with black pinned
//
// Anchoring each control at the opposite end is what makes them independent:
// setting a black level does not drag the highlights, and lifting white does
// not lift black. Both act identically on all three channels, so a neutral
// stays neutral.
__DEVICE__ float3 cc_black_white_point(float3 v, float bp, float wp)
{
    if (bp == 0.0f && wp == 0.0f) return v;

    float b = _clampf(bp, -0.05f, 0.05f);
    float w = _clampf(wp, -0.15f, 0.15f);

    float bSlope = (CC_DI_WHITE - b) / CC_DI_WHITE;      // 0.903 .. 1.097
    float wSlope = (CC_DI_WHITE + w) / CC_DI_WHITE;      // 0.708 .. 1.292

    return make_float3((v.x * bSlope + b) * wSlope,
                       (v.y * bSlope + b) * wSlope,
                       (v.z * bSlope + b) * wSlope);
}


// ============================================================================
//  SECTION 7 :: DENSITY FUNCTIONS
// ============================================================================

// --- Film density -----------------------------------------------------------
// INTENDED BEHAVIOR: strong colors become deeper and richer, the way a dense
// patch of dye in a print does. Explicitly NOT saturation: nothing is made more
// colorful, colored light is made to carry more weight. Neutrals, near-neutrals
// and skin are meant to be left where they are.
//
// APPROACH: photographic density is defined as the negative logarithm of
// transmittance, so adding density is literally a subtraction in a log domain,
// which is where this stage already runs. The amount subtracted is scaled by a
// selectivity curve on chroma, and the SAME amount is subtracted from all three
// channels. That uniform log offset is an exact exposure pull on the pixel, so
// the ratios between the channels survive untouched and neither hue nor the
// chroma measure itself is changed: the color darkens without turning.
//
// Two controls, because amount and selectivity are genuinely different needs:
//   Film Density    - how much density is added at full chroma
//   Density Strength- how far down the chroma scale the effect reaches. Low
//                     values are a cube law, so only the purest colors gain
//                     density at all; high values approach linear, so mid-chroma
//                     colors join in.
//
// LIMITATIONS: it darkens only, so it cannot recover a color that is already
// too dark, and pushed hard on an already-dark saturated area it will close
// that area up. Skin protection is statistical rather than semantic: it works
// because skin has low chroma, so an unusually saturated skin tone under strong
// colored light will be treated as a saturated color and gain density. There is
// no hue detection here by design.
//
// WHY THIS APPROACH: a saturation-style operator was rejected because it scales
// chroma, which is the thing the control is specifically not supposed to do,
// and because scaling chroma is what produces clipping. Subtracting a uniform
// log offset cannot clip: it only ever moves values downwards, it cannot
// introduce a channel crossing, and it is exactly the physical definition of
// density rather than an analogy to it.
__DEVICE__ float3 cc_film_density(float3 v, float amount, float strength)
{
    if (amount <= 0.0f) return v;

    float e = cc_lerp(CC_DENSITY_EXP_LO, CC_DENSITY_EXP_HI, _saturatef(strength));
    float w = cc_chroma_weight(cc_chroma(v), e);
    float o = -_saturatef(amount) * CC_DENSITY_AMOUNT * w;

    return make_float3(v.x + o, v.y + o, v.z + o);
}


// ============================================================================
//  SECTION 8 :: SATURATION FUNCTIONS
//  Three operators that all change color strength, kept separate because they
//  do it in three genuinely different ways:
//     Saturation             expands about LUMINANCE  - brightness preserved
//     Subtractive Saturation contracts towards the MAX - image darkens
//     Richness               expands about the MEDIAN  - channels spread apart
//  Only the first uses the luminance weighting of Section 2.2 at all.
// ============================================================================

// PURPOSE: a predictable, neutral saturation control with no character of its
// own, so it can be used to correct rather than to style.
//
// METHOD: scale the deviation of each channel from the pixel's luminance, in
// the log domain. All three channels are scaled by the SAME factor, so the
// direction of the color vector is unchanged and no hue rotation is
// introduced by the operation. Luminance is added back unmodified, so the
// pixel's brightness is preserved exactly and this control cannot act as an
// accidental exposure control. A neutral pixel has zero deviation and is
// therefore mathematically untouched at any setting.
//
// PROTECTION: boosts are braked by a factor of 1 / (1 + k * chroma * boost).
// The denominator is a sum of non-negative terms plus one, so it is always at
// least 1: the brake is bounded in (0, 1], can never divide by zero, and can
// only ever reduce a boost, never invert or amplify it. The practical effect
// is that already-saturated color gains less than near-neutral color does,
// which is what stops strong primaries from tearing apart at high settings.
// Desaturation is unconditionally stable and is deliberately left unbraked so
// that saturation 0 produces an exact monochrome.
//
// APPROXIMATION / LIMITATION: operating in log rather than linear is a
// deliberate choice. Log-domain saturation is far gentler and is what makes
// boosts look like color rather than like clipping, but it is not
// chromaticity-preserving in a strict colorimetric sense, so extreme boosts
// drift slightly in hue. Linear-domain saturation is colorimetrically cleaner
// but drives channels negative almost immediately on saturated color and
// looks harsh. The log version is the better trade for a grading tool, and is
// labelled here as an approximation rather than a color appearance model.
__DEVICE__ float3 cc_saturation(float3 v, float sat)
{
    if (sat == 1.0f) return v;

    float s = _fmaxf(sat, 0.0f);
    float y = cc_luma(v);

    float dr = v.x - y;
    float dg = v.y - y;
    float db = v.z - y;

    float chroma = cc_sqrt(dr * dr + dg * dg + db * db);
    float boost  = _fmaxf(s - 1.0f, 0.0f);
    float brake  = 1.0f / (1.0f + CC_SAT_PROTECT * chroma * boost);
    float scale  = 1.0f + (s - 1.0f) * brake;

    return make_float3(y + dr * scale, y + dg * scale, y + db * scale);
}

// --- Subtractive saturation -------------------------------------------------
// INTENDED BEHAVIOR: increasing saturation should make colors feel denser and
// darker rather than brighter and more electric, the way adding dye to a print
// does. A red should deepen towards crimson, not glow.
//
// APPROACH: additive saturation expands color about luminance, which pushes the
// brightest channel UP and is what makes digital saturation clip and glow.
// Subtractive color works the other way round: adding dye removes light from
// the channels that are not the color, and leaves the channel that is the color
// alone. So this operator anchors on the MAXIMUM channel and widens each
// channel's gap below it:
//
//     gap  = max - channel        ( always >= 0 )
//     gap' = gap * gain           ( widened )
//     out  = max - gap'
//
// The brightest channel has zero gap and therefore never moves, which is why
// this cannot introduce highlight clipping no matter how far it is pushed. The
// other channels fall, so the color both saturates and darkens in one move,
// which is the whole point. A neutral has three zero gaps and is mathematically
// untouched. All gaps are scaled by the same factor, so the direction of the
// color is preserved and the operator introduces no hue rotation of its own.
//
// PROTECTION: the gap is not widened and then clipped. What is bounded is the
// INCREASE itself, which is fitted asymptotically into the headroom remaining
// between the current gap and a ceiling:
//
//     increase' = headroom * ( 1 - exp( -increase / headroom ) )
//
// This is deliberately not a soft ceiling applied to the widened gap. Bounding
// the widened value can return something SMALLER than the original gap once the
// gap is large, which would make a saturation control quietly desaturate the
// most saturated colors in the frame. Bounding the increase instead makes the
// increase non-negative by construction, so the gap can never shrink, while the
// result still approaches the ceiling asymptotically and never reaches it. For
// small gaps the exponential is linear to first order, so ordinary colors get
// exactly the scaling the control advertises.
//
// LIMITATIONS: because the image darkens as it saturates, this control does
// interact with exposure, which is inherent to subtractive behavior rather than
// a defect. Large gaps receive proportionally less increase than small ones, so
// very saturated colors take on a small hue shift near the ceiling; that is the
// price of the stability guard.
//
// WHY THIS APPROACH: anchoring at the maximum is what distinguishes subtractive
// from additive behavior, and it is also what makes the operator structurally
// incapable of clipping, so no output clamp is needed to keep it safe.
__DEVICE__ float cc_subsat_gap(float gap, float boost)
{
    float head = CC_SUBSAT_LIMIT - gap;
    if (head <= CC_EPS) return gap;          // already past the ceiling, leave it
    return gap + head * (1.0f - cc_exp(-(gap * boost) / head));
}

__DEVICE__ float3 cc_subtractive_saturation(float3 v, float amount)
{
    if (amount <= 0.0f) return v;

    // The boost carries the control amount, so amount 0 gives a zero increase
    // and an exact identity with no blend needed.
    float b  = _saturatef(amount) * CC_SUBSAT_GAIN;
    float mx = cc_maxc(v);

    return make_float3(mx - cc_subsat_gap(mx - v.x, b),
                       mx - cc_subsat_gap(mx - v.y, b),
                       mx - cc_subsat_gap(mx - v.z, b));
}

// --- Richness ---------------------------------------------------------------
// INTENDED BEHAVIOR: more perceived depth and separation between colors,
// concentrated in the midtones, without reading as a saturation boost. Where
// saturation makes color louder, richness should make it feel more layered.
//
// APPROACH: expand the channels about the MEDIAN channel rather than about
// luminance or the maximum. That is a symmetric move: the top channel rises a
// little, the bottom channel falls a little, and the middle stays put. Widening
// the spread between the three channels is literally increasing channel
// separation, which is what reads as depth, and because the move is symmetric
// the pixel's overall brightness barely shifts, so it does not behave like the
// saturation control sitting next to it.
//
// The effect is weighted by a smooth bump on the median channel, zero and flat
// at both ends of the window, so shadows and highlights are excluded and the
// midtones carry the effect. Using the median as the tone estimate is
// deliberate: it is already computed for the anchor, it is exact for neutrals,
// and it needs no luminance coefficients, so this stage introduces no
// dependence on the approximation in Section 2.2.
//
// PROTECTION: the expansion is braked by 1 / (1 + k * chroma * boost). The
// denominator is a sum of non-negative terms plus one, so the brake is bounded
// in (0,1], cannot divide by zero, and can only ever reduce the expansion.
// Already-saturated midtones therefore gain less than muted ones do.
//
// LIMITATIONS: unlike the two operators above, this one does raise the top
// channel, so it can in principle brighten a channel. It is bounded by the
// midtone window, the gain ceiling and the chroma brake, and highlights are
// excluded by the weighting, but it is the one Phase 2 stage that is not
// structurally incapable of pushing a channel up.
//
// WHY THIS APPROACH: anchoring at the median is the only one of the three
// anchor choices that is symmetric, which is what makes richness feel different
// from saturation rather than like a weaker copy of it. Restricting it to the
// midtones is what keeps it from competing with the shoulder and toe.
__DEVICE__ float3 cc_richness(float3 v, float amount)
{
    if (amount <= 0.0f) return v;

    float a  = _saturatef(amount);
    float md = cc_median3(v.x, v.y, v.z);

    // Midtone bump: zero and flat at both ends of the window. The window is a
    // pair of constants, so the normalization denominator can never be zero.
    float u = _saturatef((md - CC_RICH_LO) / (CC_RICH_HI - CC_RICH_LO));
    float b = u * (1.0f - u);
    float w = 16.0f * b * b;

    float boost = a * CC_RICH_GAIN * w;
    float brake = 1.0f / (1.0f + CC_RICH_PROTECT * cc_chroma(v) * boost);
    float gain  = 1.0f + boost * brake;

    return make_float3(md + (v.x - md) * gain,
                       md + (v.y - md) * gain,
                       md + (v.z - md) * gain);
}


// ============================================================================
//  SECTION 9 :: COLOR CHARACTER FUNCTIONS
//  Hue-shaping stages. These are kept strictly separate from the luminance and
//  density stages above: nothing here reads a luminance value, and nothing here
//  changes one deliberately.
// ============================================================================

// --- Color separation -------------------------------------------------------
// INTENDED BEHAVIOR: neighbouring hues become easier to tell apart, while skin
// and neutrals stay where they are and the primaries do not swing around.
//
// APPROACH: separation is a change in how fast hue varies, not a rotation, so
// this is built as a contrast curve on hue position rather than as an offset.
//
// Sort the channels into min, median and max. The max and min identify which
// 60-degree sector of the hue circle the pixel is in; the median's position
// inside that sector,
//
//     p = (median - min) / (max - min)        in 0..1
//
// is where the hue sits within the sector. Applying a smoothstep to p is a
// contrast curve on hue: p = 0 and p = 1 are exact fixed points, so the six
// pure hue axes cannot move at all, while hues in the middle of a sector are
// pushed apart from each other at up to 1.5x the original rate. That is
// separation between neighbouring hues with no rotation of the primaries.
//
// Only the median channel is moved. Min and max are preserved exactly, so the
// chroma measure is unchanged to the last bit and this stage cannot alter
// saturation, brightness or density. It is a pure hue operation.
//
// STABILITY: pixels below the chroma floor return untouched, because hue is
// meaningless for a neutral and p would be ill-conditioned. Above the floor the
// effect is scaled by the same chroma selectivity curve used by film density,
// so low-chroma colors barely move: skin sits at roughly a quarter of a
// saturated primary's spread, and the squared weight leaves it at a few percent
// of the effect. The blend is capped at CC_SEP_MAX so the mapping's slope stays
// strictly positive across the whole sector, which means hue order is preserved
// and hues near a primary compress towards it without ever collapsing onto it.
//
// LIMITATIONS: hue position here is defined in log RGB, not in a perceptual hue
// space, so equal changes in p are not perceptually equal across the circle.
// This is an APPROXIMATION of hue and is labelled as one. Also, since the
// average slope of any fixed-endpoint mapping is 1, extra separation in the
// middle of a sector is necessarily paid for with mild compression near the
// sector ends. That trade is deliberate: it is what gives cleaner primaries.
//
// WHY THIS APPROACH: an arc tangent hue angle followed by a rotation was
// rejected on two grounds. It is ill-conditioned near neutral, exactly where
// stability matters most, and a rotation moves colors bodily around the wheel,
// which is the aggressive hue shifting this control is supposed to avoid. The
// sector-position formulation has no trigonometry, no ill-conditioning, and
// pins the six primaries by construction.

// Rebuilds a pixel after the median channel has been moved. Written as a
// monotone piecewise-linear remap pinned at min, median and max rather than as
// an offset applied to whichever channel is the median, because that handles
// ties between equal channels without double-counting them. Both denominators
// are tested before use.
__DEVICE__ float cc_remap_mid(float c, float mn, float md, float mx, float mdOut)
{
    if (c <= md)
    {
        float d = md - mn;
        return (d > CC_EPS) ? (mn + (c - mn) * (mdOut - mn) / d) : mdOut;
    }
    float d = mx - md;
    return (d > CC_EPS) ? (mdOut + (c - md) * (mx - mdOut) / d) : mdOut;
}

__DEVICE__ float3 cc_color_separation(float3 v, float amount)
{
    if (amount <= 0.0f) return v;

    float mx = cc_maxc(v);
    float mn = cc_minc(v);
    float range = mx - mn;

    // Near-neutral: hue carries no information and p is ill-conditioned.
    if (range < CC_CHROMA_FLOOR) return v;

    float md = cc_median3(v.x, v.y, v.z);
    float p  = _saturatef((md - mn) / range);          // guarded by the floor

    float k  = _saturatef(amount) * CC_SEP_MAX * cc_chroma_weight(range, CC_SEP_EXP);
    float sp = p * p * (3.0f - 2.0f * p);              // fixed at p = 0 and p = 1
    float mdOut = mn + (p + k * (sp - p)) * range;

    return make_float3(cc_remap_mid(v.x, mn, md, mx, mdOut),
                       cc_remap_mid(v.y, mn, md, mx, mdOut),
                       cc_remap_mid(v.z, mn, md, mx, mdOut));
}


// ============================================================================
//  SECTION 10 :: OUTPUT SAFETY
// ============================================================================

// PURPOSE: a containment net, not a look. Both limiters are asymptotic and
// their knees sit outside the useful signal range: the ceiling knee is at code
// value 1.0, which is already linear 100, and the floor knee is at 0.0. Real
// imagery, including legitimate small negatives from wide-gamut color, passes
// through essentially untouched, while a runaway value from an extreme grade
// is contained smoothly instead of producing a hard edge or an infinity.
//
// Deliberately NOT a clamp to [0,1]: clamping would destroy highlight roll-off
// and remove the out-of-gamut negatives that later stages need in order to
// recover color properly.
__DEVICE__ float cc_out_limit(float x)
{
    float y = cc_soft_ceil(x, CC_OUT_CEIL_KNEE, CC_OUT_CEIL_RANGE);
    return cc_soft_floor(y, CC_OUT_FLOOR_KNEE, CC_OUT_FLOOR_RANGE);
}

__DEVICE__ float3 cc_out_limit3(float3 v)
{
    return make_float3(cc_out_limit(v.x), cc_out_limit(v.y), cc_out_limit(v.z));
}


// ============================================================================
//  SECTION 11 :: MAIN TRANSFORM
// ============================================================================

// NOTE: Resolve parses this signature textually from the line containing
// "transform(", so it MUST stay on a single line. Wrapping it produces
// "wrong argument int p_Width in Transform DCTL" even though the arguments
// are correct and the file is valid C.
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    // -- 1. Input handling and safety ---------------------------------------
    // Sanitised once here and once on the way out. Intermediate stages are
    // deliberately left unsanitized: every function above is total, so a
    // finite input cannot produce a non-finite output, and re-clamping between
    // stages would quietly damage highlights and wide-gamut negatives.
    float3 rgb = cc_safe3(make_float3(p_R, p_G, p_B));

    if (gBypass) return rgb;

    float3 cv;  // code value, DaVinci Intermediate log

    // Scene-referred stages. The linear round trip is skipped entirely when
    // exposure and white balance are neutral, so an untouched panel is an
    // exact pass-through rather than a round-trip approximation.
    if (gExposure != 0.0f || gTemperature != 0.0f || gTint != 0.0f)
    {
        float3 lin = (gInputEncoding == CC_ENC_LIN) ? rgb : cc_di_to_lin3(rgb);

        // -- 2. Exposure ----------------------------------------------------
        lin = cc_exposure(lin, gExposure);

        // -- 3 / 4. White balance and tint ----------------------------------
        lin = cc_white_balance(lin, gTemperature, gTint);

        cv = cc_lin_to_di3(lin);
    }
    else
    {
        cv = (gInputEncoding == CC_ENC_LIN) ? cc_lin_to_di3(rgb) : rgb;
    }

    // -- 5 / 6. Contrast about the pivot ------------------------------------
    cv = cc_contrast(cv, gContrast, gPivot);

    // -- 7. Highlight shoulder ----------------------------------------------
    cv = cc_highlight_shoulder(cv, gHighlightShoulder, gHighlightRollOff);

    // -- 8. Shadow toe, then shadow depth -----------------------------------
    cv = cc_shadow_toe(cv, gShadowToe);
    cv = cc_shadow_depth(cv, gShadowDepth, gPivot);

    // -- 9 / 10. Black point and white point --------------------------------
    cv = cc_black_white_point(cv, gBlackPoint, gWhitePoint);

    // -- 11. Saturation ------------------------------------------------------
    //  The neutral primary saturation runs BEFORE the film character block, so
    //  the density and richness stages act on a corrected image rather than
    //  fighting a correction applied after them.
    cv = cc_saturation(cv, gSaturation);

    // -- 12. Film density ----------------------------------------------------
    cv = cc_film_density(cv, gFilmDensity, gDensityStrength);

    // -- 13. Subtractive saturation ------------------------------------------
    cv = cc_subtractive_saturation(cv, gSubSaturation);

    // -- 14. Richness --------------------------------------------------------
    cv = cc_richness(cv, gRichness);

    // -- 15. Color separation ------------------------------------------------
    cv = cc_color_separation(cv, gColorSeparation);

    //  Phases 3-5 insert hue densities, split toning, bleach bypass and the
    //  film look engine at this point.

    // -- 16. Output safety ---------------------------------------------------
    cv = cc_out_limit3(cv);

    if (gInputEncoding == CC_ENC_LIN) cv = cc_di_to_lin3(cv);

    return cc_safe3(cv);
}
