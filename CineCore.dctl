// ---- Hue density ----------------------------------------------------------
//  Positive adds density to that hue family - deeper, heavier. Negative opens
//  it up. Bands overlap deliberately so hues blend rather than banding at the
//  boundaries; Red, Orange and Yellow are anchored closer together than the
//  rest because that is where discrimination matters most.
DEFINE_UI_PARAMS(gRedDensity, Red Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gOrangeDensity, Orange Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gYellowDensity, Yellow Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gGreenDensity, Green Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gCyanDensity, Cyan Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gBlueDensity, Blue Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gMagentaDensity, Magenta Density, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)

// ---- Split toning ---------------------------------------------------------
//  Positive moves each end in the direction its name states. Negative reverses
//  it, so highlights can be cooled and shadows warmed from the same controls.
DEFINE_UI_PARAMS(gWarmHighlights, Warm Highlights, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gCoolShadows, Cool Shadows, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gSplitBalance, Split Tone Balance, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)

// ---- Bleach bypass --------------------------------------------------------
DEFINE_UI_PARAMS(gBleachBypass, Bleach Bypass, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gBleachMix, Bleach Bypass Mix, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f, 0.001f)

// ---- Optical, per-pixel ----------------------------------------------------
//  Matte reads only the pixel it is working on. The sampled effects that read
//  neighbours are grouped separately below.
DEFINE_UI_PARAMS(gMatte, Matte, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)

// ---- Optical, sampled -------------------------------------------------------
//  These read neighbouring pixels and so cost texture taps. Each is skipped
//  entirely at zero, so an unused one costs nothing at all.
DEFINE_UI_PARAMS(gChromAb, Chromatic Aberration, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gChromAbRadius, Chromatic Aberration Radius, DCTLUI_SLIDER_FLOAT, 0.4f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gChromAbFalloff, Chromatic Aberration Falloff, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gFilmSoft, Film Softness, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gFilmSoftRadius, Film Softness Radius, DCTLUI_SLIDER_FLOAT, 0.4f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gMicroContrast, Micro Contrast, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gMicroRadius, Micro Contrast Radius, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)

