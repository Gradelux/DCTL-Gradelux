// ============================================================================
//  CineCore
//  A modular grading and film-look engine for DaVinci Resolve
//  ---------------------------------------------------------------------------
//  Working space : DaVinci Wide Gamut / DaVinci Intermediate, required.
//                  There is no input encoding option: every threshold, knee and
//                  pivot in this file is anchored to DI code values, so feeding
//                  it anything else puts all of them in the wrong place.
//  Build stage   : PHASE 3 + OPTICAL EFFECTS
//                  Phase 1  input safety, exposure, white balance, tint,
//                           contrast, pivot, highlight shoulder, shadow toe,
//                           shadow depth, black point, white point,
//                           saturation, output safety.
//                  Phase 2  film density, subtractive saturation, richness,
//                           color separation.
//                  Phase 3  hue density shaping, split toning, bleach bypass.
//
//  Later phases add hue densities, split toning, bleach bypass and the
//  parametric look engine. The pipeline is staged so those drop in without
//  restructuring.
//
// ============================================================================


// ============================================================================
//  SECTION 1 :: UI PARAMETERS AND LUT DECLARATIONS
//  Every control is neutral at its default: with the panel untouched this
//  DCTL returns its input unchanged, and the film look defaults to None.
// ============================================================================

// ---- Setup ----------------------------------------------------------------
DEFINE_UI_PARAMS(gBypass, Bypass, DCTLUI_CHECK_BOX, 0)

//  Quality halves the ANGULAR sampling density of the seven effects that read
//  neighbouring pixels: 8 directions per ring or 4. Ring radii are untouched,
//  so an effect's reach and shape are identical in both modes and only the
//  smoothness of the glow changes. Dropping rings instead was tried and
//  rejected: it shortens the reach, which makes the effect look wrong rather
//  than cheaper.
//
//     Full   20 taps per pixel with every sampled effect enabled
//     Fast   10
//
//  It changes NOTHING when those effects are off - their gathers are skipped
//  entirely at zero strength. Fast interleaves directions between rings so
//  coverage stays even instead of collapsing into a cross, but a small isolated
//  highlight can still show slight angular structure.
DEFINE_UI_PARAMS(gQuality, Quality, DCTLUI_COMBO_BOX, 0, {CC_Q_FULL, CC_Q_FAST}, {Full, Fast})

// ---- Primary grade --------------------------------------------------------
DEFINE_UI_PARAMS(gExposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0f, -5.0f, 5.0f, 0.01f)
DEFINE_UI_PARAMS(gTemperature, Temperature, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gTint, Tint, DCTLUI_SLIDER_FLOAT, 0.0f, -1.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gContrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0f, 0.25f, 2.5f, 0.001f)
DEFINE_UI_PARAMS(gPivot, Pivot, DCTLUI_SLIDER_FLOAT, 0.336f, 0.15f, 0.6f, 0.001f)
DEFINE_UI_PARAMS(gSaturation, Saturation, DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 2.0f, 0.001f)
DEFINE_UI_PARAMS(gBlackPoint, Black Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.05f, 0.05f, 0.0005f)
DEFINE_UI_PARAMS(gWhitePoint, White Point, DCTLUI_SLIDER_FLOAT, 0.0f, -0.15f, 0.15f, 0.0005f)

// ---- Film response --------------------------------------------------------
DEFINE_UI_PARAMS(gHighlightShoulder, Highlight Shoulder, DCTLUI_SLIDER_FLOAT, 0.0f, 0.0f, 1.0f, 0.001f)
DEFINE_UI_PARAMS(gHighlightRollOff, Highlight Roll Off, DCTLUI_SLIDER_FLOAT, 0.5f, 0.0f, 1.0f, 0.001f)
