        // Pearl-neutral, creamy highlights (a long smooth shoulder, no warm
        // cast), clean neutral shadows, soft but substantial contrast and
        // gentle separation. Distinct from Aurelia (warm cream, olive) and
        // Pastelle (mint greens, pink skin, airy).
        s = glx_set_render(s, -0.20f, 2.5f, 0.95f);
        s = glx_set_tone (s, 1.44f, 3.2f, 3.6f, -0.40f, 0.10f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.02f, 0.0f, 0.02f,  0.0f, 0.0f, 0.0f,  0.01f, 0.01f, 0.0f);
        s = glx_set_color(s, 0.95f, 0.45f, 0.20f, 0.04f, 0.15f, 0.05f, 0.0f);
