        // reds turn reddish-brown (orange-shifted and dense), yellows lean
        // green, greens turn yellow-olive, blues and cyans are muted. Rich
        // blacks and finished contrast; slightly muted photographic
        // saturation. Unlike Solara it is not golden and its blacks are not
        // lifted.
        s = glx_set_render(s, -0.25f, 2.5f, 0.80f);
        s = glx_set_tone (s, 1.38f, 3.0f, 3.2f, -0.50f, 0.25f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.06f, 0.08f, -0.02f,  -0.02f, 0.07f, -0.07f,  0.05f, 0.07f, -0.06f);
        s = glx_set_color(s, 0.94f, 0.40f, 0.30f, 0.0f, 0.45f, 0.10f, 0.15f);
        s = glx_set_hue  (s, 12.0f, 10.0f, -18.0f, -4.0f, -10.0f, 0.0f);
        s = glx_set_hsat (s, 0.95f, 1.08f, 0.90f, 0.78f, 0.72f, 0.85f);
        s = glx_set_hden (s, -0.35f, 0.05f, -0.12f, -0.08f, -0.10f, -0.10f);
