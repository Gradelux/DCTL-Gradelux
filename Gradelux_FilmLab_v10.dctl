    } else if (id == GLX_LOOK_CHROMA_100) {
        // CHROMA: colourful, crisp photographic colour (Ektar / slide-
        // film-inspired). A different tonal family: the steepest mid slope,
        // a hard toe and an early shoulder (slide-like), and - unlike the
        // negatives - shadows hold their colour. V6.1: colour is carried by
        // subtractive DENSITY (rich, darker saturated colours) rather than by
        // raw saturation. A gentler per-layer response and lighter red-layer
        // masking stop reds and oranges from running away; red, yellow,
        // blue and magenta zones are held back so foliage and skies stay
        // natural. Still the most colourful stock, with clean neutral greys.
        s = glx_set_render(s, -0.08f, 2.0f, 0.65f);
        s = glx_set_tone (s, 1.50f, 2.6f, 2.8f, -0.45f, 0.22f);
        s = glx_set_chan (s, 0.0f, 0.0f, 0.02f,  0.0f, 0.0f, 0.0f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.01f, 0.0f, 0.02f,  0.0f, 0.0f, 0.0f,  0.01f, 0.0f, -0.01f);
        s = glx_set_color(s, 1.32f, 0.28f, -0.05f, 0.08f, 0.45f, 0.20f, 0.18f);
        s = glx_set_hue  (s, 0.0f, 0.0f, 4.0f, 6.0f, 2.0f, 0.0f);
        s = glx_set_hsat (s, 0.85f, 0.90f, 0.98f, 1.02f, 0.96f, 0.96f);
        s = glx_set_hden (s, -0.25f, -0.06f, -0.20f, -0.15f, -0.28f, -0.12f);
        s = glx_set_dye  (s, -0.03f, -0.015f, -0.035f, -0.035f, -0.02f, -0.05f, 0.85f);
    } else if (id == GLX_LOOK_SILVERGRAIN_100) {
        // SILVERGRAIN: soft vintage black-and-white. Not a desaturation:
        // a blue-leaning, early-panchromatic sensitivity (blues and skies
        // render light and luminous, up to ~1 stop over luminance; skin,
        // reds and foliage render deeper), delicate mids (gentle slope), an
        // early smooth shoulder, and lifted but rich blacks (a dense toe under
        // a soft veil).
        s = glx_set_mono  (s, 0.22f, 0.52f, 0.26f);
        s = glx_set_render(s, 0.0f, 2.5f, 0.60f);
        s = glx_set_tone  (s, 1.12f, 3.0f, 3.0f, -0.25f, 0.0f);
        s = glx_set_fade  (s, 0.006f, 1.0f, 1.0f, 1.0f);
        s = glx_set_hden  (s, -0.08f, 0.02f, 0.04f, 0.06f, 0.10f, 0.0f);

    // ---- Version 7 additions ---------------------------------------------------
    } else if (id == GLX_LOOK_TUNGSTEN_500T) {
        // TUNGSTEN: balanced tungsten-type motion-picture negative.
        // Natural and lighter than Midnight: neutral midtones, rich but not
        // extreme contrast with a long, detailed toe and a long smooth
        // shoulder. Narrow tonal zones put the colour where tungsten film
        // shows it: gently cool-neutral ambient shadows against warm amber
        // highlights and practicals (warmth carried mostly by red, so lights
        // stay amber rather than orange-brown). Strong dye DENSITY rather
        // than raw saturation (deep, dense reds and blues); distinctive hue
        // signature - reds lean orange, yellows lean amber, blues lean
        // slightly violet - with natural, full greens and natural skin.
        s = glx_set_render(s, 0.06f, 1.6f, 0.75f);
        s = glx_set_tone (s, 1.32f, 3.6f, 4.0f, -0.35f, 0.25f);
        s = glx_set_chan (s, 0.01f, 0.0f, -0.01f,  0.0f, 0.0f, 0.0f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.05f, 0.0f, 0.04f,  0.0f, 0.0f, 0.0f,  0.14f, 0.06f, -0.06f);
        s = glx_set_color(s, 1.02f, 0.30f, 0.25f, 0.06f, 0.55f, 0.10f, 0.12f);
        s = glx_set_hue  (s, 6.0f, -6.0f, 0.0f, 0.0f, 4.0f, 2.0f);
        s = glx_set_hsat (s, 1.10f, 1.15f, 1.0f, 0.90f, 1.20f, 0.90f);
        s = glx_set_hden (s, -0.25f, -0.14f, -0.10f, -0.08f, -0.25f, -0.10f);
