// =============================================================================
//  GRADELUX FILMLAB  —  Version 10
//  21 film looks (18 film-engine looks + 3 original Gradelux LUT looks)
//  + 16 Cine16 secondary profiles
//  Film look engine for DaVinci Resolve Studio (DCTL)
//  (c) Gradelux. All rights reserved.
// =============================================================================
//
//  COLOUR SPACE CONTRACT
//  ---------------------
//    Input  : DaVinci Wide Gamut / DaVinci Intermediate
//    Output : DaVinci Wide Gamut / DaVinci Intermediate
//
//    There is no input selector. Place FilmLab after the input CST (or inside
//    an RCM timeline set to DWG/Intermediate) and before the output CST / DRT.
//    The only internal conversion that is not part of the film engine is the
//    optional Rec.709 round trip for the LUT looks (see LUT INPUT SPACE).
//
//  VERSION HISTORY
//  ---------------
//    6    : production foundation; Verona, Verdant, Midnight, Aurelia, Solara,
//           Moss, Chroma, Silvergrain.
//    6.1  : Moss and Chroma refined.
//    7    : Tungsten, Halcyon, Argent, Nocturne, Pastelle added.
//    8    : SECONDARY FILM LOOK engine: the sixteen Gradelux Cine16 profiles,
//           integrated from the original Cine16 DCTL (1B . Film Color Profile
//           v2.2) with their colour science unchanged (CINE16 SECONDARY ENGINE).
//    9    : middle-grey anchoring of the film-engine looks; Argent and
//           Nocturne redesigned; Patina, Opaline, Glacier, Terracotta, Velour
//           added; Exposure, Temperature, Tint added.
//    9.1  : simplified interface; removed controls fixed at their Version 9
//           defaults (FIXED SETTINGS).
//    10   : - FILM PRINT engine removed (dropdown, Print Strength, the five
//             prints and their code). Every look renders exactly as Version
//             9.1 did with Film Print = None.
//           - Three original Gradelux LUT looks added to the Film Look
//             dropdown: 19 Vista, 20 Lux, 21 Laguna. Their .cube data is
//             embedded verbatim (ORIGINAL LUT DATA) and applied by Resolve's
//             own LUT engine (APPLY_LUT); nothing is resampled or approximated.
//           - Two dropdowns and eleven sliders.
//
//  PROCESSING ORDER
//  ----------------
//    1. PRIMARY CORRECTIONS (scene-linear): Exposure, then Temperature and
//       Tint (chromatic adaptation). Each is bypassed exactly at 0.
//    2. FILM LOOK, one of:
//       a. Film-engine look (Verona ... Velour), in linear working space
//          (Rec.2020 primaries, internal only; see COLORIMETRY), scaled by
//          Film Strength (internally: Creative Intensity).
//       b. Original LUT look (Vista, Lux, Laguna): the embedded .cube, applied
//          in its input space (LUT INPUT SPACE), then mixed with its input by
//          Film Strength in DaVinci Intermediate (100% = the LUT exactly).
//    3. SECONDARY FILM LOOK (Cine16): when not Off, the result so far is
//       processed in DaVinci Intermediate by the original Cine16 engine.
//    4. FILM ADJUSTMENTS: fixed at their Version 9 defaults, which are an
//       exact bypass (see FIXED SETTINGS).
//    5. GRADING CONTROLS: Film Density, Subtractive Saturation, Film
//       Contrast, Shadow Depth, Highlight Roll-Off.
//    6. Global Intensity: final mix with the untouched input, done in
//       DaVinci Intermediate so the fade is perceptually even.
//
//    Every stage depends only on the pixel's RGB and its own settings: no
//    image coordinates, neighbours, time or randomness, so any configuration
//    can be sampled into a 3D LUT.
//
//  SIGNED / EXTENDED VALUES
//  ------------------------
//    The film engine applies no 0–1 clamp: negatives and highlights far above
//    1.0 linear pass through every stage with finite, sign-preserving
//    responses. The LUT looks are bounded by their LUT: a .cube covers only
//    its 0–1 input domain, so values outside it are clamped to the domain
//    edge before the lookup (as Resolve does when it applies a LUT on a node).
//
//  IDENTITY
//  --------
//    Film Look = Off and Secondary Film Look = Off with every slider at its
//    default (or Global Intensity at 0%) returns the input bit-for-bit
//    (processing is skipped). Film Strength 0% bypasses the Film Look exactly,
//    including the LUT looks.
//
//  ARCHITECTURE
//  ------------
//    GlxProfile  : constants of the Version 1 operators.
//    GlxLook     : the characteristic numbers of a film-engine look (see
//                  FILM LOOK ENGINE).
//    GlxFilmAdj  : the four film adjustments, normalised (fixed).
//    GlxControls : the grading sliders, normalised.
// =============================================================================


// -----------------------------------------------------------------------------
//  USER INTERFACE  (Version 10: two dropdowns, eleven sliders)
//  Pipeline order: corrections -> film look -> secondary look -> grading ->
//  Global Intensity.
// -----------------------------------------------------------------------------
// ---- Primary corrections (scene-linear, before the film engines) ----------
DEFINE_UI_PARAMS(ui_Exposure,    Exposure,    DCTLUI_SLIDER_FLOAT, 0.0, -5.0, 5.0, 0.1)
DEFINE_UI_PARAMS(ui_Temperature, Temperature, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(ui_Tint,        Tint,        DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_TOOLTIP(Exposure, "Scene-linear exposure in stops, before the film engines. 0 = no change.")
DEFINE_UI_TOOLTIP(Temperature, "Creative white balance (chromatic adaptation along the daylight locus). - cooler, + warmer. Not calibrated Kelvin.")
DEFINE_UI_TOOLTIP(Tint, "Creative white balance perpendicular to the daylight locus. - greener, + more magenta.")

// ---- Film customization -----------------------------------------------------
DEFINE_UI_PARAMS(ui_Look, Film Look, DCTLUI_COMBO_BOX, 0, { GLX_LOOK_OFF, GLX_LOOK_VERONA_250D, GLX_LOOK_VERDANT_250D, GLX_LOOK_MIDNIGHT_800T, GLX_LOOK_AURELIA_400, GLX_LOOK_SOLARA_200, GLX_LOOK_MOSS_250D, GLX_LOOK_CHROMA_100, GLX_LOOK_SILVERGRAIN_100, GLX_LOOK_TUNGSTEN_500T, GLX_LOOK_HALCYON_400, GLX_LOOK_ARGENT_200, GLX_LOOK_NOCTURNE_800, GLX_LOOK_PASTELLE_400, GLX_LOOK_PATINA, GLX_LOOK_OPALINE, GLX_LOOK_GLACIER, GLX_LOOK_TERRACOTTA, GLX_LOOK_VELOUR, GLX_LOOK_VISTA, GLX_LOOK_LUX, GLX_LOOK_LAGUNA }, { "Off", "Verona", "Verdant", "Midnight", "Aurelia", "Solara", "Moss", "Chroma", "Silvergrain", "Tungsten", "Halcyon", "Argent", "Nocturne", "Pastelle", "Patina", "Opaline", "Glacier", "Terracotta", "Velour", "Vista", "Lux", "Laguna" })
