DEFINE_UI_TOOLTIP(Film Look, "Film-engine looks (Verona to Velour) and the original Gradelux LUT looks (Vista, Lux, Laguna). Off = bypass.")
DEFINE_UI_TOOLTIP(Film Strength, "Strength of the selected Film Look. 100% = as designed (for Vista, Lux and Laguna: the original LUT exactly). 0% = bypass.")
