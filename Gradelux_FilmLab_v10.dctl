// =============================================================================
//  ENTRY POINT
// =============================================================================
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    GlxControls k;
    k.density   = _clampf(ui_Density   * 0.01f, -1.0f, 1.0f);
    k.subSat    = _clampf(ui_SubSat    * 0.01f, -1.0f, 1.0f);
    k.contrast  = _clampf(ui_Contrast  * 0.01f, -1.0f, 1.0f);
    k.shadow    = _clampf(ui_Shadow    * 0.01f, -1.0f, 1.0f);
    k.rolloff   = _clampf(ui_Rolloff   * 0.01f,  0.0f, 1.0f);
    k.intensity = _clampf(ui_Intensity * 0.01f,  0.0f, 1.0f);

    // Film adjustments: fixed at their Version 9 defaults (no effect).
    GlxFilmAdj adj;
    adj.cdScale    = 1.0f + _clampf(GLX_FIX_COLOR_DENSITY * 0.01f, -1.0f, 1.0f);
    adj.sepF       = _clampf((GLX_FIX_SEPARATION - 50.0f) * 0.02f, -1.0f, 1.0f);
    adj.warmth     = _clampf(GLX_FIX_HL_WARMTH   * 0.01f, -1.0f, 1.0f);
    adj.shadowTone = _clampf(GLX_FIX_SHADOW_TONE * 0.01f, -1.0f, 1.0f);

    // Film look (Film Strength = the former Creative Intensity). Off, or
    // Film Strength 0%, bypasses it exactly. Vista, Lux and Laguna are LUT
    // looks (lutId 1..3); every other look runs the film engine.
    float ci     = _clampf(ui_CreativeIntensity * 0.01f, 0.0f, 2.0f);
    int   lutId  = (ui_Look == GLX_LOOK_VISTA) ? 1 : (ui_Look == GLX_LOOK_LUX) ? 2 : (ui_Look == GLX_LOOK_LAGUNA) ? 3 : 0;
    int   lutOn  = (lutId != 0) && (ci > 0.0f);
    int   lookOn = (ui_Look != GLX_LOOK_OFF) && (lutId == 0) && (ci > 0.0f);
    GlxLook look = lookOn ? glx_look_scale(glx_look_get(ui_Look), ci) : glx_look_clean();

    int adjColor = (adj.sepF != 0.0f) || (lookOn && adj.cdScale != 1.0f);
    int adjTone  = (adj.warmth != 0.0f) || (adj.shadowTone != 0.0f);
    int post = adjColor || adjTone
            || (k.density != 0.0f) || (k.subSat != 0.0f) || (k.contrast != 0.0f)
            || (k.shadow  != 0.0f) || (k.rolloff > 0.0f);

    // Primary corrections (Version 9). Each is bypassed exactly at 0.
    float ev   = _clampf(ui_Exposure, -5.0f, 5.0f);
    float temp = _clampf(ui_Temperature, -100.0f, 100.0f);
    float tint = _clampf(ui_Tint, -100.0f, 100.0f);
    int   preOn = (ev != 0.0f) || (temp != 0.0f) || (tint != 0.0f);

    // Cine16 controls: Secondary Strength from the panel, the rest fixed.
    C16Controls sc;
    sc.strength = ui_SecStrength;
    sc.sep      = GLX_FIX_SEC_SEP;
    sc.sat      = GLX_FIX_SEC_SAT;
    sc.subtr    = GLX_FIX_SEC_SUBTR;
    sc.bias     = GLX_FIX_SEC_BIAS;
    sc.tone     = GLX_FIX_SEC_TONE;
    sc.skinprot = GLX_FIX_SEC_SKINPROT;
    int secOn = (ui_SecLook != GLX_SEC_OFF);


    // ---- Original LUT look (Vista, Lux, Laguna) -------------------------------
    // Everything here happens in DaVinci Intermediate, around the lookup.
    if (lutOn) {
        // 1. Primary corrections (none: the input reaches the LUT unconverted).
        float3 x = make_float3(p_R, p_G, p_B);
        if (preOn) x = glx_work_to_di(glx_corrections(glx_di_to_work(p_R, p_G, p_B), ev, temp, tint));

        // 2. The original LUT, in its input space (LUT INPUT SPACE).
        int space = (lutId == 1) ? GLX_LUT_SPACE_VISTA : (lutId == 2) ? GLX_LUT_SPACE_LUX : GLX_LUT_SPACE_LAGUNA;
        float3 li = (space == GLX_LUT_REC709) ? glx_di_to_rec709(x) : glx_lut_domain(x);
        float3 lo;
        if (lutId == 1)      lo = APPLY_LUT(li.x, li.y, li.z, GlxLutVista);
        else if (lutId == 2) lo = APPLY_LUT(li.x, li.y, li.z, GlxLutLux);
        else                 lo = APPLY_LUT(li.x, li.y, li.z, GlxLutLaguna);
        if (space == GLX_LUT_REC709) lo = glx_rec709_to_di(lo);
        float3 o = glx_lut_strength(x, lo, ci);

        // 3. Secondary film look: the original Cine16 engine (DI in, DI out).
        if (secOn) o = c16_apply(o.x, o.y, o.z, ui_SecLook - 1, sc, 0);

        // 4. Grading controls.
        if (post) {
            float3 pw = glx_di_to_work(o.x, o.y, o.z);
            pw = glx_process_post(pw.x, pw.y, pw.z, k, glx_profile_base(), look, 0, adj, adjColor, adjTone);
            o = glx_work_to_di(pw);
        }

        // 5. Global Intensity (same rule as below).
        float tl = k.intensity;
        if (tl >= 1.0f) return o;
        if (tl <= 0.0f) return make_float3(p_R, p_G, p_B);
        return make_float3(p_R + (o.x - p_R) * tl,
                           p_G + (o.y - p_G) * tl,
                           p_B + (o.z - p_B) * tl);
    }


    // ---- Secondary Film Look (Cine16) -----------------------------------------
    // Off skips this block entirely: the primary-only path below runs instead.
    if (secOn) {
        GlxProfile ps0 = glx_profile_base();

        // 1. Primary corrections and primary film look. Without either, the
        //    input reaches Cine16 unconverted.
        float3 si = make_float3(p_R, p_G, p_B);
        if (lookOn || preOn) {
            float3 lw = glx_di_to_work(p_R, p_G, p_B);
            if (preOn)  lw = glx_corrections(lw, ev, temp, tint);
            if (lookOn) lw = glx_look_apply(lw.x, lw.y, lw.z, look, ps0);
            si = glx_work_to_di(lw);
        }

        // 2. Secondary film look: the original Cine16 engine (DI in, DI out).
        float3 so = c16_apply(si.x, si.y, si.z, ui_SecLook - 1, sc, 0);

        // 3. Grading controls.
        if (post) {
            float3 pw = glx_di_to_work(so.x, so.y, so.z);
            pw = glx_process_post(pw.x, pw.y, pw.z, k, ps0, look, lookOn, adj, adjColor, adjTone);
            so = glx_work_to_di(pw);
        }

        // 4. Global Intensity (same rule as below).
        float ts = k.intensity;
        if (ts >= 1.0f) return so;
        if (ts <= 0.0f) return make_float3(p_R, p_G, p_B);
        return make_float3(p_R + (so.x - p_R) * ts,
                           p_G + (so.y - p_G) * ts,
                           p_B + (so.z - p_B) * ts);
    }

    // Exact identity: everything neutral, or 0% Global Intensity.
    int active = lookOn || preOn || post;
    if (!active || k.intensity <= 0.0f)
        return make_float3(p_R, p_G, p_B);

    GlxProfile p = glx_profile_base();

    // DaVinci Intermediate -> linear DWG -> linear working (Rec.2020 primaries).
    // Neutral pixels skip the matrix (it maps neutrals to themselves exactly
    // in maths; this keeps them exactly neutral in floating point too).
    float3 w;
    if (p_R == p_G && p_G == p_B) {
        float v = glx_di_to_lin(p_R);
        w = make_float3(v, v, v);
    } else {
        w = glx_dwg_to_work(glx_di_to_lin(p_R), glx_di_to_lin(p_G), glx_di_to_lin(p_B));
    }

    if (preOn) w = glx_corrections(w, ev, temp, tint);
    w = glx_process_linear(w.x, w.y, w.z, k, p, look, lookOn, adj, adjColor, adjTone);

    // linear working -> linear DWG -> DaVinci Intermediate (same neutral path;
    // this keeps monochrome results exactly R = G = B).
    float3 o = (w.x == w.y && w.y == w.z) ? w : glx_work_to_dwg(w.x, w.y, w.z);
    float oR = glx_lin_to_di(o.x);
    float oG = glx_lin_to_di(o.y);
    float oB = glx_lin_to_di(o.z);

    // Global Intensity: mix in DaVinci Intermediate, where equal steps are
    // roughly equal perceptual steps, so the fade from 0% to 100% is even.
    // At 100% the processed result is returned directly (bit-exact look).
    float t = k.intensity;
    if (t >= 1.0f) return make_float3(oR, oG, oB);
    return make_float3(p_R + (oR - p_R) * t,
                       p_G + (oG - p_G) * t,
                       p_B + (oB - p_B) * t);
}
