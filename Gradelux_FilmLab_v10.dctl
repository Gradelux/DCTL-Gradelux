    } else if (id == GLX_LOOK_HALCYON_400) {
        // HALCYON: cool, modern cinematic colour. A steel-blue identity:
        // blue shadows and cool midtones (not Verdant's cyan-green), with
        // clean, neutral highlights on a long bright shoulder. Crisp
        // contrast (steep mids, firm toe) with a gentle per-layer response
        // so reds stay controlled. Blues and cyans carry the colour (cyans
        // turned toward blue, blues toward cyan: one steel axis); greens are
        // muted and pushed cool toward teal; yellows and oranges are
        // restrained. Skin keeps most of its own colour (high skin
        // protection), so it reads natural, not blue.
        s = glx_set_render(s, -0.14f, 2.5f, 0.85f);
        s = glx_set_tone (s, 1.50f, 3.0f, 4.0f, -0.45f, 0.12f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.10f, -0.03f, 0.15f,  -0.08f, -0.015f, 0.10f,  0.0f, 0.0f, 0.0f);
        s = glx_set_color(s, 1.0f, 0.30f, 0.25f, 0.04f, 0.35f, 0.10f, 0.10f);
        s = glx_set_hue  (s, 0.0f, 0.0f, 20.0f, 4.0f, -4.0f, 0.0f);
        s = glx_set_hsat (s, 0.75f, 0.60f, 0.55f, 1.10f, 1.25f, 0.85f);
        s = glx_set_hden (s, -0.05f, 0.0f, -0.08f, -0.10f, -0.15f, -0.05f);
        s = glx_set_dye  (s, -0.02f, -0.01f, -0.02f, -0.04f, -0.03f, -0.04f, 0.7f);
    } else if (id == GLX_LOOK_ARGENT_200) {
        // ARGENT: dramatic bleach-bypass-inspired colour (Version 9 redesign).
        // The most contrast-heavy stock of the collection: the steepest
        // midtone slope, deep and substantial blacks (black density plus a
        // firm toe) and bright, defined highlights on a later, smooth shoulder,
        // so the image has strong tonal separation and photographic depth.
        // Colour is restrained but not washed out: about half the source
        // colourfulness, carried by dye density (darker, denser colour), with
        // warm hues held back more than cool ones and steel-cyan blues for a
        // metallic, silver-inspired rendering. Contrast rises in luminance:
        // only a light per-layer response.
        s = glx_set_render(s, -0.30f, 2.5f, 0.60f);
        s = glx_set_tone (s, 1.75f, 3.0f, 3.4f, -0.55f, 0.10f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.04f, 0.0f, 0.04f,  -0.02f, 0.0f, 0.02f,  -0.02f, 0.0f, 0.015f);
        s = glx_set_color(s, 0.66f, 0.45f, 0.35f, 0.0f, 0.45f, 0.05f, 0.25f);
        s = glx_set_hue  (s, 0.0f, -4.0f, 6.0f, 4.0f, -2.0f, 0.0f);
        s = glx_set_hsat (s, 0.85f, 0.75f, 0.88f, 1.12f, 1.08f, 0.88f);
        s = glx_set_hden (s, -0.15f, -0.10f, -0.15f, -0.10f, -0.15f, -0.10f);
    } else if (id == GLX_LOOK_NOCTURNE_800) {
        // NOCTURNE: moody night film (Version 9 redesign). Anchored at
        // middle grey (no overall underexposure); its night character comes
        // from pronounced contrast and colour. The toe is open: rich blacks
        // with visible lower midtones, much less crush than before. Ambient
        // shadows and lower mids are cool blue and heavily desaturated
        // (atmospheric), greens and cyans turn teal and quiet, neon is held
        // down; above about +1.6 stops the colour turns warm amber, so
        // practical lights glow amber / red against the blue night (the red
        // layer shoulders later). Skin keeps most of its own colour. Where
        // Midnight is a cyan-blue stylised night, Nocturne is a blue-black
        // ambience lit by warm practicals.
        s = glx_set_render(s, -0.15f, 2.5f, 0.75f);
        s = glx_set_tone (s, 1.52f, 3.0f, 3.2f, -0.35f, 0.25f);
        s = glx_set_chan (s, 0.01f, 0.0f, -0.01f,  -0.02f, 0.0f, 0.01f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.12f, -0.04f, 0.16f,  0.0f, 0.0f, 0.0f,  0.11f, 0.04f, 0.0f);
        s = glx_set_color(s, 0.88f, 0.25f, 0.65f, 0.02f, 0.40f, 0.10f, 0.10f);
        s = glx_set_hue  (s, 2.0f, -10.0f, 10.0f, 6.0f, -4.0f, -8.0f);
        s = glx_set_hsat (s, 1.25f, 1.15f, 0.45f, 0.50f, 0.68f, 0.65f);
        s = glx_set_hden (s, -0.20f, -0.08f, -0.28f, -0.22f, -0.22f, -0.12f);
