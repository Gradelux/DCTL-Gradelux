        // Cyans are the saturated, lightened (icy) colour; blues turn toward
        // cyan; greens are pushed cyan and held quiet; warm colours are
        // strongly restrained.
        s = glx_set_render(s, -0.15f, 2.5f, 0.85f);
        s = glx_set_tone (s, 1.38f, 3.2f, 4.0f, -0.40f, 0.20f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.18f, 0.06f, 0.06f,  -0.12f, 0.03f, 0.04f,  -0.05f, 0.01f, 0.03f);
        s = glx_set_color(s, 0.92f, 0.40f, 0.25f, 0.0f, 0.30f, 0.10f, 0.05f);
        s = glx_set_hue  (s, -2.0f, 4.0f, 14.0f, 0.0f, -7.0f, 0.0f);
        s = glx_set_hsat (s, 0.65f, 0.60f, 0.65f, 1.30f, 1.10f, 0.70f);
        s = glx_set_hden (s, -0.05f, 0.0f, -0.05f, 0.08f, 0.0f, -0.05f);
        s = glx_set_dye  (s, -0.02f, -0.01f, -0.02f, -0.04f, -0.03f, -0.03f, 0.7f);
    } else if (id == GLX_LOOK_TERRACOTTA) {
        // TERRACOTTA: warm desert film. Burnt-orange and earthy red identity:
        // reds and yellows both turn orange with heavy dye density, warm red-
        // orange midtones, golden highlights, deep warm-brown shadows (dense
        // blacks), rich contrast. Greens turn muted olive, blues are quiet.
        // Skin takes part of the warmth (sunlit). Distinct from Solara (golden,
        // lifted blacks, bright yellows) and Verona (yellow-green signature).
        s = glx_set_render(s, -0.30f, 2.5f, 0.40f);
        s = glx_set_tone (s, 1.40f, 3.0f, 3.4f, -0.45f, 0.30f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  0.06f, 0.0f, -0.07f,  0.10f, -0.01f, -0.09f,  0.08f, 0.05f, -0.05f);
        s = glx_set_color(s, 1.12f, 0.30f, 0.20f, 0.06f, 0.50f, 0.10f, 0.15f);
        s = glx_set_hue  (s, 10.0f, -16.0f, -16.0f, -4.0f, -6.0f, 0.0f);
        s = glx_set_hsat (s, 1.20f, 1.0f, 0.68f, 0.70f, 0.65f, 0.90f);
        s = glx_set_hden (s, -0.25f, -0.15f, -0.10f, -0.05f, -0.10f, -0.10f);
        s = glx_set_dye  (s, -0.04f, -0.02f, -0.03f, -0.02f, -0.02f, -0.04f, 0.7f);
    } else if (id == GLX_LOOK_VELOUR) {
        // VELOUR: rich cinematic negative. Deep, luxurious colour DENSITY at
        // restrained saturation: crimson reds, emerald greens and cobalt
        // blues rendered dark and dense, strong midtone separation, deep
        // detailed blacks with a velvet (plum) shadow tone, smooth luminous
        // neutral highlights on a long shoulder. Distinct from Chroma (raw
        // saturation, slide-like curve).
        s = glx_set_render(s, -0.35f, 2.5f, 0.85f);
        s = glx_set_tone (s, 1.42f, 3.4f, 4.0f, -0.45f, 0.30f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  0.05f, -0.06f, 0.03f,  0.03f, -0.04f, 0.01f,  0.0f, 0.0f, 0.0f);
        s = glx_set_color(s, 0.95f, 0.30f, 0.25f, 0.06f, 0.90f, 0.25f, 0.20f);
        s = glx_set_hue  (s, -3.0f, -2.0f, 8.0f, 0.0f, -4.0f, 0.0f);
        s = glx_set_hsat (s, 1.10f, 0.95f, 1.15f, 0.95f, 1.10f, 0.90f);
        s = glx_set_hden (s, -0.40f, -0.15f, -0.40f, -0.20f, -0.40f, -0.20f);
        s = glx_set_dye  (s, -0.04f, -0.02f, -0.04f, -0.03f, -0.02f, -0.04f, 0.8f);
    }
    return s;
}

// -----------------------------------------------------------------------------
//  INTENSITY SCALING (Film Strength, internally Creative Intensity): move
//  every parameter from neutral (t = 0) through the reference
//  (t = 1) to twice the deviation (t = 2), then bound each one to a range
//  where the operators are proven monotonic and stable.
// -----------------------------------------------------------------------------
__DEVICE__ float glx_lerp1(float base, float v, float t) { return base + (v - base) * t; }

__DEVICE__ GlxLook glx_look_scale(GlxLook s, float t)
{
    s.contrast = _clampf(glx_lerp1(1.0f, s.contrast, t), 0.5f, 2.2f);
    s.hiInv    = _clampf(s.hiInv * t, 0.0f, FILM_HI_INV_MAX);
    s.toe      = _clampf(s.toe * t, -1.0f, 0.9f);          // |toe| * ln2 < 1: monotonic
    s.shoulder = _fmaxf(s.shoulder * t, 0.0f);
    s.kappa    = _clampf(s.kappa * t, 0.0f, 0.9f);
    s.blackDensity = _clampf(s.blackDensity * t, -1.0f, 0.5f);
    s.cgR *= t; s.cgG *= t; s.cgB *= t;
    s.ciR *= t; s.ciG *= t; s.ciB *= t;
    s.gR *= t;  s.gG *= t;  s.gB *= t;
    s.shR *= t; s.shG *= t; s.shB *= t;
    s.mdR *= t; s.mdG *= t; s.mdB *= t;
    s.hlR *= t; s.hlG *= t; s.hlB *= t;
    s.sat     = _fmaxf(glx_lerp1(1.0f, s.sat, t), 0.0f);
    s.hlDesat = _clampf(s.hlDesat * t, 0.0f, 0.95f);
    s.shDesat = _clampf(s.shDesat * t, -0.5f, 0.95f);   // < 0: shadows gain chroma (reversal film)
    s.midSat  = _clampf(s.midSat * t, -0.9f, 1.0f);
    s.density *= t;
    s.sep     *= t;
    s.subSat  = _clampf(s.subSat * t, -1.0f, 1.0f);
    s.fR = _clampf(glx_lerp1(1.0f, s.fR, t), 0.5f, 1.5f);
    s.fG = _clampf(glx_lerp1(1.0f, s.fG, t), 0.5f, 1.5f);
    s.fB = _clampf(glx_lerp1(1.0f, s.fB, t), 0.5f, 1.5f);
    s.fade = s.fade * t;
    s.hR *= t; s.hY *= t; s.hG *= t; s.hC *= t; s.hB *= t; s.hM *= t;
    s.sR = _fmaxf(glx_lerp1(1.0f, s.sR, t), 0.2f); s.sY = _fmaxf(glx_lerp1(1.0f, s.sY, t), 0.2f);
    s.sG = _fmaxf(glx_lerp1(1.0f, s.sG, t), 0.2f); s.sC = _fmaxf(glx_lerp1(1.0f, s.sC, t), 0.2f);
    s.sB = _fmaxf(glx_lerp1(1.0f, s.sB, t), 0.2f); s.sM = _fmaxf(glx_lerp1(1.0f, s.sM, t), 0.2f);
    s.dR *= t; s.dY *= t; s.dG *= t; s.dC *= t; s.dB *= t; s.dM *= t;
    s.sRG = _clampf(s.sRG * t, 0.0f, 0.3f); s.sRB = _clampf(s.sRB * t, 0.0f, 0.3f);
    s.sGR = _clampf(s.sGR * t, 0.0f, 0.3f); s.sGB = _clampf(s.sGB * t, 0.0f, 0.3f);
    s.sBR = _clampf(s.sBR * t, 0.0f, 0.3f); s.sBG = _clampf(s.sBG * t, 0.0f, 0.3f);
    s.kRG = _clampf(s.kRG * t, -0.2f, 0.2f); s.kRB = _clampf(s.kRB * t, -0.2f, 0.2f);
    s.kGR = _clampf(s.kGR * t, -0.2f, 0.2f); s.kGB = _clampf(s.kGB * t, -0.2f, 0.2f);
    s.kBR = _clampf(s.kBR * t, -0.2f, 0.2f); s.kBG = _clampf(s.kBG * t, -0.2f, 0.2f);

    // Hue map safety. The rotation varies across a zone boundary with slope
    // <= 1.5 * (difference between adjacent zones) per radian, and the skin
    // protection ramp adds <= 1.8 * |rotation near skin|. Keep that total
    // below FILM_HUE_SLOPE_MAX and give separation only the remaining
    // headroom, so  d(theta')/d(theta) > 0  everywhere: hues never fold.
    float D = _fmaxf(_fmaxf(_fabs(s.hR - s.hY), _fabs(s.hY - s.hG)),
              _fmaxf(_fmaxf(_fabs(s.hG - s.hC), _fabs(s.hC - s.hB)),
                     _fmaxf(_fabs(s.hB - s.hM), _fabs(s.hM - s.hR)))) * GLX_DEG2RAD;
    float skinRot = (_fmaxf(_fabs(s.hR), _fabs(s.hY)) + 0.25f * _fabs(s.hM)) * GLX_DEG2RAD;
    float S = 1.5f * D + 1.8f * skinRot;
    if (S > FILM_HUE_SLOPE_MAX) {
        float f = FILM_HUE_SLOPE_MAX / S;
        s.hR *= f; s.hY *= f; s.hG *= f; s.hC *= f; s.hB *= f; s.hM *= f;
        S = FILM_HUE_SLOPE_MAX;
    }
    s.sepCap = _fmaxf(0.85f - S, 0.0f);

    // Monochrome: mix weights move from luminance toward the look's mix
    // (clamped non-negative, renormalised to sum 1); colour fades out by 100%.
    if (s.isMono > 0.5f) {
        float wr = _fmaxf(glx_lerp1(WORK_YR, s.mxR, t), 0.0f);
        float wg = _fmaxf(glx_lerp1(WORK_YG, s.mxG, t), 0.0f);
        float wb = _fmaxf(glx_lerp1(WORK_YB, s.mxB, t), 0.0f);
        float sum = wr + wg + wb;
        s.mxR = wr / sum; s.mxG = wg / sum; s.mxB = wb / sum;
        s.chromaKeep = _fmaxf(1.0f - t, 0.0f);
    }
    return s;
}

// -----------------------------------------------------------------------------
//  Shared helpers
// -----------------------------------------------------------------------------

// Weight of a hue zone from c = cos(angle to zone centre). Raised cosine
// over +/-60 deg: w = (1 + cos 3d) / 2, with cos 3d = 4c^3 - 3c. Adjacent
// zones sum exactly to 1 and the weight is C1-smooth at the zone edge.
__DEVICE__ float glx_zone(float c)
{
    return (c > 0.5f) ? 0.5f * (1.0f + c * (4.0f * c * c - 3.0f)) : 0.0f;
}

// Exposure in stops relative to 18% grey, toe-limited so it stays finite.
__DEVICE__ float glx_exposure(float n)
{
    return _log2f((_fmaxf(n, 0.0f) + FILM_TOE_OFFSET) / (GLX_MID_GREY + FILM_TOE_OFFSET));
}

// MIDDLE-GREY ANCHOR (Version 9). A stock's black density is a neutral gain
// that is full strength in the deep shadows and fades smoothly (C1) to
// exactly zero at 18% grey; at and above grey it does nothing. So a stock
// can print its blacks denser (or lifted) without moving middle grey or the
// highlights: every primary look maps 18% grey to 18% grey at neutral
// settings, and its contrast, toe, shoulder and colour are unchanged.
// Monotonic: d(e + D w(e))/de = 1 + D w'(e) >= 1 - 0.375 |D| > 0 for the
// allowed |D| <= 1 (w' <= 0 and |w'| <= 1.5 / FILM_BLACK_DENSITY_STOPS).
#define FILM_BLACK_DENSITY_STOPS 4.0f
__DEVICE__ float glx_black_weight(float n)
{
    return glx_smooth(0.0f, -FILM_BLACK_DENSITY_STOPS, glx_exposure(n));
}

// Hue-zone weighted per-hue density (stops) for a colour, scaled by its
// chroma weight. Used by the monochrome filter model.
__DEVICE__ float glx_hue_density(float r, float g, float b, GlxLook s, GlxProfile p)
{
    float oa  = (2.0f * r - g - b) * GLX_INV_SQRT6;
    float ob  = (g - b) * GLX_INV_SQRT2;
    float len = _sqrtf(oa * oa + ob * ob);
    float mx  = glx_max3(r, g, b);
    if (mx <= 0.0f || len <= GLX_EPS * mx) return 0.0f;
    float ua = oa / len, ub = ob / len;
    float wR = glx_zone( 0.9961946981f * ua + 0.0871557427f * ub);
    float wY = glx_zone( 0.4226182617f * ua + 0.9063077870f * ub);
    float wG = glx_zone(-0.5735764364f * ua + 0.8191520443f * ub);
    float wC = glx_zone(-0.9961946981f * ua - 0.0871557427f * ub);
    float wB = glx_zone(-0.4226182617f * ua - 0.9063077870f * ub);
    float wM = glx_zone( 0.5735764364f * ua - 0.8191520443f * ub);
    float sat  = _clampf((mx - glx_min3(r, g, b)) / (mx + p.densityToe), 0.0f, 1.0f);
    float wSat = sat * sat * (3.0f - 2.0f * sat);
    return (wR * s.dR + wY * s.dY + wG * s.dG + wC * s.dC + wB * s.dB + wM * s.dM) * wSat;
}

// -----------------------------------------------------------------------------
//  COLOUR RESPONSE  (also used, with a neutral look, by the Film Color
//  Density / Film Color Separation adjustment pass)
// -----------------------------------------------------------------------------
__DEVICE__ float3 glx_film_color(float r, float g, float b, GlxLook s, float sepF, GlxProfile p)
{
    // Neutral component + chroma vector in the orthonormal opponent plane.
    float m  = (r + g + b) * (1.0f / 3.0f);
    float oa = (2.0f * r - g - b) * GLX_INV_SQRT6;
    float ob = (g - b) * GLX_INV_SQRT2;
    float len = _sqrtf(oa * oa + ob * ob);
    if (len <= GLX_EPS * (_fabs(m) + GLX_EPS)) return make_float3(r, g, b);   // neutral
    float ua = oa / len, ub = ob / len;                                       // hue direction

    // Hue zones (centres R 5, Y 65, G 125, C 185, B 245, M 305 deg; the
    // red centre sits near the hue of Rec.709 red).
    float wR = glx_zone( 0.9961946981f * ua + 0.0871557427f * ub);
    float wY = glx_zone( 0.4226182617f * ua + 0.9063077870f * ub);
    float wG = glx_zone(-0.5735764364f * ua + 0.8191520443f * ub);
    float wC = glx_zone(-0.9961946981f * ua - 0.0871557427f * ub);
    float wB = glx_zone(-0.4226182617f * ua - 0.9063077870f * ub);
    float wM = glx_zone( 0.5735764364f * ua - 0.8191520443f * ub);
    float hueDeg = wR * s.hR + wY * s.hY + wG * s.hG + wC * s.hC + wB * s.hB + wM * s.hM;
    float satHue = wR * s.sR + wY * s.sY + wG * s.sG + wC * s.sC + wB * s.sB + wM * s.sM;
    float denHue = wR * s.dR + wY * s.dY + wG * s.dG + wC * s.dC + wB * s.dB + wM * s.dM;

    // Chroma amount (same measure as Film Density) and skin masks.
    float mx  = glx_max3(r, g, b);
    float mn  = glx_min3(r, g, b);
    float sat = (mx > 0.0f) ? _clampf((mx - mn) / (mx + p.densityToe), 0.0f, 1.0f) : 0.0f;
    float wSat   = sat * sat * (3.0f - 2.0f * sat);
    float chromaFade = glx_smooth(0.0f, 0.15f, sat);   // leave near-neutrals' hue alone
    float skin = glx_smooth(p.skinCosOuter, p.skinCosInner, ua * p.skinHueA + ub * p.skinHueB);
    float skinColor = 1.0f - FILM_SKIN_COLOR_PROTECT * skin;
    float skinRotW  = glx_smooth(FILM_SKINROT_COS_OUT, FILM_SKINROT_COS_IN, ua * p.skinHueA + ub * p.skinHueB);

    // Exposure zones from the brightness norm (shadow / mid / highlight).
    float e  = glx_exposure(glx_tone_norm(r, g, b));
    float wh = glx_smooth(0.0f,  s.zoneStops, e);
    float ws = glx_smooth(0.0f, -s.zoneStops, e);
    float wm = (1.0f - wh) * (1.0f - ws);

    // ---- Hue rotation: per-hue rotation + hue clustering ------------------------
    // Separation warps hue angle  theta' = theta - k sin(6 (theta - theta0)) / 6
    // with theta0 on the skin hue: k > 0 draws hues toward six axes (skin,
    // and 60-deg steps from it) so colour families read as more distinct;
    // k < 0 spreads them for a blended palette. Its slope is 1 - k cos(..),
    // and k is capped (s.sepCap, derived in glx_look_scale) so the total hue
    // map, including the rotation, stays strictly monotonic.
    float kMax = s.sepCap;
    float k = _clampf(s.sep + sepF * FILM_SEP_RANGE, -kMax * 0.55f, kMax);
    float ca = ua * p.skinHueA + ub * p.skinHueB;          // cos(theta - theta0)
    float sa = ub * p.skinHueA - ua * p.skinHueB;          // sin(theta - theta0)
    float c2 = ca * ca - sa * sa, s2 = 2.0f * ca * sa;      // angle x2
    float c3 = c2 * ca - s2 * sa, s3 = s2 * ca + c2 * sa;   // angle x3
    float sin6 = 2.0f * s3 * c3;                            // sin(6 (theta - theta0))
    float sepRot = -k * sin6 * (1.0f / 6.0f);
    if (k < 0.0f) sepRot *= 1.0f - p.skinProtect * skin;    // never scatter skin

    float rot = (hueDeg * GLX_DEG2RAD * (1.0f - FILM_SKIN_HUE_PROTECT * skinRotW) + sepRot) * chromaFade;
    float cr = _cosf(rot), sr = _sinf(rot);
    float na = oa * cr - ob * sr;
    float nb = oa * sr + ob * cr;

    // ---- Saturation: overall x per-hue x exposure-dependent ------------------
    float sigma = s.sat * (1.0f + (satHue - 1.0f) * skinColor)
                * _fmaxf(1.0f - s.hlDesat * wh - s.shDesat * ws, 0.0f)
                * _fmaxf(1.0f + s.midSat * wm, 0.0f)
                * (1.0f + sepF * FILM_SEP_SAT);

    // Channel offsets from the neutral component.
    float dr = 2.0f * GLX_INV_SQRT6 * na;
    float dg = -GLX_INV_SQRT6 * na + GLX_INV_SQRT2 * nb;
    float db = -GLX_INV_SQRT6 * na - GLX_INV_SQRT2 * nb;

    // Soft gamut limit. Along this colour's (rotated) chroma direction the
    // lowest channel reaches 0 at chroma scale L = m / -min(d). With
    // x = sigma / L as the fraction of the way to that edge, x passes
    // unchanged up to a knee and then approaches 1 asymptotically
    // (1 - 2^-x curve), so rotated or saturated colours never cross into
    // negative values and never clip hard. The knee is never placed below
    // the input colour's own position, so a colour is only ever held where
    // it was (this keeps 0% -> 1% intensity continuous); colours that were
    // already outside the gamut are not pushed further out.
    if (m > 0.0f) {
        float dmin = glx_min3(dr, dg, db);
        if (dmin < 0.0f) {
            float L    = m / -dmin;
            float x0   = _fmaxf(-glx_min3(r - m, g - m, b - m) / m, 0.0f);
            float knee = _fmaxf(s.gamutKnee, x0);
            float x    = sigma / L;
            if (x > knee) {
                float span = 1.0f - knee;
                x = (span > 1.0e-4f)
                  ? knee + span * (1.0f - _exp2f(-(x - knee) / span * GLX_LOG2E))
                  : knee;
            }
            sigma = x * L;
        }
    }
    float r1 = m + sigma * dr;
    float g1 = m + sigma * dg;
    float b1 = m + sigma * db;

    // ---- Colour density: per-hue density plus saturation-driven density.
    // One gain on all channels, so hue and saturation are unaffected.
    float wSkin = 1.0f - p.skinProtect * skin;
    float dStops = (denHue * skinColor - s.density * p.densityStops * wSkin) * wSat;
    float gain = _exp2f(dStops);
    return make_float3(r1 * gain, g1 * gain, b1 * gain);
}

// -----------------------------------------------------------------------------
//  CHARACTERISTIC CURVE
// -----------------------------------------------------------------------------
// Shift in stops for linear value x, with channel gamma multiplier cg and
// channel shoulder offset ci (|x| is used, so negative values get a finite,
// sign-preserving gain). With e = stops from 18% grey (toe-limited log):
//   e >= 0 : e' = tanh(gamma e / U) * U         sigmoid shoulder toward U stops
//            (e' = gamma e when there is no shoulder)
//   e <  0 : e' = e + (gamma - 1) W tanh(e / W) contrast that eases back to
//            slope 1: shadows sit up to (gamma-1)W stops deeper (black
//            density) without being crushed or lifted
//   then the black-density toe term and the optional rational shoulder.
// Both branches have slope gamma and zero curvature at grey (C2 join), the
// curve is strictly increasing for every allowed setting, and it is applied
// as a gain, so 0 stays 0.
__DEVICE__ float glx_look_curve(float x, GlxLook s, float cg, float ci)
{
    x = _fabs(x);
    float e   = _log2f((x + FILM_TOE_OFFSET) / (GLX_MID_GREY + FILM_TOE_OFFSET));
    float gam = _clampf(s.contrast * (1.0f + cg), 0.3f, 3.0f);
    float inv = _clampf(s.hiInv + ci, 0.0f, FILM_HI_INV_MAX);
    float e1;
    if (e >= 0.0f)
        e1 = (inv > 1.0e-6f) ? glx_tanh(gam * e * inv) / inv : gam * e;
    else
        e1 = e + (gam - 1.0f) * s.width * glx_tanh(e / s.width);
    float dC = e1 - e;
    float x1 = x * _exp2f(dC);

    float u  = x1 / FILM_TOE_KNEE;
    float u2 = u * u;
    float ug = GLX_MID_GREY / FILM_TOE_KNEE;
    float ug2 = ug * ug;
    float dT = s.toe * (1.0f / (1.0f + u2 * u2) - 1.0f / (1.0f + ug2 * ug2));
    float x2 = x1 * _exp2f(dT);

    float z  = _log2f(_fmaxf(x2, 1.0e-10f) / GLX_MID_GREY) - s.knee;
    float dS = (z > 0.0f) ? -(s.shoulder * z * z) / (1.0f + s.shoulder * z) : 0.0f;
    return dC + dT + dS;
}

// -----------------------------------------------------------------------------
//  TONE STAGE  (also used, with a neutral look, by the Highlight Warmth /
//  Shadow Tone adjustment pass)
// -----------------------------------------------------------------------------
//  1. Zone colour (looks' shadow / mid / highlight colour and crossover, and
//     the user's Warmth / Shadow Tone): luminance-normalised gains driven by
//     the exposure of the norm. Applied BEFORE the characteristic curve, so
//     the curve compresses colour along with tone in the toe and shoulder
//     and every channel stays monotonic even with a very strong shoulder.
//  2. Characteristic curves. For channel c, with N_c = the norm's curve
//     using channel c's settings, C_c = channel c's own curve, B = the
//     norm's base curve:
//        v_c = N_c + kappa (C_c - N_c)
//     (Version 10 removed the neutral-locked print variant of this stage.)
__DEVICE__ float3 glx_film_tone_ex(float r, float g, float b, GlxLook s, float warmth, float shadowTone, GlxProfile p,
                                   int doZone, int doCurve)
{
    // A grey pixel's norm is its own value (exactly; the luminance weights'
    // float sum is not exactly 1), so neutral-locked curves stay exact.
    float n  = (r == g && g == b) ? r : glx_tone_norm(r, g, b);

    // Skin weight, faded in with chroma so the hue direction of near-neutral
    // noise can never modulate anything.
    float oa  = (2.0f * r - g - b) * GLX_INV_SQRT6;
    float ob  = (g - b) * GLX_INV_SQRT2;
    float len = _sqrtf(oa * oa + ob * ob);
    float mx  = glx_max3(r, g, b);
    float sat = (mx > 0.0f) ? _clampf((mx - glx_min3(r, g, b)) / (mx + p.densityToe), 0.0f, 1.0f) : 0.0f;
    // Wide, soft skin window (as for hue rotation) so the protections vary
    // gently with hue: smooth gradients and accurate 3D LUT sampling.
    float cosH = (oa * p.skinHueA + ob * p.skinHueB) / (len + GLX_EPS);
    float skin = glx_smooth(FILM_SKINROT_COS_OUT, FILM_SKINROT_COS_IN, cosH) * glx_smooth(0.0f, 0.15f, sat);
    float tintK = 1.0f - s.skinTint * skin;
    // Per-channel curves skew hues toward the strongest channel; on skin the
    // per-channel share is reduced so skin keeps its natural hue.
    float kap = s.kappa * (1.0f - FILM_SKIN_KAPPA_PROTECT * skin);

    // ---- 1. Zone colour ------------------------------------------------------
    float e  = glx_exposure(n);
    float wh = glx_smooth(0.0f,  s.zoneStops, e);
    float ws = glx_smooth(0.0f, -s.zoneStops, e);
    float wm = (1.0f - wh) * (1.0f - ws);
    float tw = s.width * glx_tanh(e / s.width);

    // Film Highlight Warmth: + amber, - cool blue (stops, before normalising).
    float hw = warmth * FILM_WARMTH_STOPS * wh;
    // Film Shadow Tone: + warm amber, - teal (continuous through 0).
    float st = shadowTone * FILM_SHADOW_STOPS * ws;
    float stR = (st > 0.0f) ?  0.70f * st : 0.80f * st;
    float stG = (st > 0.0f) ?  0.20f * st : -0.25f * st;
    float stB = (st > 0.0f) ? -0.90f * st : -0.55f * st;

    // Look tints are reduced on skin; the user's Warmth / Shadow Tone are not.
    float tR = (s.gR * tw + s.shR * ws + s.mdR * wm + s.hlR * wh) * tintK + 0.80f * hw + stR;
    float tG = (s.gG * tw + s.shG * ws + s.mdG * wm + s.hlG * wh) * tintK + 0.10f * hw + stG;
    float tB = (s.gB * tw + s.shB * ws + s.mdB * wm + s.hlB * wh) * tintK - 0.90f * hw + stB;
    // Remove the luminance component (a uniform log offset): the tint's hue
    // is unchanged but it no longer brightens or darkens the image.
    float tY = WORK_YR * tR + WORK_YG * tG + WORK_YB * tB;
    if (doZone && (tR != 0.0f || tG != 0.0f || tB != 0.0f)) {
        r *= _exp2f(tR - tY); g *= _exp2f(tG - tY); b *= _exp2f(tB - tY);
        n = glx_tone_norm(r, g, b);
    }
    if (!doCurve) return make_float3(r, g, b);

    // ---- 2. Characteristic curves --------------------------------------------
    // Black density: one neutral gain, full in the deep shadows and exactly
    // 1 at 18% grey and above (middle-grey anchor, see glx_black_weight).
    float pd = _exp2f(s.blackDensity * glx_black_weight(n));
    r *= pd; g *= pd; b *= pd; n *= pd;
    float B  = glx_look_curve(n, s, 0.0f, 0.0f);
    int chan = (s.cgR != 0.0f) || (s.cgG != 0.0f) || (s.cgB != 0.0f)
            || (s.ciR != 0.0f) || (s.ciG != 0.0f) || (s.ciB != 0.0f);
    float NR = chan ? glx_look_curve(n, s, s.cgR, s.ciR) : B;
    float NG = chan ? glx_look_curve(n, s, s.cgG, s.ciG) : B;
    float NB = chan ? glx_look_curve(n, s, s.cgB, s.ciB) : B;
    float vR = NR;
    float vG = NG;
    float vB = NB;
    if (s.kappa > 0.0f) {
        vR += kap * (glx_look_curve(r, s, s.cgR, s.ciR) - NR);
        vG += kap * (glx_look_curve(g, s, s.cgG, s.ciG) - NG);
        vB += kap * (glx_look_curve(b, s, s.cgB, s.ciB) - NB);
    }
    return make_float3(r * _exp2f(vR), g * _exp2f(vG), b * _exp2f(vB));
}

__DEVICE__ float3 glx_film_tone(float r, float g, float b, GlxLook s, float warmth, float shadowTone, GlxProfile p)
{
    return glx_film_tone_ex(r, g, b, s, warmth, shadowTone, p, 1, 1);
}

// -----------------------------------------------------------------------------
//  DYE COUPLING  (density domain)
// -----------------------------------------------------------------------------
//  Density proxy: d = log2((x + t) / (0.18 + t)) for x >= 0, continued along
//  its tangent below 0 (C1, invertible, finite for negatives). The toe
//  offset t keeps near-black noise from being amplified.
//      d_c' = d_c + sum_{j != c} k_cj (d_j - d_c)
//  Written in differences, so neutrals (all d equal) are untouched exactly.
//  Then the anchor removes that share of any rise of the strongest channel
//  (a uniform shift = one gain): added colour comes from density, not light.
//  The density change is applied as a gain, x_c' = x_c * 2^(d_c' - d_c),
//  so black stays black, positive values stay positive (in-gamut colours
//  never go negative) and the toe offset gently limits the effect near black.
//  Negative (out-of-gamut) channels count as zero density, and the gain is
//  bounded to +/-FILM_DYE_MAX_STOPS, so imaginary colours far outside the
//  spectral locus can never produce extreme values.
#define FILM_DYE_MAX_STOPS 3.0f

__DEVICE__ float glx_dlog(float x)
{
    return _log2f((_fmaxf(x, 0.0f) + FILM_DYE_OFFSET) / (GLX_MID_GREY + FILM_DYE_OFFSET));
}

__DEVICE__ float glx_dye_gain(float dNew, float dOld)
{
    return _exp2f(_clampf(dNew - dOld, -FILM_DYE_MAX_STOPS, FILM_DYE_MAX_STOPS));
}

__DEVICE__ float3 glx_dye(float r, float g, float b, GlxLook s)
{
    if (r == g && g == b) return make_float3(r, g, b);
    float dr = glx_dlog(r), dg = glx_dlog(g), db = glx_dlog(b);
    float nr = dr + s.kRG * (dg - dr) + s.kRB * (db - dr);
    float ng = dg + s.kGR * (dr - dg) + s.kGB * (db - dg);
    float nb = db + s.kBR * (dr - db) + s.kBG * (dg - db);
    float rise = glx_max3(nr, ng, nb) - glx_max3(dr, dg, db);
    float shift = -s.dyeAnchor * _fmaxf(rise, 0.0f);
    return make_float3(r * glx_dye_gain(nr + shift, dr), g * glx_dye_gain(ng + shift, dg), b * glx_dye_gain(nb + shift, db));
}

__DEVICE__ int glx_has_dye(GlxLook s)
{
    return (s.kRG != 0.0f) || (s.kRB != 0.0f) || (s.kGR != 0.0f)
        || (s.kGB != 0.0f) || (s.kBR != 0.0f) || (s.kBG != 0.0f);
}

// -----------------------------------------------------------------------------
//  FADE: black-level lift  x' = x + L K / (K + x)
// -----------------------------------------------------------------------------
//  Lifts black to L and fades out smoothly (L K / x for bright values, ~0.1 L
//  at 18% grey). Slope 1 - L/K > 0 at black (L <= 0.6 K), increasing above,
//  so it is strictly monotonic; below 0 it continues along its tangent line
//  (C1-continuous), so negative values stay ordered and finite.
__DEVICE__ float glx_fade_ch(float x, float L)
{
    L = _fminf(L, FILM_FADE_MAX);
    return (x >= 0.0f) ? x + L * FILM_FADE_K / (FILM_FADE_K + x)
                       : x * (1.0f - L / FILM_FADE_K) + L;
}

// =============================================================================
//  FILM LOOK ENGINE  ("negative" / film stock stage)
// =============================================================================

// SPECTRAL SENSITIVITY OVERLAP. A film's three layers do not see cleanly
// separated red, green and blue: their spectral sensitivities overlap, and
// how much they overlap is a large part of a stock's colour signature. This
// is modelled in linear light (where light adds) as
//     c' = c + sum_{j != c} s_cj (j - c),      s_cj >= 0, row sums <= 0.3
// Written in differences, so neutrals are untouched exactly. Each output is
// a convex mix of the inputs, so in-range colours stay in range and never go
// negative. On the chroma plane it is an invertible, orientation-preserving
// linear map, so hue order is preserved. Overlap softens and blends colours
// in a hue-specific way; the stock's dye masking (glx_dye) then restores
// purity through density, as in real film.
__DEVICE__ int glx_has_sens(GlxLook s)
{
    return (s.sRG != 0.0f) || (s.sRB != 0.0f) || (s.sGR != 0.0f)
        || (s.sGB != 0.0f) || (s.sBR != 0.0f) || (s.sBG != 0.0f);
}

// Skin tones keep FILM_SKIN_SENS_PROTECT of their original rendering (wide,
// soft hue window faded in with chroma), so overlap never shifts complexions.
#define FILM_SKIN_SENS_PROTECT 0.6f

__DEVICE__ float3 glx_sensitivity(float r, float g, float b, GlxLook s, GlxProfile p)
{
    float oa  = (2.0f * r - g - b) * GLX_INV_SQRT6;
    float ob  = (g - b) * GLX_INV_SQRT2;
    float len = _sqrtf(oa * oa + ob * ob);
    float mx  = glx_max3(r, g, b);
    float sat = (mx > 0.0f) ? _clampf((mx - glx_min3(r, g, b)) / (mx + p.densityToe), 0.0f, 1.0f) : 0.0f;
    float cosH = (oa * p.skinHueA + ob * p.skinHueB) / (len + GLX_EPS);
    float skin = glx_smooth(FILM_SKINROT_COS_OUT, FILM_SKINROT_COS_IN, cosH) * glx_smooth(0.0f, 0.15f, sat);
    float k = 1.0f - FILM_SKIN_SENS_PROTECT * skin;
    return make_float3(r + k * (s.sRG * (g - r) + s.sRB * (b - r)),
                       g + k * (s.sGR * (r - g) + s.sGB * (b - g)),
                       b + k * (s.sBR * (r - b) + s.sBG * (g - b)));
}

// A silver image cannot hold negative light. Out-of-gamut inputs (negative
// channels) can give a negative mix, so the mix passes through a smooth
// floor: unchanged at and above 0, easing below 0 toward -FLOOR (C1 at 0,
// strictly increasing). Real colours are unaffected.
#define FILM_MONO_FLOOR 0.004f

__DEVICE__ float glx_soft_floor(float y)
{
    return (y >= 0.0f) ? y : -FILM_MONO_FLOOR * (1.0f - _exp2f(y / FILM_MONO_FLOOR * GLX_LOG2E));
}

__DEVICE__ float3 glx_look_mono(float r, float g, float b, GlxLook s, GlxProfile p)
{
    // Spectral-style sensitivity, then hue-selective filter density. The
    // floor fades in with the colour -> mono transition (1 - chromaKeep), so
    // low Creative Intensity stays continuous with the untouched image.
    float yr = s.mxR * r + s.mxG * g + s.mxB * b;
    float y0 = yr + (glx_soft_floor(yr) - yr) * (1.0f - s.chromaKeep);
    float y1 = y0 * _exp2f(glx_hue_density(r, g, b, s, p) + s.blackDensity * glx_black_weight(y0));   // filter density + black density
    // Characteristic curve and fade on the single silver value.
    float m  = y1 * _exp2f(glx_look_curve(y1, s, 0.0f, 0.0f));
    m = glx_fade_ch(m, s.fade);
    // Colour to mono transition (chromaKeep = 0 from 100% intensity).
    float yl = glx_luma(r, g, b);
    float k  = s.chromaKeep;
    return make_float3(m + k * (r - yl), m + k * (g - yl), m + k * (b - yl));
}

// One deterministic RGB -> RGB function per look (linear working space).
// parts: 3 = full look (product behaviour); 1 = colour stages only (overlap,
// colour response, subtractive saturation, zone colour, dye coupling);
// 2 = tone only (characteristic curve + black density + fade, applied without
// per-channel response or channel deviations, so it cannot shift colour).
__DEVICE__ float3 glx_look_apply_raw(float r, float g, float b, GlxLook s, GlxProfile p, int parts)
{
    if (s.isMono > 0.5f) {
        if (parts == 3) return glx_look_mono(r, g, b, s, p);
        GlxLook m = s;
        if (parts == 1) {        // monochrome "colour" stage: the spectral mix and filter only
            m.contrast = 1.0f; m.hiInv = 0.0f; m.toe = 0.0f; m.shoulder = 0.0f;
            m.blackDensity = 0.0f; m.fade = 0.0f;
            return glx_look_mono(r, g, b, m, p);
        }
        // monochrome "tone" stage: its curve, black density and fade, applied
        // hue-neutrally to the colour image
        m.isMono = 0.0f; m.kappa = 0.0f; m.fR = 1.0f; m.fG = 1.0f; m.fB = 1.0f;
        float3 c = glx_film_tone_ex(r, g, b, m, 0.0f, 0.0f, p, 0, 1);
        if (m.fade > 0.0f)
            c = make_float3(glx_fade_ch(c.x, m.fade), glx_fade_ch(c.y, m.fade), glx_fade_ch(c.z, m.fade));
        return c;
    }
    int doColor = (parts & 1), doTone = (parts & 2);
    float3 c = make_float3(r, g, b);
    if (doColor) {
        if (glx_has_sens(s)) c = glx_sensitivity(c.x, c.y, c.z, s, p);
        c = glx_film_color(c.x, c.y, c.z, s, 0.0f, p);
        if (s.subSat != 0.0f) c = glx_subtractive_sat(c.x, c.y, c.z, s.subSat, p);
    }
    if (doColor && doTone) {
        c = glx_film_tone(c.x, c.y, c.z, s, 0.0f, 0.0f, p);
    } else if (doColor) {
        c = glx_film_tone_ex(c.x, c.y, c.z, s, 0.0f, 0.0f, p, 1, 0);
    } else {
        GlxLook t = s;           // hue-neutral tone: no per-channel response
        t.kappa = 0.0f;
        t.cgR = 0.0f; t.cgG = 0.0f; t.cgB = 0.0f; t.ciR = 0.0f; t.ciG = 0.0f; t.ciB = 0.0f;
        c = glx_film_tone_ex(c.x, c.y, c.z, t, 0.0f, 0.0f, p, 0, 1);
    }
    if (doColor && glx_has_dye(s)) c = glx_dye(c.x, c.y, c.z, s);
    if (!doTone) return c;
    if (s.fade > 0.0f) {
        float fr = doColor ? s.fR : 1.0f, fg = doColor ? s.fG : 1.0f, fb = doColor ? s.fB : 1.0f;
        c = make_float3(glx_fade_ch(c.x, s.fade * fr),
                        glx_fade_ch(c.y, s.fade * fg),
                        glx_fade_ch(c.z, s.fade * fb));
    }
    return c;
}

// Exact middle-grey anchor (Version 9). The black density already leaves
// grey alone; what remains is second order (a stock's midtone tint and its
// per-channel response move a tinted grey's luminance by a few hundredths
// of a stop). The stock is evaluated once on a neutral 18% grey pixel and
// the result gets the single neutral gain that returns that grey to 18%
// luminance. A uniform gain: contrast, toe, shoulder, colour and neutrality
// (monochrome stays R = G = B) are untouched, and 18% grey maps to 18% grey
// for every stock, stage view and Creative Intensity.
__DEVICE__ float3 glx_look_apply_parts(float r, float g, float b, GlxLook s, GlxProfile p, int parts)
{
    float3 c  = glx_look_apply_raw(r, g, b, s, p, parts);
    float3 gr = glx_look_apply_raw(GLX_MID_GREY, GLX_MID_GREY, GLX_MID_GREY, s, p, parts);
    float  yg = WORK_YR * gr.x + WORK_YG * gr.y + WORK_YB * gr.z;
    float  k  = (yg > 0.0f) ? GLX_MID_GREY / yg : 1.0f;
    return make_float3(c.x * k, c.y * k, c.z * k);
}

__DEVICE__ float3 glx_look_apply(float r, float g, float b, GlxLook s, GlxProfile p)
{
    return glx_look_apply_parts(r, g, b, s, p, 3);
}

// =============================================================================
//  ENGINE
// =============================================================================
// Everything after the film look: film adjustments, grading controls.
// The look settings are passed in because Film Color Density scales the
// look's own density response; the look itself is NOT applied here.
__DEVICE__ float3 glx_process_post(float r, float g, float b, GlxControls k, GlxProfile p,
                                   GlxLook look, int lookOn,
                                   GlxFilmAdj adj, int adjColor, int adjTone)
{
    // ---- 3. Film adjustments --------------------------------------------------
    // Film Color Density adds (scale - 1) x the look's own density response;
    // Film Color Separation is an independent hue clustering pass. Both run
    // through the colour operator with an otherwise neutral look.
    if (adjColor) {
        GlxLook a = glx_look_clean();
        if (lookOn && look.isMono < 0.5f) {
            float cd = adj.cdScale - 1.0f;
            a.dR = look.dR * cd; a.dY = look.dY * cd; a.dG = look.dG * cd;
            a.dC = look.dC * cd; a.dB = look.dB * cd; a.dM = look.dM * cd;
            a.density = look.density * cd;
        }
        float3 c = glx_film_color(r, g, b, a, adj.sepF, p);
        r = c.x; g = c.y; b = c.z;
    }
    // Highlight Warmth / Shadow Tone: luminance-neutral zone tints.
    if (adjTone) {
        float3 c = glx_film_tone(r, g, b, glx_look_clean(), adj.warmth, adj.shadowTone, p);
        r = c.x; g = c.y; b = c.z;
    }

    // ---- 4. Version 1 grading controls ---------------------------------------
    if (k.density != 0.0f) {
        float3 c = glx_density(r, g, b, k.density, p);
        r = c.x; g = c.y; b = c.z;
    }
    if (k.subSat != 0.0f) {
        float3 c = glx_subtractive_sat(r, g, b, k.subSat, p);
        r = c.x; g = c.y; b = c.z;
    }

    // Contrast and shadow use the perceptual hybrid norm. Roll-off uses
    // max(RGB) so no single channel can escape the shoulder in saturated
    // highlights. Every step is a gain on all channels: hue is preserved.
    float n0 = glx_tone_norm(r, g, b);
    if (n0 > 0.0f && (k.contrast != 0.0f || k.shadow != 0.0f)) {
        float n = n0;
        if (k.contrast != 0.0f) n = glx_contrast(n, k.contrast, p);
        if (k.shadow   != 0.0f) n = glx_shadow(n, k.shadow, p);
        float gain = n / n0;
        r *= gain; g *= gain; b *= gain;
    }

    float m0 = glx_max3(r, g, b);
    if (m0 > 0.0f && k.rolloff > 0.0f) {
        float gain = glx_rolloff(m0, k.rolloff, p) / m0;
        r *= gain; g *= gain; b *= gain;
    }

    return make_float3(r, g, b);
}

// The complete linear chain of a film look: the look, then everything after it.
__DEVICE__ float3 glx_process_linear(float r, float g, float b, GlxControls k, GlxProfile p,
                                     GlxLook look, int lookOn,
                                     GlxFilmAdj adj, int adjColor, int adjTone)
{
    // ---- 1. Film look ("negative"), Creative Intensity already applied ------
    if (lookOn) {
        float3 c = glx_look_apply(r, g, b, look, p);
        r = c.x; g = c.y; b = c.z;
    }
    return glx_process_post(r, g, b, k, p, look, lookOn, adj, adjColor, adjTone);
}

// DaVinci Intermediate <-> linear working space, exactly as the entry point
// does it (neutral pixels skip the matrices, so they stay exactly neutral).
__DEVICE__ float3 glx_di_to_work(float r, float g, float b)
{
    if (r == g && g == b) {
        float v = glx_di_to_lin(r);
        return make_float3(v, v, v);
    }
    return glx_dwg_to_work(glx_di_to_lin(r), glx_di_to_lin(g), glx_di_to_lin(b));
}
__DEVICE__ float3 glx_work_to_di(float3 w)
{
    float3 o = (w.x == w.y && w.y == w.z) ? w : glx_work_to_dwg(w.x, w.y, w.z);
    return make_float3(glx_lin_to_di(o.x), glx_lin_to_di(o.y), glx_lin_to_di(o.z));
}


// =============================================================================
//  PRIMARY CORRECTIONS  (Version 9; scene-linear, before the film engines)
// =============================================================================
//  EXPOSURE: one gain of 2^stops on all three channels in linear light, so
//  colour ratios are kept exactly, black stays black and negative
//  (out-of-gamut) values keep their sign. 0 stops is bypassed.
//
//  TEMPERATURE / TINT: creative white balance by chromatic adaptation. The
//  target white moves along the CIE daylight locus (Temperature, in mired
//  steps: about 15700 K at -100, 4100 K at +100, measured relative to D65
//  so 0 is exactly D65) and perpendicular to it in CIE 1960 uv (Tint, up to
//  0.025 Duv). The image is adapted from D65 to that white with a von Kries
//  scaling in CAT02 cone space: one 3x3 matrix, linear, so neutrals become
//  the target white and white keeps its luminance (Y). Positive Temperature
//  renders the image warmer, positive Tint more magenta. These are creative
//  controls, not calibrated Kelvin or camera white-balance settings.
#define GLX_WB_MIRED_PER_UNIT 0.9f
#define GLX_WB_DUV_PER_UNIT   0.00025f

// CIE daylight locus chromaticity for a CCT (K), 4000 K .. 25000 K.
__DEVICE__ float2 glx_daylight_xy(float T)
{
    float t1 = 1.0e3f / T, t2 = t1 * t1, t3 = t2 * t1;
    float x = (T <= 7000.0f) ? (-4.6070f * t3 + 2.9678f * t2 + 0.09911f * t1 + 0.244063f)
                             : (-2.0064f * t3 + 1.9018f * t2 + 0.24748f * t1 + 0.237040f);
    float y = -3.0f * x * x + 2.870f * x - 0.275f;
    return make_float2(x, y);
}
__DEVICE__ float2 glx_xy_to_uv(float2 c)
{
    float d = -2.0f * c.x + 12.0f * c.y + 3.0f;
    return make_float2(4.0f * c.x / d, 6.0f * c.y / d);
}
__DEVICE__ float2 glx_uv_to_xy(float2 c)
{
    float d = 2.0f * c.x - 8.0f * c.y + 4.0f;
    return make_float2(3.0f * c.x / d, 2.0f * c.y / d);
}

__DEVICE__ float3 glx_white_balance(float r, float g, float b, float temperature, float tint)
{
    // Target white (chromaticity) relative to D65.
    float m0 = 1.0e6f / 6504.0f;
    float m  = m0 + temperature * GLX_WB_MIRED_PER_UNIT;
    float2 d0 = glx_daylight_xy(1.0e6f / m0);
    float2 d1 = glx_daylight_xy(1.0e6f / m);
    float2 xy = make_float2(0.3127f + (d1.x - d0.x), 0.3290f + (d1.y - d0.y));
    if (tint != 0.0f) {
        // Unit normal to the daylight locus in uv, pointing toward green
        // (+v side); + Tint moves the other way (magenta).
        float2 ua = glx_xy_to_uv(glx_daylight_xy(1.0e6f / (m - 1.0f)));
        float2 ub = glx_xy_to_uv(glx_daylight_xy(1.0e6f / (m + 1.0f)));
        float tu = ub.x - ua.x, tv = ub.y - ua.y;
        float tl = _sqrtf(tu * tu + tv * tv);
        float nu = -tv / tl, nv = tu / tl;
        if (nv < 0.0f) { nu = -nu; nv = -nv; }
        float2 uv = glx_xy_to_uv(xy);
        float k = -tint * GLX_WB_DUV_PER_UNIT;
        xy = glx_uv_to_xy(make_float2(uv.x + k * nu, uv.y + k * nv));
    }
    // Target white XYZ (Y = 1) -> CAT02 LMS; D65 LMS is constant.
    float X = xy.x / xy.y, Z = (1.0f - xy.x - xy.y) / xy.y;
    float gL = ( 0.7328f * X + 0.4296f - 0.1624f * Z) / 0.9492311246f;
    float gM = (-0.7036f * X + 1.6975f + 0.0061f * Z) / 1.0354024620f;
    float gS = ( 0.0030f * X + 0.0136f + 0.9834f * Z) / 1.0874307599f;
    // working (linear Rec.2020) -> LMS, scale, back
    float L = ( 0.5796188689f * r + 0.3926842331f * g - 0.0230719774f * b) * gL;
    float M = (-0.0022300729f * r + 1.0493205165f * g - 0.0116879816f * b) * gM;
    float S = ( 0.0054835970f * r + 0.0372613108f * g + 1.0446858520f * b) * gS;
    return make_float3( 1.7224957773f * L - 0.6456990197f * M + 0.0308173651f * S,
                        0.0035586184f * L + 0.9512852079f * M + 0.0107216043f * S,
                       -0.0091683749f * L - 0.0305406458f * M + 0.9566813861f * S);
}

__DEVICE__ float3 glx_corrections(float3 c, float exposure, float temperature, float tint)
{
    if (exposure != 0.0f) {
        float k = _exp2f(exposure);
        c = make_float3(c.x * k, c.y * k, c.z * k);
    }
    if (temperature != 0.0f || tint != 0.0f) c = glx_white_balance(c.x, c.y, c.z, temperature, tint);
    return c;
}


// =============================================================================
//  CINE16 SECONDARY ENGINE
// -----------------------------------------------------------------------------
//  The sixteen Gradelux Cine16 film colour profiles (Cine16 1B . Film Color
//  Profile v2.2), integrated as an independent engine. The code below is
//  generated from the original DCTL by tools/extract_cine16.py: constants,
//  profile tables (PH / PS / PL / PG), helpers and the transform body are
//  copied verbatim; only identifiers are prefixed (c16_ / C16_) and the
//  original sliders arrive as a C16Controls struct. It works on DaVinci Wide
//  Gamut / DaVinci Intermediate values, exactly like the original, and keeps
//  the original NaN guard and final clamp of each channel to [-0.5, 2.0] DI
//  (about -0.048 .. 1.3 million linear): extended-range values outside that
//  span are limited when a secondary look is active.
//  Note: the Neutral profile is itself a gentle look, not an identity; use
//  Secondary Film Look = Off for no secondary processing.
// =============================================================================
// ---- Cine16 constants, profile tables and helpers (verbatim, renamed) ----
#define C16_DI_A       0.0075f
#define C16_DI_B       7.0f
#define C16_DI_C       0.07329248f
#define C16_DI_M       10.44426855f
#define C16_DI_LINCUT  0.00262409f
#define C16_DI_LOGCUT  0.02740668f
#define C16_GREY_DI    0.33604f
#define C16_YR 0.27412f
#define C16_YG 0.87363f
#define C16_YB (-0.14775f)

__DEVICE__ float c16_di2lin(float x) { return x <= C16_DI_LOGCUT ? x / C16_DI_M : _exp2f(x / C16_DI_C - C16_DI_B) - C16_DI_A; }
__DEVICE__ float c16_lin2di(float x) { return x <= C16_DI_LINCUT ? x * C16_DI_M : (_log2f(x + C16_DI_A) + C16_DI_B) * C16_DI_C; }
__DEVICE__ float c16_luma(float3 c) { return C16_YR * c.x + C16_YG * c.y + C16_YB * c.z; }
__DEVICE__ float c16_sstep(float e0, float e1, float x)
{
    float t = _saturatef((x - e0) / (e1 - e0));
    return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float3 c16_lin3(float3 c) { return make_float3(c16_di2lin(c.x), c16_di2lin(c.y), c16_di2lin(c.z)); }
__DEVICE__ float3 c16_log3(float3 c) { return make_float3(c16_lin2di(c.x), c16_lin2di(c.y), c16_lin2di(c.z)); }
__DEVICE__ float3 c16_satAround(float3 c, float y, float k)
{
    // Pivot clamped inside the pixel's own channel range: very saturated blues in
    // DaVinci Wide Gamut have negative luminance, which would otherwise throw
    // channels far out of range. Channels are never pushed below min(input, 0).
    float mn = _fminf(c.x, _fminf(c.y, c.z)), mx = _fmaxf(c.x, _fmaxf(c.y, c.z));
    y = _clampf(y, mn, mx);
    float3 o = make_float3(y + (c.x - y) * k, y + (c.y - y) * k, y + (c.z - y) * k);
    return make_float3(_fmaxf(o.x, _fminf(c.x, 0.0f)), _fmaxf(o.y, _fminf(c.y, 0.0f)), _fmaxf(o.z, _fminf(c.z, 0.0f)));
}

