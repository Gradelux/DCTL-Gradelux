        // density, not low saturation: greens turn mint and are LIGHTENED by
        // density (pastel, not grey), skies and cyans lighten, skin is
        // pushed toward pink / peach by a soft magenta midtone and a red hue
        // turn it is allowed to receive, shadows lean cool cyan, highlights
        // cream. Global saturation stays at about normal.
        s = glx_set_render(s, 0.15f, 2.2f, 0.30f);
        s = glx_set_tone (s, 1.30f, 3.0f, 4.2f, -0.25f, 0.15f);
        s = glx_set_tints(s, 0.0f, 0.0f, 0.0f,  -0.07f, 0.02f, 0.045f,  0.03f, -0.035f, 0.025f,  0.03f, 0.025f, -0.015f);
        s = glx_set_color(s, 1.05f, 0.40f, 0.15f, 0.06f, 0.25f, 0.15f, 0.0f);
        s = glx_set_fade (s, 0.002f, 1.0f, 1.0f, 1.0f);
