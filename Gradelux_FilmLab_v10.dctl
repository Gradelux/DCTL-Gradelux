        s = glx_set_hden (s, -0.04f, 0.05f, 0.25f, 0.15f, 0.10f, 0.0f);
        s = glx_set_dye  (s, -0.015f, -0.01f, -0.015f, -0.015f, -0.01f, -0.02f, 0.5f);

    // ---- Version 9 additions ---------------------------------------------------
    } else if (id == GLX_LOOK_PATINA) {
        // PATINA: vintage colour negative. A gentle colour crossover (cooler,
        // green-leaning shadows turning warm in the highlights) and a
