// InlineLUT_Test_C.dctl
// TWO inline LUTs, to test whether more than one can coexist in a single DCTL.
// Only run this if InlineLUT_Test.dctl compiles. Both are identities, so a
// successful build must leave the image unchanged.

DEFINE_CUBE_LUT(CC_TEST_LUT_ONE)
{
LUT_3D_SIZE 2
0.000000 0.000000 0.000000
1.000000 0.000000 0.000000
0.000000 1.000000 0.000000
1.000000 1.000000 0.000000
0.000000 0.000000 1.000000
1.000000 0.000000 1.000000
0.000000 1.000000 1.000000
1.000000 1.000000 1.000000
}

DEFINE_CUBE_LUT(CC_TEST_LUT_TWO)
{
LUT_3D_SIZE 2
0.000000 0.000000 0.000000
1.000000 0.000000 0.000000
0.000000 1.000000 0.000000
1.000000 1.000000 0.000000
0.000000 0.000000 1.000000
1.000000 0.000000 1.000000
0.000000 1.000000 1.000000
1.000000 1.000000 1.000000
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float3 a = APPLY_LUT(p_R, p_G, p_B, CC_TEST_LUT_ONE);

    return APPLY_LUT(a.x, a.y, a.z, CC_TEST_LUT_TWO);
}
