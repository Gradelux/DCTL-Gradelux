// =============================================================================
//  GRADELUX FRAMELAB v2
//  Film borders, film strips and film damage for DaVinci Resolve
// =============================================================================
//
//  Presets: pick one for a finished look in one click, or choose
//  Custom to build your own with the sliders below.
//  While a preset is active, it sets the frame, film and damage controls.
//  These sliders always stay yours: Frame Size, Film Roll, Rotation,
//  Picture Zoom / Pan, Film Burn, the date values, the countdown leader and
//  the animation controls.
//
//  Frame styles: Super 8, Regular 8, 16mm, Super 16, 35mm Motion Picture,
//  35mm Still Strip, Contact Sheet, 120 Medium Format, Instant Print,
//  Vintage Print, Slide Mount, Filed Gate, Projector Gate.
//
//  Place FrameLab on the LAST node, after your output conversion to
//  Rec.709 Gamma 2.4. Its colours are designed for Rec.709.
//
//  Animation: a DCTL has no frame counter, so FrameLab gets its per-frame
//  randomness one of two ways (Animation Source):
//    Auto From Footage  - reads a few pixels of each frame and turns them
//                         into a random seed. Real footage changes every
//                         frame, so dust, weave and flicker do too.
//    Time Slider        - keyframe the Time slider (0 on the first frame,
//                         the frame count on the last, linear). Needed for
//                         stills, the countdown leader and drifting leaks.
//
//  This is a spatial effect: it cannot be exported as a 3D LUT.
// =============================================================================

DEFINE_UI_PARAMS(ui_preset, Preset, DCTLUI_COMBO_BOX, 0, { PR_CUSTOM, PR_HOME, PR_SLIDESHOW, PR_NEGSCAN, PR_CINEMA, PR_SILENT, PR_DOC16, PR_INSTANT, PR_CONTACT, PR_DAMAGED, PR_VINTAGE, PR_INDIE16, PR_REEL8 }, { "Custom", "Home Movie", "Slide Show", "Negative Scan", "Cinema Print", "Silent Era Projector", "16mm Documentary", "Instant Memory", "Contact Sheet", "Damaged Reel", "Vintage Print", "Super 16 Indie", "Regular 8 Reel" })
DEFINE_UI_PARAMS(ui_frameStyle, Frame Style, DCTLUI_COMBO_BOX, 1, { FS_NONE, FS_SUPER8, FS_REGULAR8, FS_16MM, FS_SUPER16, FS_35MP, FS_35STILL, FS_CONTACT, FS_120, FS_INSTANT, FS_VINTAGE, FS_SLIDE, FS_FILED, FS_PROJECTOR }, { "None", "Super 8", "Regular 8", "16mm", "Super 16", "35mm Motion Picture", "35mm Still Strip", "Contact Sheet", "120 Medium Format", "Instant Print", "Vintage Print", "Slide Mount", "Filed Gate", "Projector Gate" })
DEFINE_UI_PARAMS(ui_filmBase, Film Base, DCTLUI_COMBO_BOX, 0, { FB_BLACK, FB_ORANGE, FB_CLEAR, FB_BROWN }, { "Black Reversal", "Orange Negative", "Clear", "Aged Brown" })
DEFINE_UI_PARAMS(ui_background, Background, DCTLUI_COMBO_BOX, 0, { BG_BLACK, BG_CHARCOAL, BG_LIGHTTABLE, BG_PAPER }, { "Black", "Charcoal", "Light Table", "White Paper" })
DEFINE_UI_PARAMS(ui_frameSize, Frame Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 1.5, 0.01)
DEFINE_UI_PARAMS(ui_filmRoll, Film Roll, DCTLUI_SLIDER_FLOAT, 0.0, -10.0, 10.0, 0.01)
DEFINE_UI_PARAMS(ui_rotation, Rotation, DCTLUI_SLIDER_FLOAT, 0.0, -20.0, 20.0, 0.1)
DEFINE_UI_PARAMS(ui_picZoom, Picture Zoom, DCTLUI_SLIDER_FLOAT, 1.0, 1.0, 2.0, 0.01)
DEFINE_UI_PARAMS(ui_picPanX, Picture Pan X, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_picPanY, Picture Pan Y, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_cornerRound, Corner Roundness, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(ui_gateSoft, Gate Softness, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_roughness, Edge Roughness, DCTLUI_SLIDER_FLOAT, 0.4, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_edgeMarks, Edge Markings, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(ui_edgeText, Edge Text, DCTLUI_COMBO_BOX, 0, { ET_GRADELUX, ET_SAFETY, ET_NUMBERS }, { "GRADELUX", "SAFETY FILM", "Frame Numbers Only" })
DEFINE_UI_PARAMS(ui_soundtrack, Soundtrack, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(ui_dustAmt, Dust, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_scratchAmt, Scratches, DCTLUI_SLIDER_FLOAT, 0.15, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(ui_gateHair, Hair In The Gate, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(ui_weaveAmt, Gate Weave, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 1.0, 0.01)
