// =============================================================================
//  GRADELUX FRAMELAB v1
//  Film frame overlays and film damage for DaVinci Resolve
// =============================================================================
//
//  Frame styles: Super 8, Regular 8, 16mm, 35mm Motion Picture, 35mm Still
//  Strip, 120 Medium Format, Instant Print, Slide Mount, Filed Gate,
//  Projector Gate.
//
//  Film damage and light: dust and hairs, scratches, gate weave, flicker,
//  vignette, light leaks, an orange date stamp and a countdown leader.
//
//  Place FrameLab on the LAST node of your grade, after your output
//  conversion to Rec.709 Gamma 2.4. Its colours are designed for Rec.709.
//
//  Animation: a DCTL has no frame counter, so FrameLab gets its per-frame
//  randomness one of two ways (Animation Source):
//    Auto From Footage  - reads a few pixels of each frame and turns them into
//                         a random seed. Real footage changes every frame, so
//                         dust, weave and flicker change every frame too.
//    Time Slider        - keyframe the Time slider (e.g. 0 at the first frame,
//                         N at the last frame, linear). Needed for the
//                         countdown leader and for drifting light leaks.
//
//  This is a spatial effect: it cannot be exported as a 3D LUT.
// =============================================================================

DEFINE_UI_PARAMS(frameStyle, Frame Style, DCTLUI_COMBO_BOX, 1, { FS_NONE, FS_SUPER8, FS_REGULAR8, FS_16MM, FS_35MP, FS_35STILL, FS_120, FS_INSTANT, FS_SLIDE, FS_FILED, FS_PROJECTOR }, { "None", "Super 8", "Regular 8", "16mm", "35mm Motion Picture", "35mm Still Strip", "120 Medium Format", "Instant Print", "Slide Mount", "Filed Gate", "Projector Gate" })
DEFINE_UI_PARAMS(filmBase, Film Base, DCTLUI_COMBO_BOX, 0, { FB_BLACK, FB_ORANGE, FB_CLEAR, FB_BROWN }, { "Black Reversal", "Orange Negative", "Clear", "Aged Brown" })
DEFINE_UI_PARAMS(background, Background, DCTLUI_COMBO_BOX, 0, { BG_BLACK, BG_CHARCOAL, BG_LIGHTTABLE, BG_PAPER }, { "Black", "Charcoal", "Light Table", "White Paper" })
DEFINE_UI_PARAMS(frameSize, Frame Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 1.5, 0.01)
DEFINE_UI_PARAMS(filmRoll, Film Roll, DCTLUI_SLIDER_FLOAT, 0.0, -10.0, 10.0, 0.01)
DEFINE_UI_PARAMS(rotation, Rotation, DCTLUI_SLIDER_FLOAT, 0.0, -20.0, 20.0, 0.1)
DEFINE_UI_PARAMS(cornerRound, Corner Roundness, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(gateSoft, Gate Softness, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(roughness, Border Roughness, DCTLUI_SLIDER_FLOAT, 0.5, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(edgeMarks, Edge Markings, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(soundtrack, Soundtrack, DCTLUI_CHECK_BOX, 1)
DEFINE_UI_PARAMS(dustAmt, Dust, DCTLUI_SLIDER_FLOAT, 0.25, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(scratchAmt, Scratches, DCTLUI_SLIDER_FLOAT, 0.15, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(weaveAmt, Gate Weave, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(flickerAmt, Flicker, DCTLUI_SLIDER_FLOAT, 0.2, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(vignetteAmt, Vignette, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(leakAmt, Light Leak, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(leakColor, Leak Color, DCTLUI_COMBO_BOX, 0, { LC_WARM, LC_GOLDEN, LC_RED, LC_PRISM }, { "Warm Orange", "Golden", "Deep Red", "Prism" })
DEFINE_UI_PARAMS(leakPos, Leak Position, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 1.0, 0.01)
DEFINE_UI_PARAMS(leakSize, Leak Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.2, 2.0, 0.01)
DEFINE_UI_PARAMS(dateOn, Date Stamp, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(dateFmt, Date Format, DCTLUI_COMBO_BOX, 0, { DF_YMD, DF_MDY, DF_DMY }, { "'YY M D", "M D 'YY", "D M 'YY" })
DEFINE_UI_PARAMS(dateYear, Year, DCTLUI_SLIDER_INT, 98, 0, 99, 1)
DEFINE_UI_PARAMS(dateMonth, Month, DCTLUI_SLIDER_INT, 7, 1, 12, 1)
DEFINE_UI_PARAMS(dateDay, Day, DCTLUI_SLIDER_INT, 14, 1, 31, 1)
DEFINE_UI_PARAMS(stampSize, Stamp Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 2.0, 0.01)
DEFINE_UI_PARAMS(leaderOn, Countdown Leader, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(leaderFps, Leader Frame Rate, DCTLUI_SLIDER_INT, 24, 12, 60, 1)
DEFINE_UI_PARAMS(animSource, Animation Source, DCTLUI_COMBO_BOX, 0, { AS_AUTO, AS_TIME }, { "Auto From Footage", "Time Slider" })
DEFINE_UI_PARAMS(animTime, Time, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 10000.0, 1.0)
DEFINE_UI_PARAMS(variation, Variation, DCTLUI_SLIDER_INT, 0, 0, 100, 1)

// -----------------------------------------------------------------------------
//  Fixed settings
// -----------------------------------------------------------------------------

// 1: pixel row 0 is the top of the frame (expected in Resolve).
// Set to 0 if text and the date stamp ever appear upside down.
#define GLX_Y_DOWN 1

#define GLX_PI 3.14159265f

// Layout kinds
#define LK_CANVAS     0   // footage fills the frame (None, Filed Gate, Projector Gate)
#define LK_VSTRIP     1   // film runs vertically (8mm, 16mm, 35mm motion picture)
#define LK_HSTRIP     2   // film runs horizontally (35mm still, 120)
#define LK_INSTANT    3
#define LK_SLIDE      4

// Dropdown values as plain numbers, for use inside helper functions.
// They must match the order of the Frame Style / Film Base / Background lists.
#define GLX_FS_SUPER8    1
#define GLX_FS_REGULAR8  2
#define GLX_FS_16MM      3
#define GLX_FS_35MP      4
#define GLX_FS_35STILL   5
#define GLX_FS_120       6
#define GLX_FS_INSTANT   7
#define GLX_FS_SLIDE     8
#define GLX_FB_ORANGE    1
#define GLX_FB_CLEAR     2
#define GLX_FB_BROWN     3
#define GLX_BG_CHARCOAL  1
#define GLX_BG_LIGHTTABLE 2
#define GLX_BG_PAPER     3

// -----------------------------------------------------------------------------
//  Small math helpers (no reliance on floor/fmod intrinsics)
// -----------------------------------------------------------------------------

__DEVICE__ float glx_floor(float x)
{
    x = _fminf(_fmaxf(x, -16777216.0f), 16777216.0f);   // keeps the int cast in range
    float t = (float)((int)x);
    return (t > x) ? t - 1.0f : t;
}
__DEVICE__ float glx_fract(float x) { return x - glx_floor(x); }
__DEVICE__ float glx_clamp(float x, float a, float b) { return _fminf(_fmaxf(x, a), b); }
__DEVICE__ float glx_sat(float x) { return glx_clamp(x, 0.0f, 1.0f); }
__DEVICE__ float glx_mix(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ int   glx_clampi(int x, int a, int b) { return x < a ? a : (x > b ? b : x); }
__DEVICE__ float glx_smooth(float e0, float e1, float x)
{
    float t = glx_sat((x - e0) / (e1 - e0));
    return t * t * (3.0f - 2.0f * t);
}

__DEVICE__ float3 glx_rgb(float r, float g, float b) { return make_float3(r, g, b); }
__DEVICE__ float3 glx_mix3(float3 a, float3 b, float t)
{
    return make_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
}
__DEVICE__ float3 glx_scale3(float3 a, float s) { return make_float3(a.x * s, a.y * s, a.z * s); }
__DEVICE__ float3 glx_add3(float3 a, float3 b) { return make_float3(a.x + b.x, a.y + b.y, a.z + b.z); }

// Screen-style blend that leaves super-whites alone and never goes negative.
__DEVICE__ float glx_screen1(float c, float l) { return c + _fmaxf(1.0f - c, 0.0f) * glx_sat(l); }
__DEVICE__ float3 glx_screen3(float3 c, float3 l)
{
    return make_float3(glx_screen1(c.x, l.x), glx_screen1(c.y, l.y), glx_screen1(c.z, l.z));
}

// -----------------------------------------------------------------------------
//  Hashes and noise (deterministic, per pixel)
// -----------------------------------------------------------------------------

__DEVICE__ float glx_hash1(float p)
{
    p = glx_fract(p * 0.1031f);
    p *= p + 33.33f;
    p *= p + p;
    return glx_fract(p);
}

__DEVICE__ float glx_hash2(float x, float y)
{
    float a = glx_fract(x * 0.1031f);
    float b = glx_fract(y * 0.1030f);
    float c = glx_fract(x * 0.0973f);
    float d = a * (b + 33.33f) + b * (c + 33.33f) + c * (a + 33.33f);
    a += d; b += d; c += d;
    return glx_fract((a + b) * c);
}

__DEVICE__ float glx_noise1(float x)
{
    float i = glx_floor(x);
    float f = x - i;
    f = f * f * (3.0f - 2.0f * f);
    return glx_mix(glx_hash1(i), glx_hash1(i + 1.0f), f);
}

__DEVICE__ float glx_fbm1(float x)
{
    return 0.5f * glx_noise1(x) + 0.3f * glx_noise1(x * 2.13f + 5.1f) + 0.2f * glx_noise1(x * 4.37f + 11.3f);
}

// -----------------------------------------------------------------------------
//  Shapes
// -----------------------------------------------------------------------------

// Signed distance to a rounded box centred at the origin (negative inside).
__DEVICE__ float glx_sdBox(float px, float py, float bx, float by, float r)
{
    r = _fmaxf(_fminf(r, _fminf(bx, by)), 0.0f);
    float qx = _fabs(px) - bx + r;
    float qy = _fabs(py) - by + r;
    float ox = _fmaxf(qx, 0.0f);
    float oy = _fmaxf(qy, 0.0f);
    return _sqrtf(ox * ox + oy * oy) + _fminf(_fmaxf(qx, qy), 0.0f) - r;
}

// Distance to a line segment.
__DEVICE__ float glx_segDist(float px, float py, float ax, float ay, float bx, float by)
{
    float vx = bx - ax, vy = by - ay;
    float wx = px - ax, wy = py - ay;
    float l2 = vx * vx + vy * vy;
    float t = (l2 > 0.0f) ? glx_sat((wx * vx + wy * vy) / l2) : 0.0f;
    float dx = wx - vx * t, dy = wy - vy * t;
    return _sqrtf(dx * dx + dy * dy);
}

// Antialiased coverage from a signed distance and an edge width.
__DEVICE__ float glx_cov(float d, float w) { return glx_sat(0.5f - d / _fmaxf(w, 1e-6f)); }

__DEVICE__ float3 glx_hsv(float h, float s, float v)
{
    float r = glx_sat(_fabs(glx_fract(h) * 6.0f - 3.0f) - 1.0f);
    float g = glx_sat(2.0f - _fabs(glx_fract(h) * 6.0f - 2.0f));
    float b = glx_sat(2.0f - _fabs(glx_fract(h) * 6.0f - 4.0f));
    return make_float3(v * glx_mix(1.0f, r, s), v * glx_mix(1.0f, g, s), v * glx_mix(1.0f, b, s));
}

// -----------------------------------------------------------------------------
//  Footage sampling
// -----------------------------------------------------------------------------

__DEVICE__ float3 glx_fetch(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int x, int y)
{
    return make_float3(_tex2D(tr, x, y), _tex2D(tg, x, y), _tex2D(tb, x, y));
}

// Bilinear sample at a pixel position (pixel centres sit at i + 0.5).
// fy is measured from the top of the frame.
__DEVICE__ float3 glx_sample(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, float fx, float fy, int W, int H)
{
    float sx = glx_clamp(fx - 0.5f, 0.0f, (float)(W - 1));
    float sy = glx_clamp(fy - 0.5f, 0.0f, (float)(H - 1));
    float x0f = glx_floor(sx), y0f = glx_floor(sy);
    float tx = sx - x0f, ty = sy - y0f;
    int x0 = glx_clampi((int)x0f, 0, W - 1), x1 = glx_clampi((int)x0f + 1, 0, W - 1);
    int y0 = glx_clampi((int)y0f, 0, H - 1), y1 = glx_clampi((int)y0f + 1, 0, H - 1);
#if GLX_Y_DOWN == 0
    y0 = H - 1 - y0; y1 = H - 1 - y1;
#endif
    float3 a = glx_fetch(tr, tg, tb, x0, y0);
    float3 b = glx_fetch(tr, tg, tb, x1, y0);
    float3 c = glx_fetch(tr, tg, tb, x0, y1);
    float3 d = glx_fetch(tr, tg, tb, x1, y1);
    return glx_mix3(glx_mix3(a, b, tx), glx_mix3(c, d, tx), ty);
}

// A per-frame random seed made from a handful of footage pixels.
__DEVICE__ float glx_footageSeed(__TEXTURE__ tr, __TEXTURE__ tg, __TEXTURE__ tb, int W, int H)
{
    float acc = 0.0f;
    for (int i = 0; i < 12; i++) {
        float fi = (float)i;
        int x = glx_clampi((int)((0.08f + 0.84f * glx_hash1(fi * 1.7f + 0.3f)) * (float)W), 0, W - 1);
        int y = glx_clampi((int)((0.08f + 0.84f * glx_hash1(fi * 2.9f + 0.7f)) * (float)H), 0, H - 1);
        float v = _tex2D(tg, x, y) + 0.37f * _tex2D(tr, x, y) + 0.21f * _tex2D(tb, x, y);
        acc = glx_fract(acc * 1.618f + glx_fract(v * 917.13f) + fi * 0.0731f);
    }
    return glx_floor(glx_hash1(acc * 1000.0f + 0.5f) * 997.0f);
}

// -----------------------------------------------------------------------------
//  Edge-print font (5 x 7 dot matrix)
//  Codes: 0-9 digits, 10 A, 11 D, 12 E, 13 F, 14 G, 15 I, 16 L, 17 M, 18 R,
//         19 S, 20 T, 21 U, 22 X, 23 Y, 24 arrow, 25 space
// -----------------------------------------------------------------------------

__CONSTANT__ int GLX_FONT[182] = {
    14, 17, 19, 21, 25, 17, 14,   // 0
     4, 12,  4,  4,  4,  4, 14,   // 1
    14, 17,  1,  2,  4,  8, 31,   // 2
    31,  2,  4,  2,  1, 17, 14,   // 3
     2,  6, 10, 18, 31,  2,  2,   // 4
    31, 16, 30,  1,  1, 17, 14,   // 5
     6,  8, 16, 30, 17, 17, 14,   // 6
    31,  1,  2,  4,  8,  8,  8,   // 7
    14, 17, 17, 14, 17, 17, 14,   // 8
    14, 17, 17, 15,  1,  2, 12,   // 9
    14, 17, 17, 31, 17, 17, 17,   // A
    30, 17, 17, 17, 17, 17, 30,   // D
    31, 16, 16, 30, 16, 16, 31,   // E
    31, 16, 16, 30, 16, 16, 16,   // F
    14, 17, 16, 23, 17, 17, 15,   // G
    14,  4,  4,  4,  4,  4, 14,   // I
    16, 16, 16, 16, 16, 16, 31,   // L
    17, 27, 21, 21, 17, 17, 17,   // M
    30, 17, 17, 30, 20, 18, 17,   // R
    15, 16, 16, 14,  1,  1, 30,   // S
    31,  4,  4,  4,  4,  4,  4,   // T
    17, 17, 17, 17, 17, 17, 14,   // U
    17, 17, 10,  4, 10, 17, 17,   // X
    17, 17, 10,  4,  4,  4,  4,   // Y
    16, 24, 28, 30, 28, 24, 16,   // arrow
     0,  0,  0,  0,  0,  0,  0    // space
};

__DEVICE__ int glx_glyphBit(int code, int row, int col)
{
    if (code < 0 || code > 25 || row < 0 || row > 6 || col < 0 || col > 4) return 0;
    return (GLX_FONT[code * 7 + row] >> (4 - col)) & 1;
}

// Strings: 0 = "GRADELUX > NN", 1 = "GRADELUX", 2 = "> NN"
__DEVICE__ int glx_strLen(int s) { return s == 0 ? 13 : (s == 1 ? 8 : 4); }

__DEVICE__ int glx_strChar(int s, int i, int num)
{
    int d1 = (num / 10) % 10;
    int d0 = num % 10;
    if (s == 2) {
        if (i == 0) return 24;
        if (i == 1) return 25;
        return (i == 2) ? d1 : d0;
    }
    if (s == 0 && i >= 8) {
        if (i == 8 || i == 10) return 25;
        if (i == 9) return 24;
        return (i == 11) ? d1 : d0;
    }
    if (i == 0) return 14;   // G
    if (i == 1) return 18;   // R
    if (i == 2) return 10;   // A
    if (i == 3) return 11;   // D
    if (i == 4) return 12;   // E
    if (i == 5) return 16;   // L
    if (i == 6) return 21;   // U
    return 22;               // X
}

// Dot-matrix text centred at along = 0. fromTop is measured from the top of
// the glyphs. h = glyph height. Returns coverage.
__DEVICE__ float glx_text(float along, float fromTop, float h, int s, int num, float pxu)
{
    int len = glx_strLen(s);
    float unit = h / 7.0f;
    float adv = unit * 6.0f;
    float total = (float)len * adv - unit;
    float x = along + total * 0.5f;
    if (x < 0.0f || x >= (float)len * adv || fromTop < 0.0f || fromTop >= h) return 0.0f;
    int idx = (int)(x / adv);
    float xc = x - (float)idx * adv;
    int col = (int)(xc / unit);
    if (col > 4) return 0.0f;
    int row = (int)(fromTop / unit);
    if (glx_glyphBit(glx_strChar(s, idx, num), row, col) == 0) return 0.0f;
    float cx = xc - ((float)col + 0.5f) * unit;
    float cy = fromTop - ((float)row + 0.5f) * unit;
    float d = glx_sdBox(cx, cy, unit * 0.42f, unit * 0.42f, unit * 0.18f);
    return glx_cov(d, pxu);
}

// One large solid glyph (countdown number). x, y from the glyph's top-left.
__DEVICE__ float glx_bigGlyph(float x, float y, float unit, int code, float pxu)
{
    float best = 0.0f;
    int col0 = (int)glx_floor(x / unit);
    int row0 = (int)glx_floor(y / unit);
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            int col = col0 + i, row = row0 + j;
            if (glx_glyphBit(code, row, col) == 0) continue;
            float cx = x - ((float)col + 0.5f) * unit;
            float cy = y - ((float)row + 0.5f) * unit;
            best = _fmaxf(best, glx_cov(glx_sdBox(cx, cy, unit * 0.5f, unit * 0.5f, 0.0f), pxu));
        }
    }
    return best;
}

// -----------------------------------------------------------------------------
//  Seven-segment date stamp
//  Codes: 0-9 digits, 10 blank digit, 11 apostrophe, 12 group space
// -----------------------------------------------------------------------------

__DEVICE__ int glx_segMask(int d)
{
    if (d == 0) return 0x3F;
    if (d == 1) return 0x06;
    if (d == 2) return 0x5B;
    if (d == 3) return 0x4F;
    if (d == 4) return 0x66;
    if (d == 5) return 0x6D;
    if (d == 6) return 0x7D;
    if (d == 7) return 0x07;
    if (d == 8) return 0x7F;
    return 0x6F;
}

// Distance (in digit-height units) to the lit segments of one character.
__DEVICE__ float glx_segChar(float x, float y, int code)
{
    float d = 1000.0f;
    if (code >= 10 && code != 11) return d;
    x -= (1.0f - y) * 0.10f;   // slight italic, like camera date backs
    if (code == 11) return glx_segDist(x, y, 0.06f, 0.0f, 0.02f, 0.2f);
    int m = glx_segMask(code);
    float w = 0.5f, e = 0.08f;
    if (m & 1)  d = _fminf(d, glx_segDist(x, y, e, 0.0f, w - e, 0.0f));
    if (m & 2)  d = _fminf(d, glx_segDist(x, y, w, e, w, 0.5f - e));
    if (m & 4)  d = _fminf(d, glx_segDist(x, y, w, 0.5f + e, w, 1.0f - e));
    if (m & 8)  d = _fminf(d, glx_segDist(x, y, e, 1.0f, w - e, 1.0f));
    if (m & 16) d = _fminf(d, glx_segDist(x, y, 0.0f, 0.5f + e, 0.0f, 1.0f - e));
    if (m & 32) d = _fminf(d, glx_segDist(x, y, 0.0f, e, 0.0f, 0.5f - e));
    if (m & 64) d = _fminf(d, glx_segDist(x, y, e, 0.5f, w - e, 0.5f));
    return d;
}

__DEVICE__ int glx_dateCode(int fmt, int slot, int yy, int mm, int dd)
{
    int y1 = (yy / 10) % 10, y0 = yy % 10;
    int m1 = (mm >= 10) ? 1 : 10, m0 = mm % 10;
    int d1 = (dd >= 10) ? (dd / 10) : 10, d0 = dd % 10;
    if (fmt == 0) {   // 'YY M D
        if (slot == 0) return 11;
        if (slot == 1) return y1;
        if (slot == 2) return y0;
        if (slot == 3) return 12;
        if (slot == 4) return m1;
        if (slot == 5) return m0;
        if (slot == 6) return 12;
        if (slot == 7) return d1;
        return d0;
    }
    int a1 = (fmt == 1) ? m1 : d1, a0 = (fmt == 1) ? m0 : d0;
    int b1 = (fmt == 1) ? d1 : m1, b0 = (fmt == 1) ? d0 : m0;
    if (slot == 0) return a1;
    if (slot == 1) return a0;
    if (slot == 2) return 12;
    if (slot == 3) return b1;
    if (slot == 4) return b0;
    if (slot == 5) return 12;
    if (slot == 6) return 11;
    if (slot == 7) return y1;
    return y0;
}

__DEVICE__ float glx_dateAdv(int code)
{
    if (code == 11) return 0.30f;
    if (code == 12) return 0.36f;
    return 0.74f;
}

// Burns an orange LED date into the image. u, v: window coordinates (centre
// origin), hu, hv: window half sizes, all in frame-height units.
__DEVICE__ float3 glx_dateStamp(float3 col, float u, float v, float hu, float hv, int fmt, int yy, int mm, int dd, float size, float pxu)
{
    float dh = 0.052f * (2.0f * hv) * size;
    float total = 0.0f;
    for (int s = 0; s < 9; s++) total += glx_dateAdv(glx_dateCode(fmt, s, yy, mm, dd));
    total -= 0.24f;
    float right = hu - 1.3f * dh;
    float bottom = hv - 1.1f * dh;
    float lx = (u - (right - total * dh)) / dh;
    float ly = (v - (bottom - dh)) / dh;
    if (lx < -1.0f || lx > total + 1.0f || ly < -1.0f || ly > 2.0f) return col;
    float d = 1000.0f;
    float x0 = 0.0f;
    for (int s = 0; s < 9; s++) {
        int code = glx_dateCode(fmt, s, yy, mm, dd);
        d = _fminf(d, glx_segChar(lx - x0, ly, code));
        x0 += glx_dateAdv(code);
    }
    float core = glx_cov((d - 0.055f) * dh, pxu);
    float glow = _expf(-d / 0.16f) * 0.55f;
    float3 glowCol = glx_rgb(1.0f, 0.36f, 0.06f);
    float3 coreCol = glx_rgb(1.0f, 0.66f, 0.28f);
    col = glx_screen3(col, glx_scale3(glowCol, glow));
    return glx_mix3(col, coreCol, core);
}

// -----------------------------------------------------------------------------
//  Countdown leader (replaces the picture inside the frame)
// -----------------------------------------------------------------------------

__DEVICE__ float3 glx_leader(float u, float v, float hv, int number, float sweep, float pxu)
{
    float s = 2.0f * hv;            // window height
    float x = u / s, y = v / s;     // centred, window-height units
    float px = pxu / s;
    float r = _sqrtf(x * x + y * y);
    float ang = _atan2f(x, -y);     // 0 at 12 o'clock, clockwise
    float a01 = glx_fract(ang / (2.0f * GLX_PI) + 1.0f);
    float shade = (a01 < sweep) ? 0.70f : 0.50f;
    float3 col = glx_rgb(shade, shade * 0.985f, shade * 0.96f);
    float lw = 0.006f;
    float ring = _fminf(_fabs(r - 0.36f), _fabs(r - 0.43f)) - lw;
    float cross = _fminf(_fabs(x), _fabs(y)) - lw * 0.7f;
    float line = _fmaxf(glx_cov(ring, px), glx_cov(cross, px) * (r < 0.47f ? 1.0f : 0.0f));
    col = glx_mix3(col, glx_rgb(0.10f, 0.10f, 0.10f), line * 0.9f);
    // white disc behind the number
    float disc = glx_cov(r - 0.27f, px);
    col = glx_mix3(col, glx_rgb(0.86f, 0.85f, 0.82f), disc);
    float unit = 0.40f / 7.0f;
    float g = glx_bigGlyph(x + 2.5f * unit, y + 3.5f * unit, unit, number, px);
    return glx_mix3(col, glx_rgb(0.06f, 0.06f, 0.06f), g);
}

// -----------------------------------------------------------------------------
//  Dust, hairs and scratches
// -----------------------------------------------------------------------------

// Returns (dark coverage, light coverage).
__DEVICE__ float2 glx_dust(float sx, float sy, float seed, float amt, float pxu)
{
    float dark = 0.0f, light = 0.0f;
    float cell = 0.045f;
    float gx = glx_floor(sx / cell), gy = glx_floor(sy / cell);
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float cx = gx + (float)i, cy = gy + (float)j;
            float r0 = glx_hash2(cx + seed * 0.618f, cy - seed * 0.382f);
            if (r0 > amt * 0.10f) continue;
            float ox = (cx + glx_hash2(cx * 1.3f + seed, cy * 0.7f + 2.1f)) * cell;
            float oy = (cy + glx_hash2(cx * 0.9f - 1.7f, cy * 1.1f + seed)) * cell;
            float h3 = glx_hash2(cx + 5.3f, cy + seed * 1.7f);
            float size = cell * (0.025f + 0.16f * h3 * h3 * h3);
            float dx = sx - ox, dy = sy - oy;
            float ang = _atan2f(dy, dx);
            float wob = 1.0f + 0.12f * _sinf(3.0f * ang + r0 * 40.0f) + 0.08f * _sinf(5.0f * ang + r0 * 71.0f);
            float d = _sqrtf(dx * dx + dy * dy) - size * wob;
            float cv = glx_cov(d, pxu * 1.3f + size * 0.35f) * (0.55f + 0.45f * glx_hash2(cy + 3.3f, cx - seed));
            if (glx_hash2(cx + 11.1f, cy + seed) < 0.72f) dark = _fmaxf(dark, cv);
            else light = _fmaxf(light, cv);
        }
    }
    float hc = 0.16f;
    float hx = glx_floor(sx / hc), hy = glx_floor(sy / hc);
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            float cx = hx + (float)i, cy = hy + (float)j;
            float r0 = glx_hash2(cx - seed * 0.271f, cy + seed * 0.829f + 7.0f);
            if (r0 > amt * 0.07f) continue;
            float ox = (cx + 0.5f) * hc + (glx_hash2(cx, cy + seed) - 0.5f) * hc * 0.5f;
            float oy = (cy + 0.5f) * hc + (glx_hash2(cy, cx - seed) - 0.5f) * hc * 0.5f;
            float th = glx_hash2(cx + seed, cy * 2.0f) * GLX_PI;
            float L = hc * (0.22f + 0.30f * glx_hash2(cx * 3.0f, cy + seed));
            float bend = L * (glx_hash2(cy * 3.0f, cx + seed) - 0.5f) * 0.8f;
            float cs = _cosf(th), sn = _sinf(th);
            float dx = sx - ox, dy = sy - oy;
            float s = dx * cs + dy * sn;
            float t = -dx * sn + dy * cs;
            float sc = glx_clamp(s, -L, L);
            float q = sc / L;
            float off = bend * (1.0f - q * q) + bend * 0.25f * _sinf(q * 7.0f + r0 * 50.0f);
            float d = _sqrtf((s - sc) * (s - sc) + (t - off) * (t - off)) - hc * 0.004f;
            dark = _fmaxf(dark, glx_cov(d, pxu * 1.2f) * 0.85f);
        }
    }
    return make_float2(dark, light);
}

// Scratches run along sy. lo/hi: range of sx they can appear in.
// Returns (bright coverage, dark coverage).
__DEVICE__ float2 glx_scratches(float sx, float sy, float lo, float hi, float seed, float slow, float amt, float pxu)
{
    float bright = 0.0f, dark = 0.0f;
    for (int i = 0; i < 5; i++) {
        float fi = (float)i;
        if (glx_hash1(fi * 12.7f + slow * 0.123f + 0.4f) > amt * 0.75f) continue;
        float x = lo + (hi - lo) * glx_hash1(fi * 3.17f + slow * 0.0137f + 0.5f);
        x += (glx_hash1(seed + fi * 1.9f) - 0.5f) * 0.004f;
        float w = 0.0010f + 0.0022f * glx_hash1(fi * 5.3f + slow * 0.07f);
        float vis = glx_smooth(0.30f, 0.55f, glx_noise1(sy * 1.6f + fi * 9.1f + slow * 0.37f));
        float strength = (0.35f + 0.5f * glx_hash1(seed * 0.7f + fi)) * vis;
        float c = glx_cov(_fabs(sx - x) - w, pxu) * strength;
        if (glx_hash1(fi * 7.7f + slow * 0.01f) < 0.7f) bright = _fmaxf(bright, c);
        else dark = _fmaxf(dark, c);
    }
    return make_float2(bright, dark);
}

// -----------------------------------------------------------------------------
//  Light leaks. nu, nv: window-normalised coordinates (-1..1).
// -----------------------------------------------------------------------------

__DEVICE__ float3 glx_leak(float nu, float nv, int style, float pos, float size, float t)
{
    float th = pos * GLX_PI + (glx_noise1(t * 0.02f) - 0.5f) * 0.6f;
    float ox = -_cosf(th) * 1.05f;
    float oy = -_sinf(th) * 1.05f;
    float dx = nu - ox, dy = nv - oy;
    float d = _sqrtf(dx * dx + dy * dy) / (1.1f * size);
    float I = _expf(-d * d * 1.3f) * (0.75f + 0.5f * glx_noise1(t * 0.035f + 4.0f));
    float3 lo, mid, hi;
    if (style == 1) { lo = glx_rgb(0.70f, 0.33f, 0.05f); mid = glx_rgb(1.0f, 0.70f, 0.22f); hi = glx_rgb(1.0f, 0.95f, 0.75f); }
    else if (style == 2) { lo = glx_rgb(0.50f, 0.02f, 0.05f); mid = glx_rgb(0.92f, 0.12f, 0.08f); hi = glx_rgb(1.0f, 0.55f, 0.38f); }
    else { lo = glx_rgb(0.75f, 0.08f, 0.02f); mid = glx_rgb(1.0f, 0.42f, 0.08f); hi = glx_rgb(1.0f, 0.86f, 0.56f); }
    float3 c = glx_mix3(glx_mix3(lo, mid, glx_smooth(0.0f, 0.5f, I)), hi, glx_smooth(0.5f, 1.0f, I));
    if (style == 3) c = glx_hsv(0.02f + d * 0.35f + th * 0.08f, 0.8f, 1.0f);
    return glx_scale3(c, I);
}

// -----------------------------------------------------------------------------
//  Film gauges (sizes in units of the image frame height)
// -----------------------------------------------------------------------------

typedef struct {
    int kind;
    float fhFrac;              // frame height as a fraction of the output height
    float filmW;               // film width (across)
    float pitch;               // frame-to-frame distance (along)
    float frameA, frameC;      // image window size along / across the film
    float imgC;                // across position of the image centre
    float viewC;               // across position placed at the screen centre
    float radius;              // image corner radius
    int perfN;                 // perforations per frame (0 = none)
    float perfA, perfC, perfR; // perforation size along / across, corner radius
    float perfPhase;           // along position of the first perforation
    float perfC1, perfC2;      // across centre of each perforation row (< 0 = none)
    float textC0, textC1;      // edge-print band (across); c1 <= c0 = none
    float sndC0, sndC1;        // soundtrack band (across); c1 <= c0 = none
} GlxGauge;

__DEVICE__ GlxGauge glx_gauge(int style)
{
    GlxGauge g;
    g.kind = LK_CANVAS; g.fhFrac = 1.0f; g.filmW = 1.0f; g.pitch = 1.0f;
    g.frameA = 1.0f; g.frameC = 1.0f; g.imgC = 0.5f; g.viewC = -1.0f; g.radius = 0.0f;
    g.perfN = 0; g.perfA = 0.1f; g.perfC = 0.1f; g.perfR = 0.0f; g.perfPhase = 0.0f;
    g.perfC1 = -1.0f; g.perfC2 = -1.0f;
    g.textC0 = 0.0f; g.textC1 = 0.0f; g.sndC0 = 0.0f; g.sndC1 = 0.0f;

    if (style == GLX_FS_SUPER8) {
        g.kind = LK_VSTRIP; g.fhFrac = 0.80f; g.filmW = 2.0f; g.pitch = 1.056f;
        g.frameA = 1.0f; g.frameC = 1.444f; g.imgC = 1.122f; g.radius = 0.09f;
        g.perfN = 1; g.perfA = 0.284f; g.perfC = 0.227f; g.perfR = 0.05f; g.perfPhase = 0.0f;
        g.perfC1 = 0.20f;
        g.textC0 = 1.87f; g.textC1 = 1.96f;
    } else if (style == GLX_FS_REGULAR8) {
        g.kind = LK_VSTRIP; g.fhFrac = 0.64f; g.filmW = 2.42f; g.pitch = 1.155f;
        g.frameA = 1.0f; g.frameC = 1.36f; g.imgC = 1.46f; g.viewC = 1.36f; g.radius = 0.07f;
        g.perfN = 1; g.perfA = 0.385f; g.perfC = 0.555f; g.perfR = 0.06f; g.perfPhase = 0.5775f;
        g.perfC1 = 0.3775f;
        g.textC0 = 2.20f; g.textC1 = 2.295f;
    } else if (style == GLX_FS_16MM) {
        g.kind = LK_VSTRIP; g.fhFrac = 0.78f; g.filmW = 2.136f; g.pitch = 1.017f;
        g.frameA = 1.0f; g.frameC = 1.37f; g.imgC = 1.125f; g.radius = 0.05f;
        g.perfN = 1; g.perfA = 0.17f; g.perfC = 0.244f; g.perfR = 0.03f; g.perfPhase = 0.5085f;
        g.perfC1 = 0.222f;
        g.textC0 = 0.02f; g.textC1 = 0.085f;
        g.sndC0 = 1.86f; g.sndC1 = 2.04f;
    } else if (style == GLX_FS_35MP) {
        g.kind = LK_VSTRIP; g.fhFrac = 0.80f; g.filmW = 1.944f; g.pitch = 1.056f;
        g.frameA = 1.0f; g.frameC = 1.31f; g.imgC = 1.045f; g.radius = 0.025f;
        g.perfN = 4; g.perfA = 0.11f; g.perfC = 0.156f; g.perfR = 0.025f; g.perfPhase = 0.132f;
        g.perfC1 = 0.13f; g.perfC2 = 1.814f;
        g.textC0 = 0.008f; g.textC1 = 0.046f;
        g.sndC0 = 0.235f; g.sndC1 = 0.355f;
    } else if (style == GLX_FS_35STILL) {
        g.kind = LK_HSTRIP; g.fhFrac = 0.60f; g.filmW = 1.458f; g.pitch = 1.583f;
        g.frameA = 1.5f; g.frameC = 1.0f; g.imgC = 0.729f; g.radius = 0.02f;
        g.perfN = 8; g.perfA = 0.083f; g.perfC = 0.116f; g.perfR = 0.018f; g.perfPhase = 0.0989f;
        g.perfC1 = 0.142f; g.perfC2 = 1.316f;
        g.textC0 = 1.385f; g.textC1 = 1.445f;
    } else if (style == GLX_FS_120) {
        g.kind = LK_HSTRIP; g.fhFrac = 0.66f; g.filmW = 1.098f; g.pitch = 1.10f;
        g.frameA = 1.0f; g.frameC = 1.0f; g.imgC = 0.549f; g.radius = 0.015f;
        g.textC0 = 1.058f; g.textC1 = 1.090f;
    } else if (style == GLX_FS_INSTANT) {
        g.kind = LK_INSTANT; g.fhFrac = 0.62f;
        g.frameA = 1.026f; g.frameC = 1.0f;
    } else if (style == GLX_FS_SLIDE) {
        g.kind = LK_SLIDE; g.fhFrac = 0.40f;
        g.frameA = 1.48f; g.frameC = 1.0f; g.radius = 0.06f;
    }
    if (g.viewC < 0.0f) g.viewC = g.imgC;
    return g;
}

__DEVICE__ float3 glx_baseColor(int base)
{
    if (base == GLX_FB_ORANGE) return glx_rgb(0.78f, 0.45f, 0.24f);
    if (base == GLX_FB_CLEAR)  return glx_rgb(0.85f, 0.85f, 0.83f);
    if (base == GLX_FB_BROWN)  return glx_rgb(0.22f, 0.14f, 0.085f);
    return glx_rgb(0.030f, 0.027f, 0.025f);
}

__DEVICE__ float3 glx_textColor(int base)
{
    if (base == GLX_FB_ORANGE) return glx_rgb(0.30f, 0.12f, 0.04f);
    if (base == GLX_FB_CLEAR)  return glx_rgb(0.16f, 0.16f, 0.15f);
    if (base == GLX_FB_BROWN)  return glx_rgb(0.80f, 0.62f, 0.38f);
    return glx_rgb(0.90f, 0.80f, 0.52f);
}

// sx, sy: screen position in output-height units, centre origin.
__DEVICE__ float3 glx_background(int bg, float sx, float sy)
{
    if (bg == GLX_BG_CHARCOAL) return glx_rgb(0.055f, 0.055f, 0.058f);
    if (bg == GLX_BG_LIGHTTABLE) {
        float f = 1.0f - 0.10f * (sx * sx + sy * sy);
        return glx_scale3(glx_rgb(0.97f, 0.96f, 0.935f), f);
    }
    if (bg == GLX_BG_PAPER) return glx_rgb(0.90f, 0.89f, 0.86f);
    return glx_rgb(0.0f, 0.0f, 0.0f);
}

// =============================================================================
//  MAIN
// =============================================================================

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    // Nothing enabled: exact pass-through.
    if (frameStyle == FS_NONE && dustAmt <= 0.0f && scratchAmt <= 0.0f && weaveAmt <= 0.0f &&
        flickerAmt <= 0.0f && vignetteAmt <= 0.0f && leakAmt <= 0.0f && dateOn == 0 && leaderOn == 0) {
        return glx_fetch(p_TexR, p_TexG, p_TexB, p_X, p_Y);
    }

    float W = (float)p_Width, H = (float)p_Height;
    float aspect = W / H;

    // ---- Animation ----------------------------------------------------------
    float tSmooth = _fmaxf(animTime, 0.0f);
    float seed, slow;
    if (animSource == AS_TIME) {
        seed = glx_floor(tSmooth) + (float)variation * 101.0f;
        slow = glx_floor(tSmooth / 12.0f) + (float)variation * 31.0f;
    } else {
        seed = glx_footageSeed(p_TexR, p_TexG, p_TexB, p_Width, p_Height) + (float)variation * 101.0f;
        slow = seed;
    }
    seed = seed - glx_floor(seed / 4096.0f) * 4096.0f;
    slow = slow - glx_floor(slow / 4096.0f) * 4096.0f;

    // ---- Gate weave (moves the whole picture) -------------------------------
    float amp = weaveAmt * 0.0045f * H;
    float wx = amp * ((glx_noise1(seed * 0.13f) - 0.5f) + (glx_hash1(seed + 0.31f) - 0.5f) * 1.2f);
    float wy = amp * 0.7f * ((glx_noise1(seed * 0.17f + 3.0f) - 0.5f) + (glx_hash1(seed + 0.77f) - 0.5f) * 1.2f);

    float posX = (float)p_X + 0.5f - wx;
    float posYraw = (float)p_Y + 0.5f;
#if GLX_Y_DOWN == 0
    posYraw = H - posYraw;
#endif
    float posY = posYraw - wy;   // measured from the top

    // Screen position in output-height units (centre origin), for backgrounds.
    float scrX = (posX - 0.5f * W) / H;
    float scrY = (posY - 0.5f * H) / H;

    GlxGauge g = glx_gauge(frameStyle);
    int kind = g.kind;
    float fhPx = (kind == LK_CANVAS) ? H : H * g.fhFrac * frameSize;
    float pxu = 1.0f / fhPx;      // one pixel in layout units
    float X = (posX - 0.5f * W) / fhPx;
    float Y = (posY - 0.5f * H) / fhPx;
    if (kind != LK_CANVAS) {
        float ang = rotation * GLX_PI / 180.0f;
        float cs = _cosf(ang), sn = _sinf(ang);
        float rx = cs * X + sn * Y;
        float ry = -sn * X + cs * Y;
        X = rx; Y = ry;
    }

    float3 bgCol = glx_background(background, scrX, scrY);
    float3 base = glx_baseColor(filmBase);
    float3 backlight = glx_rgb(1.0f, 0.98f, 0.94f);

    float3 col = bgCol;
    float filmCov = 0.0f;          // where film material is (for damage, leaks, flicker)
    float winCov = 0.0f;           // image window coverage
    float u = 0.0f, v = 0.0f;      // window coordinates (centre origin)
    float hu = 0.5f, hv = 0.5f;    // window half sizes
    float sx = X, sy = Y;          // coordinates that dust and scratches follow
    float sLo = -0.5f, sHi = 0.5f; // scratch range across sx
    int frameNum = 12;

    float edgeW = pxu * (1.0f + gateSoft * 6.0f);   // soft image edge

    // ---- Layout -------------------------------------------------------------
    if (kind == LK_CANVAS) {
        hu = 0.5f * aspect; hv = 0.5f;
        u = X; v = Y;
        sx = X; sy = Y; sLo = -hu; sHi = hu;
        filmCov = 1.0f;
        winCov = 1.0f;
        if (frameStyle == FS_FILED) {
            float m = 0.02f + (1.5f - frameSize) * 0.06f;
            float bx = hu - m, by = hv - m;
            float d = glx_sdBox(X, Y, bx, by, 0.03f * cornerRound);
            float qx = _fabs(X) - bx, qy = _fabs(Y) - by;
            float along = (qx > qy) ? (Y * 9.0f + 17.0f + (X > 0.0f ? 40.0f : 0.0f))
                                    : (X * 9.0f + 53.0f + (Y > 0.0f ? 80.0f : 0.0f));
            float rough = roughness * 0.022f * (glx_fbm1(along) - 0.5f) * 2.0f
                        + roughness * 0.006f * (glx_noise1(along * 7.0f) - 0.5f);
            winCov = glx_cov(d + rough, pxu * (1.0f + gateSoft * 3.0f));
            hu = bx; hv = by;
        } else if (frameStyle == FS_PROJECTOR) {
            float bx = (hu - 0.025f) * glx_clamp(frameSize, 0.5f, 1.05f);
            float by = 0.475f * glx_clamp(frameSize, 0.5f, 1.05f);
            float d = glx_sdBox(X, Y, bx, by, 0.10f * cornerRound);
            winCov = glx_cov(d, 0.004f + gateSoft * 0.05f);
            hu = bx; hv = by;
        }
    } else if (kind == LK_VSTRIP || kind == LK_HSTRIP) {
        float a, c;
        if (kind == LK_VSTRIP) { a = Y + filmRoll * g.pitch; c = X + g.viewC; }
        else                   { a = X + filmRoll * g.pitch; c = Y + g.viewC; }
        float k = glx_floor(a / g.pitch + 0.5f);
        float aL = a - k * g.pitch;
        int ki = (int)k;
        frameNum = ((ki + 12) % 100 + 100) % 100;

        filmCov = glx_cov(_fmaxf(-c, c - g.filmW), pxu);
        float3 b = glx_scale3(base, 1.0f + 0.035f * (glx_noise1(a * 2.3f + 3.0f) - 0.5f));
        col = glx_mix3(col, b, filmCov);

        // perforations (backlit)
        if (g.perfN > 0) {
            float step = g.pitch / (float)g.perfN;
            float ap = a - g.perfPhase;
            float dn = ap - glx_floor(ap / step + 0.5f) * step;
            float pc = glx_cov(glx_sdBox(c - g.perfC1, dn, g.perfC * 0.5f, g.perfA * 0.5f, g.perfR), pxu * 1.5f);
            if (g.perfC2 > 0.0f)
                pc = _fmaxf(pc, glx_cov(glx_sdBox(c - g.perfC2, dn, g.perfC * 0.5f, g.perfA * 0.5f, g.perfR), pxu * 1.5f));
            col = glx_mix3(col, backlight, pc * filmCov);
        }

        // optical soundtrack (variable area)
        if (soundtrack != 0 && g.sndC1 > g.sndC0) {
            float sc = 0.5f * (g.sndC0 + g.sndC1);
            float half = 0.5f * (g.sndC1 - g.sndC0);
            float band = glx_cov(_fabs(c - sc) - half, pxu);
            float env = 0.35f + 0.65f * glx_noise1(a * 2.5f + 1.0f);
            float wave = 0.5f * _sinf(a * 41.0f) + 0.3f * _sinf(a * 97.0f + 1.3f) + 0.2f * _sinf(a * 233.0f + 0.4f);
            float open = half * glx_clamp(0.12f + 0.80f * env * _fabs(wave), 0.0f, 0.95f);
            float clear = glx_cov(_fabs(c - sc) - open, pxu);
            col = glx_mix3(col, glx_rgb(0.03f, 0.03f, 0.03f), band * filmCov);
            col = glx_mix3(col, backlight, clear * band * filmCov * 0.92f);
        }

        // edge print
        if (edgeMarks != 0 && g.textC1 > g.textC0) {
            float h = g.textC1 - g.textC0;
            float fromTop = (kind == LK_VSTRIP) ? (g.textC1 - c) : (c - g.textC0);
            float tc = glx_text(aL, fromTop, h, 0, frameNum, pxu);
            col = glx_mix3(col, glx_textColor(filmBase), tc * filmCov * 0.9f);
        }

        // image window
        float wa = g.frameA * 0.5f, wc = g.frameC * 0.5f;
        float dWin = glx_sdBox(c - g.imgC, aL, wc, wa, g.radius * cornerRound);
        if (kind == LK_VSTRIP) { u = c - g.imgC; v = aL; hu = wc; hv = wa; }
        else                   { u = aL; v = c - g.imgC; hu = wa; hv = wc; dWin = glx_sdBox(aL, c - g.imgC, wa, wc, g.radius * cornerRound); }
        winCov = glx_cov(dWin, edgeW) * filmCov;

        sx = c; sy = a; sLo = g.imgC - wc; sHi = g.imgC + wc;
    } else if (kind == LK_INSTANT) {
        float cw = 0.5715f, ch = 0.695f, off = -0.117f;
        float shD = glx_sdBox(X - 0.012f, Y - 0.028f, cw, ch, 0.012f);
        col = glx_scale3(col, 1.0f - 0.45f * (1.0f - glx_smooth(-0.02f, 0.07f, shD)));
        float cardCov = glx_cov(glx_sdBox(X, Y, cw, ch, 0.012f), pxu);
        hu = g.frameA * 0.5f; hv = 0.5f;
        u = X; v = Y - off;
        float dWin = glx_sdBox(u, v, hu, hv, 0.0f);
        float3 card = glx_scale3(glx_rgb(0.945f, 0.935f, 0.905f), 1.0f - 0.035f * (Y / (2.0f * ch) + 0.5f));
        card = glx_scale3(card, 1.0f - 0.14f * _expf(-_fmaxf(dWin, 0.0f) / 0.006f));
        col = glx_mix3(col, card, cardCov);
        winCov = glx_cov(dWin, pxu * 1.2f) * cardCov;
        filmCov = winCov;
        sx = u; sy = v; sLo = -hu; sHi = hu;
    } else {  // LK_SLIDE
        float mh = 1.085f;
        float shD = glx_sdBox(X - 0.015f, Y - 0.03f, mh, mh, 0.09f);
        col = glx_scale3(col, 1.0f - 0.45f * (1.0f - glx_smooth(-0.02f, 0.09f, shD)));
        float mountCov = glx_cov(glx_sdBox(X, Y, mh, mh, 0.09f), pxu);
        hu = g.frameA * 0.5f; hv = 0.5f;
        u = X; v = Y;
        float dWin = glx_sdBox(u, v, hu, hv, g.radius * cornerRound);
        float3 mount = glx_rgb(0.91f, 0.90f, 0.87f);
        float bevel = _expf(-_fmaxf(dWin, 0.0f) / 0.025f);
        mount = glx_scale3(mount, 1.0f - 0.16f * bevel + 0.05f * _expf(-_fmaxf(dWin - 0.05f, 0.0f) / 0.01f) * (1.0f - bevel));
        if (edgeMarks != 0) {
            float th = 0.085f;
            float t1 = glx_text(X, Y - (-0.80f - th * 0.5f), th, 1, 0, pxu);
            float t2 = glx_text(X, Y - (0.80f - th * 0.5f), th, 2, frameNum, pxu);
            mount = glx_mix3(mount, glx_rgb(0.30f, 0.29f, 0.27f), _fmaxf(t1, t2) * 0.9f);
        }
        col = glx_mix3(col, mount, mountCov);
        winCov = glx_cov(dWin, edgeW) * mountCov;
        filmCov = winCov;
        sx = u; sy = v; sLo = -hu; sHi = hu;
    }

    // ---- Picture inside the window ------------------------------------------
    if (winCov > 0.0f) {
        float3 pic;
        if (kind == LK_CANVAS) {
            if (wx == 0.0f && wy == 0.0f) pic = glx_fetch(p_TexR, p_TexG, p_TexB, p_X, p_Y);
            else pic = glx_sample(p_TexR, p_TexG, p_TexB, posX, posY, p_Width, p_Height);
        } else {
            // crop-to-fill the footage into the window
            float winWpx = 2.0f * hu * fhPx, winHpx = 2.0f * hv * fhPx;
            float s = _fmaxf(winWpx / W, winHpx / H);
            float fx = 0.5f * W + u * fhPx / s;
            float fy = 0.5f * H + v * fhPx / s;
            pic = glx_sample(p_TexR, p_TexG, p_TexB, fx, fy, p_Width, p_Height);
        }

        // countdown leader
        if (leaderOn != 0) {
            float fps = (float)leaderFps;
            int number = 8 - (int)(tSmooth / fps);
            if (number >= 2 && number <= 8) {
                float sweep = glx_fract(tSmooth / fps);
                pic = glx_leader(u, v, hv, number, sweep, pxu);
            }
        }

        // projector hot spot
        if (frameStyle == FS_PROJECTOR) {
            float r2 = 0.5f * ((u / hu) * (u / hu) + (v / hv) * (v / hv));
            pic = glx_scale3(pic, 1.05f - 0.16f * r2);
        }

        // vignette
        if (vignetteAmt > 0.0f) {
            float r2 = 0.5f * ((u / hu) * (u / hu) + (v / hv) * (v / hv));
            float vg = 1.0f - vignetteAmt * 0.65f * _powf(glx_sat(r2), 1.4f);
            pic = glx_scale3(pic, vg);
        }

        // date stamp
        if (dateOn != 0)
            pic = glx_dateStamp(pic, u, v, hu, hv, dateFmt, dateYear, dateMonth, dateDay, stampSize, pxu);

        col = glx_mix3(col, pic, winCov);
    }

    // ---- Film damage, light leak and flicker --------------------------------
    if (filmCov > 0.0f) {
        if (dustAmt > 0.0f) {
            float2 dd = glx_dust(sx, sy, seed, dustAmt, pxu);
            col = glx_mix3(col, glx_rgb(0.025f, 0.022f, 0.02f), dd.x * filmCov);
            col = glx_mix3(col, glx_rgb(0.95f, 0.95f, 0.92f), dd.y * filmCov * 0.85f);
        }
        if (scratchAmt > 0.0f) {
            float2 sc = glx_scratches(sx, sy, sLo, sHi, seed, slow, scratchAmt, pxu);
            col = glx_screen3(col, glx_scale3(glx_rgb(0.95f, 0.97f, 1.0f), sc.x * 0.8f * filmCov));
            col = glx_mix3(col, glx_rgb(0.05f, 0.05f, 0.05f), sc.y * 0.6f * filmCov);
        }
        if (leakAmt > 0.0f) {
            float nu = u / _fmaxf(hu, 1e-4f), nv = v / _fmaxf(hv, 1e-4f);
            if (kind == LK_VSTRIP) { nu = X / _fmaxf(hu, 1e-4f); nv = Y / _fmaxf(hv, 1e-4f); }
            if (kind == LK_HSTRIP) { nu = X / _fmaxf(hu, 1e-4f); nv = Y / _fmaxf(hv, 1e-4f); }
            float3 lk = glx_leak(nu, nv, leakColor, leakPos, leakSize, tSmooth);
            col = glx_screen3(col, glx_scale3(lk, leakAmt * filmCov));
        }
        if (flickerAmt > 0.0f) {
            float gain = 1.0f + flickerAmt * 0.10f * (glx_hash1(seed * 1.37f + 0.5f) * 2.0f - 1.0f);
            col = glx_mix3(col, glx_scale3(col, gain), filmCov);
        }
    }

    return col;
}
