// Gradelux Check C: the other building blocks FrameLab uses.
// Constant array, bit operations, loops with continue, a function-like
// macro, an early return and helpers that return float3.
// Draws the digits 0 to 9 in the top left corner.

DEFINE_UI_PARAMS(ui_size, Digit Size, DCTLUI_SLIDER_FLOAT, 0.05, 0.02, 0.2, 0.01)
DEFINE_UI_PARAMS(ui_on, Show Digits, DCTLUI_CHECK_BOX, 1)

#define CHK_FETCH(fx_, fy_) make_float3(_tex2D(p_TexR, (fx_), (fy_)), _tex2D(p_TexG, (fx_), (fy_)), _tex2D(p_TexB, (fx_), (fy_)))

__CONSTANT__ int CHK_FONT[70] = {
    14, 17, 19, 21, 25, 17, 14,
     4, 12,  4,  4,  4,  4, 14,
    14, 17,  1,  2,  4,  8, 31,
    31,  2,  4,  2,  1, 17, 14,
     2,  6, 10, 18, 31,  2,  2,
    31, 16, 30,  1,  1, 17, 14,
     6,  8, 16, 30, 17, 17, 14,
    31,  1,  2,  4,  8,  8,  8,
    14, 17, 17, 14, 17, 17, 14,
    14, 17, 17, 15,  1,  2, 12
};

__DEVICE__ int chk_bit(int code, int row, int col)
{
    if (code < 0 || code > 9 || row < 0 || row > 6 || col < 0 || col > 4) return 0;
    return (CHK_FONT[code * 7 + row] >> (4 - col)) & 1;
}

__DEVICE__ float3 chk_mix(float3 a, float3 b, float t)
{
    return make_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float3 c = CHK_FETCH(p_X, p_Y);
    if (ui_on == 0) return c;
    float unit = ui_size * (float)p_Height / 7.0f;
    float x = (float)p_X / unit - 1.0f;
    float y = (float)p_Y / unit - 1.0f;
    float hit = 0.0f;
    for (int d = 0; d < 10; d++) {
        float lx = x - (float)d * 6.0f;
        if (lx < 0.0f || lx >= 5.0f || y < 0.0f || y >= 7.0f) continue;
        if (chk_bit(d, (int)y, (int)lx) != 0) hit = 1.0f;
    }
    return chk_mix(c, make_float3(0.95f, 0.75f, 0.30f), hit);
}
