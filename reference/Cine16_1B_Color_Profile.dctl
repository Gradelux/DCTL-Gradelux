// =====================================================================
//  GRADELUX CINE16  |  1B . FILM COLOR PROFILE  |  v2.2
//  Sixteen original 16mm-inspired color profiles on one shared engine.
//  Each profile defines, per exposure band (shadows / mids / highlights):
//  hue shift and saturation for red, skin, orange, yellow, green, cyan,
//  blue, magenta; plus hue-dependent density, saturation-by-exposure,
//  subtractive strength, print bias, white- and black-point color,
//  skin rendering and a tone trim.
//  Input and output: DaVinci Wide Gamut / DaVinci Intermediate.
//  Place directly after 1A . FILM TONE. Generated by tools/build.py.
//  Inspired by motion-picture film behavior; not a match of any real stock.
// =====================================================================

DEFINE_UI_PARAMS(p_profile,  Film Profile,        DCTLUI_COMBO_BOX, 0, { PROF_NEUTRAL, PROF_WARM, PROF_COOL, PROF_PASTEL, PROF_RICH, PROF_GOLDEN, PROF_FADED, PROF_REVERSAL, PROF_NIGHT_500T, PROF_DAYLIGHT_250D, PROF_PORTRAIT_400, PROF_CHROME_64, PROF_EMERALD_400, PROF_STEEL_CHROME, PROF_VIVID_50, PROF_CINEMA_E }, { Neutral, Warm, Cool, Pastel, Rich, Golden, Faded, Reversal, Night 500T, Daylight 250D, Portrait 400, Chrome 64, Emerald 400, Steel Chrome, Vivid 50, Cinema E })
DEFINE_UI_PARAMS(p_strength, Profile Strength,    DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 1.5, 0.01)
DEFINE_UI_PARAMS(p_sep,      Color Separation,    DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_sat,      Saturation,          DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_subtr,    Subtractive Density, DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_bias,     Print Bias,          DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(p_tone,     Profile Tone,        DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 1.5, 0.01)
DEFINE_UI_PARAMS(p_skinprot, Skin Protection,     DCTLUI_SLIDER_FLOAT, 1.00, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(p_showskin, Show Skin Mask,      DCTLUI_CHECK_BOX, 0)

DEFINE_UI_TOOLTIP(Film Profile, "Sixteen film color profiles. Each renders color differently in shadows, mids and highlights.")
DEFINE_UI_TOOLTIP(Profile Strength, "Blends the whole profile. 1 = as designed.")
DEFINE_UI_TOOLTIP(Color Separation, "Scales every hue-dependent change: hue shifts, saturation by hue and density by hue. 0 = none, 2 = double.")
DEFINE_UI_TOOLTIP(Saturation, "Overall saturation after the profile's own saturation response.")
DEFINE_UI_TOOLTIP(Subtractive Density, "Scales how much saturated colors darken, like dye density.")
DEFINE_UI_TOOLTIP(Print Bias, "Scales the profile's shadow / mid / highlight color and its white- and black-point color.")
DEFINE_UI_TOOLTIP(Profile Tone, "Scales the profile's contrast and black-level trim (Faded lift, Reversal punch).")
DEFINE_UI_TOOLTIP(Skin Protection, "0 = skin takes the full profile look. 1 = skin is shielded from the profile and rendered on its own skin line.")
DEFINE_UI_TOOLTIP(Show Skin Mask, "Shows the broad skin mask in white. Turn off before rendering.")

#define DI_A       0.0075f
#define DI_B       7.0f
#define DI_C       0.07329248f
#define DI_M       10.44426855f
#define DI_LINCUT  0.00262409f
#define DI_LOGCUT  0.02740668f
#define GREY_DI    0.33604f
#define YR 0.27412f
#define YG 0.87363f
#define YB (-0.14775f)

__DEVICE__ float di2lin(float x) { return x <= DI_LOGCUT ? x / DI_M : _exp2f(x / DI_C - DI_B) - DI_A; }
__DEVICE__ float lin2di(float x) { return x <= DI_LINCUT ? x * DI_M : (_log2f(x + DI_A) + DI_B) * DI_C; }
__DEVICE__ float luma(float3 c) { return YR * c.x + YG * c.y + YB * c.z; }
__DEVICE__ float sstep(float e0, float e1, float x)
{
    float t = _saturatef((x - e0) / (e1 - e0));
    return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float3 lin3(float3 c) { return make_float3(di2lin(c.x), di2lin(c.y), di2lin(c.z)); }
__DEVICE__ float3 log3(float3 c) { return make_float3(lin2di(c.x), lin2di(c.y), lin2di(c.z)); }
__DEVICE__ float3 satAround(float3 c, float y, float k)
{
    // Pivot clamped inside the pixel's own channel range: very saturated blues in
    // DaVinci Wide Gamut have negative luminance, which would otherwise throw
    // channels far out of range. Channels are never pushed below min(input, 0).
    float mn = _fminf(c.x, _fminf(c.y, c.z)), mx = _fmaxf(c.x, _fmaxf(c.y, c.z));
    y = _clampf(y, mn, mx);
    float3 o = make_float3(y + (c.x - y) * k, y + (c.y - y) * k, y + (c.z - y) * k);
    return make_float3(_fmaxf(o.x, _fminf(c.x, 0.0f)), _fmaxf(o.y, _fminf(c.y, 0.0f)), _fmaxf(o.z, _fminf(c.z, 0.0f)));
}

