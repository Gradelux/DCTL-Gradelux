    0.8200f, 0.9800f, 1.0600f, 0.9200f, 0.6800f, 1.2000f, -0.0020f, 0.0000f, 0.0040f, 0.0000f, 0.0000f, 0.0000f, 0.0020f, 0.0020f, -0.0020f, 0.0000f, 0.0000f, 0.0000f, 0.0000f, 0.0000f, 0.0000f, 0.1400f, -0.0040f, 20.0000f, 0.9800f, 0.0030f, 0.9000f, 0.0000f,
    0.8000f, 0.9500f, 1.0500f, 0.9200f, 0.6000f, 1.2000f, -0.0300f, 0.0040f, 0.0200f, 0.0100f, 0.0020f, -0.0100f, 0.0200f, 0.0100f, -0.0300f, 0.0100f, 0.0060f, -0.0140f, -0.0100f, 0.0020f, 0.0100f, 0.0600f, 0.0020f, 24.0000f, 1.0000f, 0.0050f, 0.6000f, 0.0000f,
    0.8000f, 0.9400f, 1.0600f, 0.9500f, 0.6200f, 1.1000f, 0.0040f, 0.0020f, -0.0020f, 0.0100f, 0.0060f, -0.0120f, 0.0100f, 0.0080f, -0.0160f, 0.0080f, 0.0060f, -0.0120f, 0.0020f, 0.0010f, 0.0000f, 0.0800f, 0.0000f, 22.0000f, 1.0000f, 0.0040f, 0.6500f, 0.0000f,
    0.7500f, 0.8800f, 0.9800f, 0.8500f, 0.6000f, 0.5000f, -0.0060f, 0.0020f, 0.0060f, 0.0080f, 0.0050f, -0.0040f, 0.0120f, 0.0080f, -0.0120f, 0.0100f, 0.0080f, -0.0100f, 0.0040f, 0.0040f, 0.0060f, -0.0800f, 0.0080f, 22.0000f, 1.0000f, 0.0060f, 0.5000f, 0.0000f,
    0.8500f, 1.0000f, 1.0800f, 0.9200f, 0.6200f, 1.8000f, 0.0020f, -0.0020f, 0.0040f, 0.0060f, 0.0030f, -0.0060f, 0.0060f, 0.0040f, -0.0100f, 0.0040f, 0.0030f, -0.0060f, 0.0020f, 0.0000f, 0.0040f, 0.1800f, -0.0060f, 21.0000f, 0.9700f, 0.0040f, 0.7000f, 0.0000f,
    0.7800f, 0.9200f, 1.0200f, 0.8800f, 0.5800f, 0.8000f, -0.0120f, 0.0100f, 0.0060f, -0.0040f, 0.0060f, 0.0020f, -0.0040f, 0.0040f, 0.0060f, -0.0020f, 0.0020f, 0.0060f, -0.0060f, 0.0080f, 0.0060f, 0.0200f, 0.0040f, 17.0000f, 0.9800f, 0.0020f, 0.5000f, 0.0000f,
    0.7000f, 0.8500f, 0.9200f, 0.7800f, 0.5000f, 1.0000f, -0.0080f, 0.0060f, 0.0040f, 0.0020f, 0.0020f, 0.0000f, 0.0040f, 0.0040f, 0.0000f, 0.0040f, 0.0040f, 0.0020f, -0.0040f, 0.0040f, 0.0020f, 0.1600f, -0.0040f, 20.0000f, 0.9000f, 0.0040f, 0.7000f, 0.0000f,
    0.8500f, 1.0000f, 1.1000f, 0.9400f, 0.6500f, 1.6000f, 0.0060f, -0.0040f, 0.0080f, 0.0040f, -0.0040f, 0.0040f, 0.0020f, -0.0020f, 0.0020f, 0.0000f, 0.0000f, 0.0000f, 0.0040f, 0.0000f, 0.0060f, 0.1600f, -0.0060f, 20.0000f, 0.9600f, 0.0040f, 0.8500f, 0.0000f,
    0.6500f, 0.8000f, 0.8800f, 0.7800f, 0.5500f, 0.6000f, -0.0120f, 0.0060f, 0.0060f, -0.0020f, 0.0020f, 0.0000f, 0.0020f, 0.0020f, -0.0020f, 0.0020f, 0.0020f, 0.0000f, -0.0040f, 0.0060f, 0.0060f, -0.0800f, 0.0100f, 20.0000f, 0.9200f, 0.0040f, 0.7000f, 0.0000f
};
#define NPROF 16

// hue control points: red 0, skin 20, orange 35, yellow 55, green 100, cyan 190, blue 230, magenta 310
__DEVICE__ float hueInterp(float h, __CONSTANTREF__ float* v)
{
    float H[9] = { 0.0f, 20.0f, 35.0f, 55.0f, 100.0f, 190.0f, 230.0f, 310.0f, 360.0f };
    for (int i = 0; i < 8; i++)
    {
        if (h < H[i + 1])
        {
            float t = (h - H[i]) / (H[i + 1] - H[i]);
            t = t * t * (3.0f - 2.0f * t);
            float a = v[i];
            float b = (i == 7) ? v[0] : v[i + 1];
            return a + (b - a) * t;
        }
    }
    return v[0];
}
__DEVICE__ float hsvHue(float r, float g, float b, float mx, float d)
{
    if (mx == r) return 60.0f * _fmod((g - b) / d + 6.0f, 6.0f);
    if (mx == g) return 60.0f * ((b - r) / d + 2.0f);
    return 60.0f * ((r - g) / d + 4.0f);
}
__DEVICE__ float3 hsv2rgb(float h, float s, float v)
{
    h = _fmod(h + 720.0f, 360.0f) / 60.0f;
    float c = v * s;
    float x = c * (1.0f - _fabs(_fmod(h, 2.0f) - 1.0f));
    float m = v - c;
    float3 o;
    if (h < 1.0f)      o = make_float3(c, x, 0.0f);
    else if (h < 2.0f) o = make_float3(x, c, 0.0f);
    else if (h < 3.0f) o = make_float3(0.0f, c, x);
    else if (h < 4.0f) o = make_float3(0.0f, x, c);
    else if (h < 5.0f) o = make_float3(x, 0.0f, c);
    else               o = make_float3(c, 0.0f, x);
    return make_float3(o.x + m, o.y + m, o.z + m);
}
__DEVICE__ float lvsCurve(float L, float d0, float d1, float d2, float d3, float d4)
{
    if (L < 0.05f)    return d0;
    if (L < 0.20f)    return d0 + (d1 - d0) * sstep(0.05f, 0.20f, L);
    if (L < GREY_DI)  return d1 + (d2 - d1) * sstep(0.20f, GREY_DI, L);
    if (L < 0.52f)    return d2 + (d3 - d2) * sstep(GREY_DI, 0.52f, L);
    if (L < 0.72f)    return d3 + (d4 - d3) * sstep(0.52f, 0.72f, L);
    return d4;
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    int pi = min(max((int)p_profile, 0), NPROF - 1);
    int g = pi * 28;
    float S = p_strength;
    float3 x = make_float3(p_R, p_G, p_B);

    // ---------- broad, soft skin mask (from the incoming image) ----------
    // Wide and soft on purpose: rosy cheeks, shadowed and bright skin all stay
    // inside it, so faces don't flicker in and out of protection as light changes.
    float skinW;
    {
        float r = _fmaxf(x.x, 0.0f), gg = _fmaxf(x.y, 0.0f), b = _fmaxf(x.z, 0.0f);
        float mx = _fmaxf(r, _fmaxf(gg, b)), mn = _fminf(r, _fminf(gg, b)), d = mx - mn;
        float s = d / _fmaxf(mx, 1e-4f);
        float h = d > 1e-6f ? hsvHue(r, gg, b, mx, d) : 0.0f;
        float dh = _fabs(_fmod(h - 20.0f + 540.0f, 360.0f) - 180.0f);
        float L = luma(x);
        skinW = (1.0f - sstep(12.0f, 40.0f, dh)) * sstep(0.02f, 0.06f, s) * (1.0f - sstep(0.40f, 0.60f, s))
              * sstep(0.03f, 0.10f, L) * (1.0f - sstep(0.60f, 0.75f, L));
    }
    if (p_showskin) return make_float3(skinW, skinW, skinW);
    float prot = _saturatef(PG[g + 26] * 1.25f * p_skinprot) * skinW;   // how much this pixel is shielded

    // ---------- profile tone trim ----------
    // Per-channel contrast adds saturation (the profile's punch). On protected skin
    // the same contrast is applied through luminance only, so faces don't redden.
    {
        float ct = PG[g + 21] * p_tone * S;
        float bl = PG[g + 22] * p_tone * S;
        float Lx = luma(x);
        float wl = Lx < GREY_DI ? sstep(0.0f, 0.25f, Lx) : 1.0f;
        float dl = (Lx - GREY_DI) * ct * wl;
        float wr = x.x < GREY_DI ? sstep(0.0f, 0.25f, x.x) : 1.0f;
        float wg = x.y < GREY_DI ? sstep(0.0f, 0.25f, x.y) : 1.0f;
        float wb = x.z < GREY_DI ? sstep(0.0f, 0.25f, x.z) : 1.0f;
        float3 pc = make_float3(x.x + (x.x - GREY_DI) * ct * wr, x.y + (x.y - GREY_DI) * ct * wg, x.z + (x.z - GREY_DI) * ct * wb);
        float3 lc = make_float3(x.x + dl, x.y + dl, x.z + dl);
        x = make_float3(pc.x + (lc.x - pc.x) * prot, pc.y + (lc.y - pc.y) * prot, pc.z + (lc.z - pc.z) * prot);
        x = make_float3(x.x + bl * (1.0f - sstep(0.0f, 0.30f, x.x)),
                        x.y + bl * (1.0f - sstep(0.0f, 0.30f, x.y)),
                        x.z + bl * (1.0f - sstep(0.0f, 0.30f, x.z)));
    }

    // ---------- subtractive density + saturation by exposure (linear) ----------
    // Dye density follows how saturated a color looks (log saturation), not its
    // linear-light ratio, which exaggerates mild colors like skin and cheeks.
    float sLog;
    {
        float mx = _fmaxf(x.x, _fmaxf(x.y, x.z)), mn = _fminf(x.x, _fminf(x.y, x.z));
        sLog = (_fmaxf(mx, 0.0f) - _fmaxf(mn, 0.0f)) / _fmaxf(mx, 1e-4f);
    }
    float3 l = lin3(x);
    {
        float ws = sstep(0.10f, 0.55f, sLog);
        float gd = _exp2f(-PG[g + 5] * p_subtr * S * 0.8f * ws * (1.0f - 0.8f * prot));
        l = make_float3(l.x * gd, l.y * gd, l.z * gd);

        float Y = luma(l);
        float c = lvsCurve(lin2di(Y), PG[g + 0], PG[g + 1], PG[g + 2], PG[g + 3], PG[g + 4]);
        float k = (1.0f + (c - 1.0f) * S * (1.0f - prot)) * p_sat;
        l = satAround(l, Y, k);
    }

    // ---------- exposure-banded hue / saturation / density (log HSV) ----------
    x = log3(l);
    {
        float r = _fmaxf(x.x, 0.0f), gg = _fmaxf(x.y, 0.0f), b = _fmaxf(x.z, 0.0f);
        float mx = _fmaxf(r, _fmaxf(gg, b)), mn = _fminf(r, _fminf(gg, b)), d = mx - mn;
        if (d > 1e-5f)
        {
            float s = d / _fmaxf(mx, 1e-4f);
            float h = hsvHue(r, gg, b, mx, d);
            float L = luma(x);
            float wS = 1.0f - sstep(0.18f, 0.34f, L);
            float wH = sstep(0.40f, 0.58f, L);
            float wM = _fmaxf(1.0f - wS - wH, 0.0f);
            float w  = sstep(0.02f, 0.15f, s);
            float amt = S * w * (1.0f - prot);

            int o = pi * 24;
            float dh = wS * hueInterp(h, PH + o) + wM * hueInterp(h, PH + o + 8) + wH * hueInterp(h, PH + o + 16);
            float sm = wS * hueInterp(h, PS + o) + wM * hueInterp(h, PS + o + 8) + wH * hueInterp(h, PS + o + 16);
            float lm = hueInterp(h, PL + pi * 8);

            float sk = S * prot;
            float toSkin = _fmod(PG[g + 23] - h + 540.0f, 360.0f) - 180.0f;
            float hNew = h + dh * p_sep * amt + toSkin * 0.5f * sk;

            float3 hx = hsv2rgb(hNew, s, mx);
            x = make_float3(x.x + (hx.x - r), x.y + (hx.y - gg), x.z + (hx.z - b));

            float k = _fmaxf(1.0f + (sm - 1.0f) * p_sep * amt, 0.0f) * (1.0f + (PG[g + 24] - 1.0f) * sk);
            x = satAround(x, luma(x), k);

            float lo = lm * p_sep * amt * DI_C;
            float sw = PG[g + 25] * 0.8f * sk;
            x = make_float3(x.x + lo + sw, x.y + lo, x.z + lo - sw);
        }
    }

    // ---------- print bias, white point, black point ----------
    {
        float L = luma(x);
        float wS = (1.0f - sstep(0.20f, 0.40f, L)) * sstep(0.0f, 0.08f, L);
        float wH = sstep(0.45f, 0.65f, L);
        float wM = _fmaxf(1.0f - wS - wH, 0.0f);
        float wW = sstep(0.50f, 0.70f, L);
        float wB = 1.0f - sstep(0.0f, 0.10f, L);
        float k = p_bias * S * (1.0f - prot);
        x.x += k * (wS * PG[g + 6] + wM * PG[g + 9]  + wH * PG[g + 12] + wW * PG[g + 15] + wB * PG[g + 18]);
        x.y += k * (wS * PG[g + 7] + wM * PG[g + 10] + wH * PG[g + 13] + wW * PG[g + 16] + wB * PG[g + 19]);
        x.z += k * (wS * PG[g + 8] + wM * PG[g + 11] + wH * PG[g + 14] + wW * PG[g + 17] + wB * PG[g + 20]);
    }
    // safety: never pass invalid values down the node tree
    if (isnan(x.x) || isnan(x.y) || isnan(x.z) || isinf(x.x) || isinf(x.y) || isinf(x.z))
        return make_float3(p_R, p_G, p_B);
    return make_float3(_clampf(x.x, -0.5f, 2.0f), _clampf(x.y, -0.5f, 2.0f), _clampf(x.z, -0.5f, 2.0f));
}
