#define C16_NPROF 16

// hue control points: red 0, skin 20, orange 35, yellow 55, green 100, cyan 190, blue 230, magenta 310
__DEVICE__ float c16_hueInterp(float h, __CONSTANTREF__ float* v)
{
    float H[9] = { 0.0f, 20.0f, 35.0f, 55.0f, 100.0f, 190.0f, 230.0f, 310.0f, 360.0f };
    for (int i = 0; i < 8; i++)
    {
        if (h < H[i + 1])
        {
            float t = (h - H[i]) / (H[i + 1] - H[i]);
            t = t * t * (3.0f - 2.0f * t);
            float a = v[i];
            float b = (i == 7) ? v[0] : v[i + 1];
            return a + (b - a) * t;
        }
    }
    return v[0];
}
__DEVICE__ float c16_hsvHue(float r, float g, float b, float mx, float d)
{
    if (mx == r) return 60.0f * _fmod((g - b) / d + 6.0f, 6.0f);
    if (mx == g) return 60.0f * ((b - r) / d + 2.0f);
    return 60.0f * ((r - g) / d + 4.0f);
}
__DEVICE__ float3 c16_hsv2rgb(float h, float s, float v)
{
    h = _fmod(h + 720.0f, 360.0f) / 60.0f;
    float c = v * s;
    float x = c * (1.0f - _fabs(_fmod(h, 2.0f) - 1.0f));
    float m = v - c;
    float3 o;
    if (h < 1.0f)      o = make_float3(c, x, 0.0f);
    else if (h < 2.0f) o = make_float3(x, c, 0.0f);
    else if (h < 3.0f) o = make_float3(0.0f, c, x);
    else if (h < 4.0f) o = make_float3(0.0f, x, c);
    else if (h < 5.0f) o = make_float3(x, 0.0f, c);
    else               o = make_float3(c, 0.0f, x);
    return make_float3(o.x + m, o.y + m, o.z + m);
}
__DEVICE__ float c16_lvsCurve(float L, float d0, float d1, float d2, float d3, float d4)
{
    if (L < 0.05f)    return d0;
    if (L < 0.20f)    return d0 + (d1 - d0) * c16_sstep(0.05f, 0.20f, L);
    if (L < C16_GREY_DI)  return d1 + (d2 - d1) * c16_sstep(0.20f, C16_GREY_DI, L);
    if (L < 0.52f)    return d2 + (d3 - d2) * c16_sstep(C16_GREY_DI, 0.52f, L);
    if (L < 0.72f)    return d3 + (d4 - d3) * c16_sstep(0.52f, 0.72f, L);
    return d4;
}

// ---- Cine16 controls (the original sliders, passed in by FilmLab) ----
typedef struct {
    float strength;   // Profile Strength     0 .. 1.5, default 1
    float sep;        // Color Separation     0 .. 2,   default 1
    float sat;        // Saturation           0 .. 2,   default 1
    float subtr;      // Subtractive Density  0 .. 2,   default 1
    float bias;       // Print Bias           0 .. 2,   default 1
    float tone;       // Profile Tone         0 .. 1.5, default 1
    float skinprot;   // Skin Protection      0 .. 1,   default 1
} C16Controls;

// ---- Cine16 engine: the original transform() body (verbatim, renamed) ----
// DaVinci Wide Gamut / DaVinci Intermediate in and out. profile = 0..15
// in the original order (0 = Neutral). Keeps the original NaN guard and
// the original final clamp of every channel to [-0.5, 2.0].
__DEVICE__ float3 c16_apply(float p_R, float p_G, float p_B, int profile, C16Controls c16c, int showMask)
{
    int pi = min(max(profile, 0), C16_NPROF - 1);
    int g = pi * 28;
    float S = c16c.strength;
    float3 x = make_float3(p_R, p_G, p_B);

    // ---------- broad, soft skin mask (from the incoming image) ----------
    // Wide and soft on purpose: rosy cheeks, shadowed and bright skin all stay
    // inside it, so faces don't flicker in and out of protection as light changes.
    float skinW;
    {
        float r = _fmaxf(x.x, 0.0f), gg = _fmaxf(x.y, 0.0f), b = _fmaxf(x.z, 0.0f);
        float mx = _fmaxf(r, _fmaxf(gg, b)), mn = _fminf(r, _fminf(gg, b)), d = mx - mn;
        float s = d / _fmaxf(mx, 1e-4f);
        float h = d > 1e-6f ? c16_hsvHue(r, gg, b, mx, d) : 0.0f;
        float dh = _fabs(_fmod(h - 20.0f + 540.0f, 360.0f) - 180.0f);
        float L = c16_luma(x);
        skinW = (1.0f - c16_sstep(12.0f, 40.0f, dh)) * c16_sstep(0.02f, 0.06f, s) * (1.0f - c16_sstep(0.40f, 0.60f, s))
              * c16_sstep(0.03f, 0.10f, L) * (1.0f - c16_sstep(0.60f, 0.75f, L));
    }
    if (showMask) return make_float3(skinW, skinW, skinW);
    float prot = _saturatef(C16_PG[g + 26] * 1.25f * c16c.skinprot) * skinW;   // how much this pixel is shielded

    // ---------- profile tone trim ----------
    // Per-channel contrast adds saturation (the profile's punch). On protected skin
    // the same contrast is applied through luminance only, so faces don't redden.
    {
        float ct = C16_PG[g + 21] * c16c.tone * S;
        float bl = C16_PG[g + 22] * c16c.tone * S;
        float Lx = c16_luma(x);
        float wl = Lx < C16_GREY_DI ? c16_sstep(0.0f, 0.25f, Lx) : 1.0f;
        float dl = (Lx - C16_GREY_DI) * ct * wl;
        float wr = x.x < C16_GREY_DI ? c16_sstep(0.0f, 0.25f, x.x) : 1.0f;
        float wg = x.y < C16_GREY_DI ? c16_sstep(0.0f, 0.25f, x.y) : 1.0f;
        float wb = x.z < C16_GREY_DI ? c16_sstep(0.0f, 0.25f, x.z) : 1.0f;
        float3 pc = make_float3(x.x + (x.x - C16_GREY_DI) * ct * wr, x.y + (x.y - C16_GREY_DI) * ct * wg, x.z + (x.z - C16_GREY_DI) * ct * wb);
        float3 lc = make_float3(x.x + dl, x.y + dl, x.z + dl);
        x = make_float3(pc.x + (lc.x - pc.x) * prot, pc.y + (lc.y - pc.y) * prot, pc.z + (lc.z - pc.z) * prot);
        x = make_float3(x.x + bl * (1.0f - c16_sstep(0.0f, 0.30f, x.x)),
                        x.y + bl * (1.0f - c16_sstep(0.0f, 0.30f, x.y)),
                        x.z + bl * (1.0f - c16_sstep(0.0f, 0.30f, x.z)));
    }

    // ---------- subtractive density + saturation by exposure (linear) ----------
    // Dye density follows how saturated a color looks (log saturation), not its
    // linear-light ratio, which exaggerates mild colors like skin and cheeks.
    float sLog;
    {
        float mx = _fmaxf(x.x, _fmaxf(x.y, x.z)), mn = _fminf(x.x, _fminf(x.y, x.z));
        sLog = (_fmaxf(mx, 0.0f) - _fmaxf(mn, 0.0f)) / _fmaxf(mx, 1e-4f);
    }
    float3 l = c16_lin3(x);
    {
        float ws = c16_sstep(0.10f, 0.55f, sLog);
        float gd = _exp2f(-C16_PG[g + 5] * c16c.subtr * S * 0.8f * ws * (1.0f - 0.8f * prot));
        l = make_float3(l.x * gd, l.y * gd, l.z * gd);

        float Y = c16_luma(l);
        float c = c16_lvsCurve(c16_lin2di(Y), C16_PG[g + 0], C16_PG[g + 1], C16_PG[g + 2], C16_PG[g + 3], C16_PG[g + 4]);
        float k = (1.0f + (c - 1.0f) * S * (1.0f - prot)) * c16c.sat;
        l = c16_satAround(l, Y, k);
    }

    // ---------- exposure-banded hue / saturation / density (log HSV) ----------
    x = c16_log3(l);
    {
        float r = _fmaxf(x.x, 0.0f), gg = _fmaxf(x.y, 0.0f), b = _fmaxf(x.z, 0.0f);
        float mx = _fmaxf(r, _fmaxf(gg, b)), mn = _fminf(r, _fminf(gg, b)), d = mx - mn;
        if (d > 1e-5f)
        {
            float s = d / _fmaxf(mx, 1e-4f);
            float h = c16_hsvHue(r, gg, b, mx, d);
            float L = c16_luma(x);
            float wS = 1.0f - c16_sstep(0.18f, 0.34f, L);
            float wH = c16_sstep(0.40f, 0.58f, L);
            float wM = _fmaxf(1.0f - wS - wH, 0.0f);
            float w  = c16_sstep(0.02f, 0.15f, s);
            float amt = S * w * (1.0f - prot);

            int o = pi * 24;
            float dh = wS * c16_hueInterp(h, C16_PH + o) + wM * c16_hueInterp(h, C16_PH + o + 8) + wH * c16_hueInterp(h, C16_PH + o + 16);
            float sm = wS * c16_hueInterp(h, C16_PS + o) + wM * c16_hueInterp(h, C16_PS + o + 8) + wH * c16_hueInterp(h, C16_PS + o + 16);
            float lm = c16_hueInterp(h, C16_PL + pi * 8);

            float sk = S * prot;
            float toSkin = _fmod(C16_PG[g + 23] - h + 540.0f, 360.0f) - 180.0f;
            float hNew = h + dh * c16c.sep * amt + toSkin * 0.5f * sk;

            float3 hx = c16_hsv2rgb(hNew, s, mx);
            x = make_float3(x.x + (hx.x - r), x.y + (hx.y - gg), x.z + (hx.z - b));

            float k = _fmaxf(1.0f + (sm - 1.0f) * c16c.sep * amt, 0.0f) * (1.0f + (C16_PG[g + 24] - 1.0f) * sk);
            x = c16_satAround(x, c16_luma(x), k);

            float lo = lm * c16c.sep * amt * C16_DI_C;
            float sw = C16_PG[g + 25] * 0.8f * sk;
            x = make_float3(x.x + lo + sw, x.y + lo, x.z + lo - sw);
        }
    }

    // ---------- print bias, white point, black point ----------
    {
        float L = c16_luma(x);
        float wS = (1.0f - c16_sstep(0.20f, 0.40f, L)) * c16_sstep(0.0f, 0.08f, L);
        float wH = c16_sstep(0.45f, 0.65f, L);
        float wM = _fmaxf(1.0f - wS - wH, 0.0f);
        float wW = c16_sstep(0.50f, 0.70f, L);
        float wB = 1.0f - c16_sstep(0.0f, 0.10f, L);
        float k = c16c.bias * S * (1.0f - prot);
        x.x += k * (wS * C16_PG[g + 6] + wM * C16_PG[g + 9]  + wH * C16_PG[g + 12] + wW * C16_PG[g + 15] + wB * C16_PG[g + 18]);
        x.y += k * (wS * C16_PG[g + 7] + wM * C16_PG[g + 10] + wH * C16_PG[g + 13] + wW * C16_PG[g + 16] + wB * C16_PG[g + 19]);
        x.z += k * (wS * C16_PG[g + 8] + wM * C16_PG[g + 11] + wH * C16_PG[g + 14] + wW * C16_PG[g + 17] + wB * C16_PG[g + 20]);
    }
    // safety: never pass invalid values down the node tree
    if (isnan(x.x) || isnan(x.y) || isnan(x.z) || isinf(x.x) || isinf(x.y) || isinf(x.z))
        return make_float3(p_R, p_G, p_B);
    return make_float3(_clampf(x.x, -0.5f, 2.0f), _clampf(x.y, -0.5f, 2.0f), _clampf(x.z, -0.5f, 2.0f));
}


// =============================================================================
//  ENTRY POINT
// =============================================================================
__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    GlxControls k;
    k.density   = _clampf(ui_Density   * 0.01f, -1.0f, 1.0f);
    k.subSat    = _clampf(ui_SubSat    * 0.01f, -1.0f, 1.0f);
    k.contrast  = _clampf(ui_Contrast  * 0.01f, -1.0f, 1.0f);
    k.shadow    = _clampf(ui_Shadow    * 0.01f, -1.0f, 1.0f);
    k.rolloff   = _clampf(ui_Rolloff   * 0.01f,  0.0f, 1.0f);
    k.intensity = _clampf(ui_Intensity * 0.01f,  0.0f, 1.0f);

    GlxFilmAdj adj;
    adj.cdScale    = 1.0f + _clampf(ui_ColorDensity * 0.01f, -1.0f, 1.0f);   // 0 .. 2
    adj.sepF       = _clampf((ui_Separation - 50.0f) * 0.02f, -1.0f, 1.0f);  // -1 .. 1
    adj.warmth     = _clampf(ui_HlWarmth   * 0.01f, -1.0f, 1.0f);
    adj.shadowTone = _clampf(ui_ShadowTone * 0.01f, -1.0f, 1.0f);

    // Film look. Off, or Creative Intensity 0%, bypasses it exactly.
    float ci     = _clampf(ui_CreativeIntensity * 0.01f, 0.0f, 2.0f);
    int   lookOn = (ui_Look != GLX_LOOK_OFF) && (ci > 0.0f);
    GlxLook look = lookOn ? glx_look_scale(glx_look_get(ui_Look), ci) : glx_look_clean();

    // Film print. None, or Print Strength 0%, bypasses it exactly.
    float ps      = _clampf(ui_PrintStrength * 0.01f, 0.0f, 1.0f);
    int   printOn = (ui_Print != GLX_PRINT_NONE) && (ps > 0.0f);
    GlxLook print = printOn ? glx_print_controls(glx_look_scale(glx_print_get(ui_Print), ps),
                                                 _clampf(ui_PrintContrast   * 0.01f, -1.0f, 1.0f),
                                                 _clampf(ui_PrintDensity    * 0.01f, -1.0f, 1.0f),
                                                 _clampf(ui_PrintSaturation * 0.01f, -1.0f, 1.0f),
                                                 _clampf(ui_PrintRolloff    * 0.01f, -1.0f, 1.0f))
                            : glx_look_clean();

    // ---- Diagnostic View (temporary): the stock alone, by stage ---------------
    if (ui_Diag != GLX_DIAG_NORMAL) {
        if (!lookOn) return make_float3(p_R, p_G, p_B);
        int parts = (ui_Diag == GLX_DIAG_COLOR) ? 1 : (ui_Diag == GLX_DIAG_TONE) ? 2 : 3;
        GlxProfile pd = glx_profile_base();
        float3 dw;
        if (p_R == p_G && p_G == p_B) {
            float v = glx_di_to_lin(p_R);
            dw = make_float3(v, v, v);
        } else {
            dw = glx_dwg_to_work(glx_di_to_lin(p_R), glx_di_to_lin(p_G), glx_di_to_lin(p_B));
        }
        dw = glx_look_apply_parts(dw.x, dw.y, dw.z, look, pd, parts);
        float3 dd = (dw.x == dw.y && dw.y == dw.z) ? dw : glx_work_to_dwg(dw.x, dw.y, dw.z);
        return make_float3(glx_lin_to_di(dd.x), glx_lin_to_di(dd.y), glx_lin_to_di(dd.z));
    }

    int adjColor = (adj.sepF != 0.0f) || (lookOn && adj.cdScale != 1.0f);
    int adjTone  = (adj.warmth != 0.0f) || (adj.shadowTone != 0.0f);

    // Primary corrections (Version 9). Each is bypassed exactly at 0.
    float ev   = _clampf(ui_Exposure, -5.0f, 5.0f);
    float temp = _clampf(ui_Temperature, -100.0f, 100.0f);
    float tint = _clampf(ui_Tint, -100.0f, 100.0f);
    int   preOn = (ev != 0.0f) || (temp != 0.0f) || (tint != 0.0f);

    // Split toning (Version 9). Bypassed exactly when every saturation is 0
    // or Strength is 0.
    int splitOn = (ui_SplitStrength > 0.0f) && ((ui_ShSat > 0.0f) || (ui_MdSat > 0.0f) || (ui_HlSat > 0.0f));
    GlxSplit split = glx_split_make(ui_ShHue, ui_ShSat, ui_MdHue, ui_MdSat, ui_HlHue, ui_HlSat,
                                    ui_SplitBalance, ui_SplitStrength);

    // ---- Secondary Film Look (Cine16) -----------------------------------------
    // Off skips this block entirely: the primary-only path below runs instead.
    if (ui_SecLook != GLX_SEC_OFF) {
        C16Controls sc;
        sc.strength = ui_SecStrength;
        sc.sep      = ui_SecSep;
        sc.sat      = ui_SecSat;
        sc.subtr    = ui_SecSubtr;
        sc.bias     = ui_SecBias;
        sc.tone     = ui_SecTone;
        sc.skinprot = ui_SecSkinProt;
        GlxProfile ps0 = glx_profile_base();

        // 1. Primary corrections and primary film look. Without either, the
        //    input reaches Cine16 unconverted.
        float3 si = make_float3(p_R, p_G, p_B);
        if (lookOn || preOn) {
            float3 lw = glx_di_to_work(p_R, p_G, p_B);
            if (preOn)  lw = glx_corrections(lw, ev, temp, tint);
            if (lookOn) lw = glx_look_apply(lw.x, lw.y, lw.z, look, ps0);
            si = glx_work_to_di(lw);
        }

        // 2. Secondary film look: the original Cine16 engine (DI in, DI out).
        float3 so = c16_apply(si.x, si.y, si.z, ui_SecLook - 1, sc, ui_SecShowSkin ? 1 : 0);
        if (ui_SecShowSkin) return so;

        // 3. Film print, film adjustments and grading controls.
        int post = printOn || adjColor || adjTone
                || (k.density != 0.0f) || (k.subSat != 0.0f) || (k.contrast != 0.0f)
                || (k.shadow  != 0.0f) || (k.rolloff > 0.0f);
        // 4. Split toning.
        if (post || splitOn) {
            float3 pw = glx_di_to_work(so.x, so.y, so.z);
            if (post)    pw = glx_process_post(pw.x, pw.y, pw.z, k, ps0, look, lookOn, print, printOn, adj, adjColor, adjTone);
            if (splitOn) pw = glx_split_tone(pw.x, pw.y, pw.z, split, ps0);
            so = glx_work_to_di(pw);
        }

        // 5. Global Intensity (same rule as below).
        float ts = k.intensity;
        if (ts >= 1.0f) return so;
        if (ts <= 0.0f) return make_float3(p_R, p_G, p_B);
        return make_float3(p_R + (so.x - p_R) * ts,
                           p_G + (so.y - p_G) * ts,
                           p_B + (so.z - p_B) * ts);
    }

    // Exact identity: everything neutral, or 0% Global Intensity.
    int active = lookOn || printOn || adjColor || adjTone || preOn || splitOn
              || (k.density != 0.0f) || (k.subSat != 0.0f) || (k.contrast != 0.0f)
              || (k.shadow  != 0.0f) || (k.rolloff > 0.0f);
    if (!active || k.intensity <= 0.0f)
        return make_float3(p_R, p_G, p_B);

    GlxProfile p = glx_profile_base();

    // DaVinci Intermediate -> linear DWG -> linear working (Rec.2020 primaries).
    // Neutral pixels skip the matrix (it maps neutrals to themselves exactly
    // in maths; this keeps them exactly neutral in floating point too).
    float3 w;
    if (p_R == p_G && p_G == p_B) {
        float v = glx_di_to_lin(p_R);
        w = make_float3(v, v, v);
    } else {
        w = glx_dwg_to_work(glx_di_to_lin(p_R), glx_di_to_lin(p_G), glx_di_to_lin(p_B));
    }

    if (preOn) w = glx_corrections(w, ev, temp, tint);
    w = glx_process_linear(w.x, w.y, w.z, k, p, look, lookOn, print, printOn, adj, adjColor, adjTone);
    if (splitOn) w = glx_split_tone(w.x, w.y, w.z, split, p);

    // linear working -> linear DWG -> DaVinci Intermediate (same neutral path;
    // this keeps monochrome and neutral-locked results exactly R = G = B).
    float3 o = (w.x == w.y && w.y == w.z) ? w : glx_work_to_dwg(w.x, w.y, w.z);
    float oR = glx_lin_to_di(o.x);
    float oG = glx_lin_to_di(o.y);
    float oB = glx_lin_to_di(o.z);

    // Global Intensity: mix in DaVinci Intermediate, where equal steps are
    // roughly equal perceptual steps, so the fade from 0% to 100% is even.
    // At 100% the processed result is returned directly (bit-exact look).
    float t = k.intensity;
    if (t >= 1.0f) return make_float3(oR, oG, oB);
    return make_float3(p_R + (oR - p_R) * t,
                       p_G + (oG - p_G) * t,
                       p_B + (oB - p_B) * t);
}
